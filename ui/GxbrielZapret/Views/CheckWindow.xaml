<Window x:Class="GxbrielZapret.Views.CheckWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:GxbrielZapret.Localization"
        Title="{loc:Loc 'Подбор стратегии'}"
        Width="1120" Height="720" MinWidth="880" MinHeight="560"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="True" Loaded="OnLoaded" StateChanged="OnWindowStateChanged"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <!-- Self-contained expand chevron with smooth rotation -->
        <Style x:Key="MiniChevron" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource FgMutedBrush}"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="b" Background="Transparent" CornerRadius="6">
                            <Path x:Name="p" Data="{StaticResource Icon.ChevronRight}"
                                  Fill="{TemplateBinding Foreground}"
                                  Width="10" Height="10" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <RotateTransform x:Name="rt" Angle="0"/>
                                </Path.RenderTransform>
                            </Path>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="p" Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="90"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource FgBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="10" Background="{StaticResource CardBrush}" CornerRadius="22"
            BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" Effect="{StaticResource CardSoftShadow}"
            ClipToBounds="True" RenderOptions.ClearTypeHint="Enabled">
        <!-- ContentRoot carries the app-wide UI scale (see CheckWindow.OnLoaded) -->
        <Grid x:Name="ContentRoot" Margin="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title bar (draggable) -->
            <Grid Grid.Row="0" MouseLeftButtonDown="OnHeaderDrag">
                <StackPanel Margin="0,0,82,0">
                    <TextBlock Text="{Binding AutoPopupTitle}" Style="{StaticResource H2}"/>
                    <TextBlock Text="{Binding AutoPopupSubtitle}" Style="{StaticResource Muted}"
                               Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button Width="32" Height="32" Style="{StaticResource GhostButton}" Padding="0"
                            Click="OnMinimizeClick" ToolTip="{loc:Loc 'Свернуть проверку'}" Margin="0,0,6,0">
                        <Path Data="{StaticResource Icon.Minimize}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.7" Width="12" Height="12" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Button Width="32" Height="32" Style="{StaticResource GhostButton}" Padding="0" Click="OnCloseClick"
                            ToolTip="{loc:Loc 'Скрыть окно проверки'}">
                        <Path Data="{StaticResource Icon.Close}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.7" Width="12" Height="12" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Progress (running) / completion banner (done) + verdict chips in row 1 -->
            <StackPanel Grid.Row="1" Margin="0,16,0,0">
                <!-- running -->
                <StackPanel Visibility="{Binding IsAutoRunning, Converter={StaticResource BoolToVis}}">
                    <Grid>
                    <TextBlock Text="{Binding AutoStatusText}" Style="{StaticResource Muted}"
                               HorizontalAlignment="Left" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Margin="0,0,96,0"/>
                        <TextBlock Text="{Binding AutoProgressText}" FontWeight="SemiBold" FontSize="13"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Foreground="{StaticResource AccentBrush}"/>
                    </Grid>
                    <ProgressBar Value="{Binding AutoProgress, Mode=OneWay}" IsIndeterminate="{Binding IsAutoProgressIndeterminate}" Minimum="0" Maximum="1" Height="6"
                                 Margin="0,8,0,0" Style="{StaticResource ModernProgressBar}"/>
                    <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="8" Padding="10,8" Margin="0,10,0,0">
                        <TextBlock Text="{Binding AutoProbeDetail}" Foreground="{StaticResource FgBrush}"
                                   FontSize="12" TextWrapping="Wrap" MinHeight="34"/>
                    </Border>
                </StackPanel>
                <!-- done -->
                <Border CornerRadius="8" Padding="12,10" Background="{StaticResource SurfaceAltBrush}"
                        BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                        Visibility="{Binding IsAutoRunning, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                    <TextBlock Text="{Binding AutoStatusText}" Style="{StaticResource Muted}"
                               TextWrapping="Wrap" VerticalAlignment="Center"/>
                </Border>
                <!-- VERDICT: big per-service РАБОТАЕТ/ЧАСТИЧНО/НЕ РАБОТАЕТ chips for the applied strategy -->
                <ItemsControl ItemsSource="{Binding Verdicts}" Margin="0,10,0,0"
                              Visibility="{Binding IsAutoRunning, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="8" Padding="13,10" Margin="0,0,8,0"
                                    Background="{StaticResource BgBrush}" BorderThickness="1"
                                    BorderBrush="{Binding Status, Converter={StaticResource DiagBrush}}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Service}" FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock Text="{Binding StatusText}" FontWeight="Bold" FontSize="13"
                                                   Margin="8,0,0,0"
                                                   Foreground="{Binding Status, Converter={StaticResource DiagBrush}}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" FontSize="11"
                                               TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Main split: targets (left) | passed strategies (right) -->
            <Grid Grid.Row="2" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.08*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT: live target check for the current candidate -->
                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="{loc:Loc 'ПРОВЕРКА ЦЕЛЕЙ'}" Style="{StaticResource Muted}" FontSize="11" FontWeight="SemiBold"/>
                        <TextBlock Grid.Row="1" Text="{Binding CurrentCandidateName}" FontWeight="SemiBold"
                                   FontSize="13.5" Margin="0,4,0,8" TextTrimming="CharacterEllipsis"
                                   Foreground="{StaticResource AccentBrush}"/>

                        <Border Grid.Row="2" Padding="12,0,12,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="68"/>
                                    <ColumnDefinition Width="68"/>
                                    <ColumnDefinition Width="68"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{loc:Loc 'Цель'}" Style="{StaticResource Muted}" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="1" Text="{loc:Loc 'Сайт'}" Style="{StaticResource Muted}" FontSize="11" FontWeight="SemiBold" TextAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="TLS 1.2" Style="{StaticResource Muted}" FontSize="11" FontWeight="SemiBold" TextAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="TLS 1.3" Style="{StaticResource Muted}" FontSize="11" FontWeight="SemiBold" TextAlignment="Center"/>
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding CheckTargets}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="8" Background="{StaticResource BgBrush}"
                                                Padding="12,8" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="68"/>
                                                    <ColumnDefinition Width="68"/>
                                                    <ColumnDefinition Width="68"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Host}" VerticalAlignment="Center"
                                                           FontFamily="{StaticResource MonoFont}" FontSize="12"
                                                           TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                                                <!-- HTTP/2 (Page load) -->
                                                <Border Grid.Column="1" CornerRadius="6" Padding="4,3" Margin="2,0"
                                                        Background="{Binding Http, Converter={StaticResource DiagSoftBrush}}"
                                                        ToolTip="{loc:Loc 'Реальная загрузка страницы (HTTP/2, как в браузере)'}">
                                                    <TextBlock Text="{Binding Http, Converter={StaticResource DiagText}}"
                                                               Foreground="{Binding Http, Converter={StaticResource DiagBrush}}"
                                                               FontWeight="SemiBold" FontSize="10.5"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <!-- TLS 1.2 -->
                                                <Border Grid.Column="2" CornerRadius="6" Padding="4,3" Margin="2,0"
                                                        Background="{Binding Tls12, Converter={StaticResource DiagSoftBrush}}"
                                                        ToolTip="TLS 1.2 Handshake">
                                                    <TextBlock Text="{Binding Tls12, Converter={StaticResource DiagText}}"
                                                               Foreground="{Binding Tls12, Converter={StaticResource DiagBrush}}"
                                                               FontWeight="SemiBold" FontSize="10.5"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <!-- TLS 1.3 -->
                                                <Border Grid.Column="3" CornerRadius="6" Padding="4,3" Margin="2,0"
                                                        Background="{Binding Tls13, Converter={StaticResource DiagSoftBrush}}"
                                                        ToolTip="TLS 1.3 Handshake">
                                                    <TextBlock Text="{Binding Tls13, Converter={StaticResource DiagText}}"
                                                               Foreground="{Binding Tls13, Converter={StaticResource DiagBrush}}"
                                                               FontWeight="SemiBold" FontSize="10.5"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- RIGHT: strategies that passed — save / apply straight from here -->
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock Text="{loc:Loc 'ПРОШЛИ ПРОВЕРКУ'}" Style="{StaticResource Muted}" FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:Loc 'Это существующие стратегии из фиксированного каталога. Выберите одну или запустите сразу.'}"
                                       Style="{StaticResource Muted}" FontSize="11" Margin="0,2,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding PassedStrategies}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="8" Background="{StaticResource BgBrush}"
                                                BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                                                Margin="0,0,0,7" Opacity="0">
                                            <Border.Triggers>
                                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                From="0" To="1" Duration="0:0:0.25"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </Border.Triggers>
                                            <StackPanel Margin="12,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Width="22" Height="22" CornerRadius="6" VerticalAlignment="Center"
                                                            Background="{StaticResource AccentSoftBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1">
                                                        <Path Data="{StaticResource Icon.Check}" Fill="{StaticResource AccentBrush}" Width="11" Height="11"
                                                              Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12"
                                                                   TextWrapping="Wrap"/>
                                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                    <ToggleButton x:Name="exp" Grid.Column="2" Style="{StaticResource MiniChevron}"
                                                                  VerticalAlignment="Top" ToolTip="{loc:Loc 'Показать детали по целям'}"/>
                                                </Grid>

                                                <!-- per-endpoint detail (expand) -->
                                                <ItemsControl ItemsSource="{Binding HostList}" Margin="0,8,0,0"
                                                              Visibility="{Binding IsChecked, ElementName=exp, Converter={StaticResource BoolToVis}}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,2">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="56"/>
                                                                    <ColumnDefinition Width="56"/>
                                                                    <ColumnDefinition Width="56"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="{Binding Host}"
                                                                           FontFamily="{StaticResource MonoFont}"
                                                                           Style="{StaticResource Muted}" FontSize="11"
                                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Grid.Column="1" FontSize="11" FontWeight="SemiBold"
                                                                           Text="{Binding Https, Converter={StaticResource DiagText}}"
                                                                           Foreground="{Binding Https, Converter={StaticResource DiagBrush}}"
                                                                           TextAlignment="Center" VerticalAlignment="Center"
                                                                           ToolTip="{loc:Loc 'Проверка HTTPS-адреса. Видео и голос не проверены.'}"/>
                                                                <TextBlock Grid.Column="2" FontSize="11" FontWeight="SemiBold"
                                                                           Text="{Binding Tls12, Converter={StaticResource DiagText}}"
                                                                           Foreground="{Binding Tls12, Converter={StaticResource DiagBrush}}"
                                                                           TextAlignment="Center" VerticalAlignment="Center"
                                                                           ToolTip="TLS 1.2"/>
                                                                <TextBlock Grid.Column="3" FontSize="11" FontWeight="SemiBold"
                                                                           Text="{Binding Tls13, Converter={StaticResource DiagText}}"
                                                                           Foreground="{Binding Tls13, Converter={StaticResource DiagBrush}}"
                                                                           TextAlignment="Center" VerticalAlignment="Center"
                                                                           ToolTip="TLS 1.3"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <!-- actions -->
                                                <Grid Margin="0,10,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="8"/>
                                                        <ColumnDefinition Width="34"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Button Grid.Column="0" Content="{loc:Loc 'Выбрать'}"
                                                            ToolTip="{loc:Loc 'Выбрать эту рабочую стратегию'}"
                                                            Style="{StaticResource GhostButton}" Padding="10,6" FontSize="12"
                                                            HorizontalAlignment="Stretch"
                                                            Command="{Binding DataContext.ApplyScoreCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"/>
                                                    <Button Grid.Column="2" Width="34" Height="30" Padding="0"
                                                            Background="{StaticResource SuccessBrush}"
                                                            BorderThickness="0" Cursor="Hand"
                                                            ToolTip="{loc:Loc 'Выбрать и сразу запустить обход с этой стратегией'}"
                                                            Command="{Binding DataContext.ApplyScoreAndStartCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="btnB" Background="{TemplateBinding Background}" CornerRadius="8">
                                                                    <Path Data="{StaticResource Icon.Play}" Fill="White" Width="11" Height="11"
                                                                          Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="btnB" Property="Opacity" Value="0.9"/>
                                                                    </Trigger>
                                                                    <Trigger Property="IsPressed" Value="True">
                                                                        <Setter TargetName="btnB" Property="Opacity" Value="0.75"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock Grid.Row="2" FontSize="11.5" Margin="0,8,0,0" TextWrapping="Wrap"
                                   Text="{loc:Loc 'Пока ни одна стратегия не прошла проверку.'}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PassedStrategies.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>
            </Grid>

            <!-- Footer -->
            <Grid Grid.Row="3" Margin="0,16,0,0">
                <!-- running: stop -->
                <Button Content="{loc:Loc 'Остановить'}" Command="{Binding StopAutoSelectCommand}"
                        Style="{StaticResource GhostButton}" HorizontalAlignment="Left"
                        Visibility="{Binding IsAutoRunning, Converter={StaticResource BoolToVis}}"/>
                <!-- done: close -->
                <Button Content="{loc:Loc 'Закрыть'}" Click="OnCloseClick" Padding="20,8"
                        Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"
                        Visibility="{Binding IsAutoRunning, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"/>
                <TextBlock Text="{Binding AutoProgressText}" Style="{StaticResource Muted}"
                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Grid>
    </Border>
</Window>

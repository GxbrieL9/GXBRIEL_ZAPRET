<Window x:Class="GxbrielZapret.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:GxbrielZapret.Localization"
        Title="{loc:Loc 'Подтверждение'}"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">

    <Border Margin="10" Background="{StaticResource CardBrush}" CornerRadius="20"
            BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" Effect="{StaticResource CardSoftShadow}" MaxWidth="430"
            RenderOptions.ClearTypeHint="Enabled">
        <StackPanel Margin="24" MouseLeftButtonDown="OnDrag">
            <TextBlock x:Name="TitleText" Style="{StaticResource H2}"/>
            <TextBlock x:Name="MessageText" Style="{StaticResource Muted}" Margin="0,10,0,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button x:Name="CancelButton" Content="{loc:Loc 'Отмена'}" Style="{StaticResource GhostButton}"
                        Margin="0,0,10,0" Click="OnCancel" IsCancel="True"/>
                <Button x:Name="ConfirmButton" Content="{loc:Loc 'Удалить'}" Style="{StaticResource DangerButton}"
                        Click="OnConfirm" IsDefault="True"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>

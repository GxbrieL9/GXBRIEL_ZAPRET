                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Bottom actions -->
                        <Grid Grid.Row="3" Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Command="{Binding OpenAddCustomAppCommand}"
                                    Style="{StaticResource PrimaryButton}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource Icon.Plus}" Fill="White" Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="{loc:Loc '+ Добавить цель'}" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <TextBlock Grid.Column="1" Text="{loc:Loc 'Захват выполняется локально. Найденные процессы, домены и IP не отправляются на сервер.'}"
                                       Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="14,0" VerticalAlignment="Center"/>
                            <Button Grid.Column="2" Content="{loc:Loc 'Готово'}" Command="{Binding CloseDiscoveryCatalogCommand}"
                                    Style="{StaticResource GhostButton}"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- ============ Modal: Add Target Chooser ============ -->
            <Grid Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="115" Background="#C8000000"
                  Visibility="{Binding ShowAddTargetChooser, Converter={StaticResource BoolToVis}}">
                <Border Style="{StaticResource ModalCard}" MaxWidth="480" MaxHeight="420"
                        VerticalAlignment="Center" HorizontalAlignment="Center"
                        BorderBrush="{StaticResource AccentBrush}" BorderThickness="1">
                    <Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="{loc:Loc 'Что вы хотите отслеживать?'}" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                            <Button Command="{Binding CloseAddTargetChooserCommand}"
                                    Style="{StaticResource GhostButton}" HorizontalAlignment="Right"
                                    VerticalAlignment="Top" Padding="8,6" MinWidth="0">
                                <Path Data="{StaticResource Icon.Close}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" Width="12" Height="12" Stretch="Uniform"/>
                            </Button>
                        </Grid>

                        <TextBlock Text="{loc:Loc 'Выберите способ добавления приложения, игры или веб-сервиса:'}"
                                   Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,16"/>

                        <!-- Choice 1: Running Process -->
                        <Button Command="{Binding ChooseRunningProcessCommand}" Style="{StaticResource GhostButton}"
                                Margin="0,0,0,8" Padding="14,10" HorizontalContentAlignment="Stretch">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="34" Height="34" CornerRadius="8" Background="{StaticResource AccentSoftBrush}" Margin="0,0,12,0">
                                    <Path Data="{StaticResource Icon.Cpu}" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.6" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:Loc 'Запущенный процесс'}" FontWeight="SemiBold" FontSize="13"/>
                                    <TextBlock Text="{loc:Loc 'Выбрать игру или программу из списка работающих сейчас'}" Style="{StaticResource Muted}" FontSize="11"/>
                                </StackPanel>
                                <Path Grid.Column="2" Data="{StaticResource Icon.ChevronRight}" Fill="{StaticResource FgMutedBrush}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <!-- Choice 2: Select EXE File -->
                        <Button Command="{Binding ChooseExeFileCommand}" Style="{StaticResource GhostButton}"
                                Margin="0,0,0,8" Padding="14,10" HorizontalContentAlignment="Stretch">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="34" Height="34" CornerRadius="8" Background="{StaticResource AccentSoftBrush}" Margin="0,0,12,0">
                                    <Path Data="{StaticResource Icon.Folder}" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.6" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:Loc 'EXE-файл'}" FontWeight="SemiBold" FontSize="13"/>
                                    <TextBlock Text="{loc:Loc 'Указать файл приложения через проводник (*.exe)'}" Style="{StaticResource Muted}" FontSize="11"/>
                                </StackPanel>
                                <Path Grid.Column="2" Data="{StaticResource Icon.ChevronRight}" Fill="{StaticResource FgMutedBrush}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <!-- Choice 3: Web site / domain -->
                        <Button Command="{Binding ChooseWebDomainCommand}" Style="{StaticResource GhostButton}"
                                Margin="0,0,0,16" Padding="14,10" HorizontalContentAlignment="Stretch">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="34" Height="34" CornerRadius="8" Background="{StaticResource SuccessSoftBrush}" Margin="0,0,12,0">
                                    <Path Data="{StaticResource Icon.Activity}" Stroke="{StaticResource SuccessBrush}" StrokeThickness="1.6" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:Loc 'Веб-сайт / домен'}" FontWeight="SemiBold" FontSize="13"/>
                                    <TextBlock Text="{loc:Loc 'Отслеживание веб-сервиса (SoundCloud и др.) по сетевой активности'}" Style="{StaticResource Muted}" FontSize="11"/>
                                </StackPanel>
                                <Path Grid.Column="2" Data="{StaticResource Icon.ChevronRight}" Fill="{StaticResource FgMutedBrush}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <Button Content="{loc:Loc 'Отмена'}" Command="{Binding CloseAddTargetChooserCommand}"
                                Style="{StaticResource GhostButton}" HorizontalAlignment="Right"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ============ Modal: Add Web Domain Target ============ -->
            <Grid Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="117" Background="#C8000000"
                  Visibility="{Binding ShowAddDomainTargetModal, Converter={StaticResource BoolToVis}}">
                <Border Style="{StaticResource ModalCard}" MaxWidth="480" MaxHeight="420"
                        VerticalAlignment="Center" HorizontalAlignment="Center"
                        BorderBrush="{StaticResource AccentBrush}" BorderThickness="1">
                    <Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="28" Height="28" CornerRadius="6" Background="{StaticResource SuccessSoftBrush}" Margin="0,0,10,0">
                                    <Path Data="{StaticResource Icon.Activity}" Stroke="{StaticResource SuccessBrush}" StrokeThickness="1.6" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{loc:Loc 'Добавить сайт / веб-сервис'}" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button Command="{Binding CloseAddDomainTargetCommand}"
                                    Style="{StaticResource GhostButton}" HorizontalAlignment="Right"
                                    VerticalAlignment="Top" Padding="8,6" MinWidth="0">
                                <Path Data="{StaticResource Icon.Close}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" Width="12" Height="12" Stretch="Uniform"/>
                            </Button>
                        </Grid>

                        <TextBlock Text="{loc:Loc 'Введите адрес сайта или сервиса (например, https://soundcloud.com/):'}"
                                   Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10"/>

                        <!-- URL input box -->
                        <Border Background="{StaticResource BgBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                                CornerRadius="8" Padding="10,8" Margin="0,0,0,8">
                            <TextBox Text="{Binding NewDomainInputText, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent" BorderThickness="0" Padding="0"
                                     Foreground="{StaticResource FgBrush}" FontSize="13" FontFamily="{StaticResource MonoFont}"/>
                        </Border>

                        <!-- Parsed Preview -->
                        <Border Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                                CornerRadius="6" Padding="10,6" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc 'Тип: Веб-сервис (отслеживание по доменам)'}" FontSize="11" Style="{StaticResource Muted}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                    <TextBlock Text="{loc:Loc 'Основной seed-домен: '}" FontSize="11.5" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding ParsedDomainPreview}" FontSize="11.5" Foreground="{StaticResource SuccessBrush}" FontFamily="{StaticResource MonoFont}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Display Name input (optional) -->
                        <TextBlock Text="{loc:Loc 'Название (необязательно):'}" Style="{StaticResource Muted}" FontSize="11.5" Margin="0,0,0,4"/>
                        <Border Background="{StaticResource BgBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                                CornerRadius="8" Padding="10,6" Margin="0,0,0,16">
                            <TextBox Text="{Binding NewDomainDisplayName, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent" BorderThickness="0" Padding="0"
                                     Foreground="{StaticResource FgBrush}" FontSize="12.5"/>
                        </Border>

                        <!-- Actions -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="{loc:Loc 'Добавить сайт'}" Command="{Binding ConfirmAddDomainTargetCommand}"
                                    Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
                            <Button Content="{loc:Loc 'Отмена'}" Command="{Binding CloseAddDomainTargetCommand}"
                                    Style="{StaticResource GhostButton}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ============ Modal: Website Learning Session ============ -->
            <Grid Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="122" Background="#C8000000"
                  Visibility="{Binding ShowWebsiteLearningModal, Converter={StaticResource BoolToVis}}">
                <Border Style="{StaticResource ModalCard}" MaxWidth="540" MaxHeight="560"
                        VerticalAlignment="Center" HorizontalAlignment="Center"
                        BorderBrush="{StaticResource AccentBrush}" BorderThickness="1">
                    <Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
                    <StackPanel>
                        <!-- Header -->
                        <Grid Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="28" Height="28" CornerRadius="6" Background="{StaticResource AccentSoftBrush}" Margin="0,0,10,0">
                                    <Path Data="{StaticResource Icon.Activity}" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.6" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{Binding LearningTarget.DisplayName, StringFormat='Обучение {0}'}" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button Command="{Binding CloseWebsiteLearningModalCommand}"
                                    Style="{StaticResource GhostButton}" HorizontalAlignment="Right"
                                    VerticalAlignment="Top" Padding="8,6" MinWidth="0">
                                <Path Data="{StaticResource Icon.Close}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" Width="12" Height="12" Stretch="Uniform"/>
                            </Button>
                        </Grid>

                        <!-- Instructions -->
                        <Border Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                                CornerRadius="8" Padding="12,10" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc 'Инструкция по обучению:'}" FontWeight="Bold" FontSize="12" Margin="0,0,0,6"/>
                                <TextBlock Text="{loc:Loc '1. Нажмите «Начать обучение» ниже.'}" Style="{StaticResource Muted}" FontSize="11.5" Margin="0,0,0,3"/>
                                <TextBlock Text="{loc:Loc '2. Откройте сервис в браузере.'}" Style="{StaticResource Muted}" FontSize="11.5" Margin="0,0,0,3"/>
                                <TextBlock Text="{loc:Loc '3. Используйте сайт как обычно: войдите в аккаунт, откройте трек/страницу, запустите воспроизведение.'}" Style="{StaticResource Muted}" FontSize="11.5" Margin="0,0,0,3"/>
                                <TextBlock Text="{loc:Loc '4. Вернитесь в GX и нажмите «Завершить».'}" Style="{StaticResource Muted}" FontSize="11.5"/>
                            </StackPanel>
                        </Border>

                        <!-- Live Metrics -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,6,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding LearningElapsedSeconds, StringFormat='{}{0} сек'}" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center" Foreground="{StaticResource AccentBrush}"/>
                                    <TextBlock Text="{loc:Loc 'Время'}" Style="{StaticResource Muted}" FontSize="10.5" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,6,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding LearningDomainsCount}" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center" Foreground="{StaticResource SuccessBrush}"/>
                                    <TextBlock Text="{loc:Loc 'Доменов'}" Style="{StaticResource Muted}" FontSize="10.5" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="8" Padding="10,8">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding LearningIpsCount}" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center" Foreground="{StaticResource HighlightBrush}"/>
                                    <TextBlock Text="{loc:Loc 'IP-адресов'}" Style="{StaticResource Muted}" FontSize="10.5" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Live Status description -->
                        <TextBlock Text="{Binding LearningStatusText}" Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,16" TextWrapping="Wrap"/>

                        <!-- Actions -->
                        <Grid>
                            <Button Content="{loc:Loc 'Начать обучение'}" Command="{Binding StartWebsiteLearningCommand}"
                                    Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"
                                    Visibility="{Binding IsLearningSessionActive, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"/>
                            <Button Content="{loc:Loc 'Завершить обучение'}" Command="{Binding StopWebsiteLearningCommand}"
                                    Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"
                                    Visibility="{Binding IsLearningSessionActive, Converter={StaticResource BoolToVis}}"/>
                            <Button Content="{loc:Loc 'Отмена'}" Command="{Binding CloseWebsiteLearningModalCommand}"
                                    Style="{StaticResource GhostButton}" HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ============ Modal: Learning Results & Candidate Review ============ -->
            <Grid Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="124" Background="#C8000000"
                  Visibility="{Binding ShowLearningResultsModal, Converter={StaticResource BoolToVis}}">
                <Border Style="{StaticResource ModalCard}" MaxWidth="620" MaxHeight="680"
                        VerticalAlignment="Center" HorizontalAlignment="Center"
                        BorderBrush="{StaticResource AccentBrush}" BorderThickness="1">
                    <Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="28" Height="28" CornerRadius="6" Background="{StaticResource SuccessSoftBrush}" Margin="0,0,10,0">
                                    <Path Data="{StaticResource Icon.Activity}" Stroke="{StaticResource SuccessBrush}" StrokeThickness="1.6" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding LearningResultTarget.DisplayName, StringFormat='{}{0} — обучение завершено'}" Style="{StaticResource H2}"/>
                                    <TextBlock Text="{loc:Loc 'Проверьте обнаруженные домены и эндпоинты перед сохранением'}" Style="{StaticResource Muted}" FontSize="11"/>
                                </StackPanel>
                            </StackPanel>
                            <Button Command="{Binding CloseLearningResultsModalCommand}"
                                    Style="{StaticResource GhostButton}" HorizontalAlignment="Right"
                                    VerticalAlignment="Top" Padding="8,6" MinWidth="0">
                                <Path Data="{StaticResource Icon.Close}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" Width="12" Height="12" Stretch="Uniform"/>
                            </Button>
                        </Grid>

                        <!-- Summary text -->
                        <TextBlock Grid.Row="1" Text="{Binding LearningResultSummary}" Style="{StaticResource Muted}" FontSize="11.5" Margin="0,0,0,10" TextWrapping="Wrap"/>

                        <!-- Candidate list with scoring sections -->
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                            <StackPanel>
                                <!-- RECOMMENDED (High) -->
                                <Border Background="{StaticResource SuccessSoftBrush}" BorderBrush="{StaticResource SuccessBrush}" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,0,6">
                                    <TextBlock Text="{loc:Loc 'РЕКОМЕНДУЕТСЯ (Высокая вероятность)'}" FontWeight="Bold" FontSize="11" Foreground="{StaticResource SuccessBrush}"/>
                                </Border>
                                <ItemsControl ItemsSource="{Binding LearningRecommendedCandidates}" Margin="0,0,0,12">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                                                    CornerRadius="6" Padding="8,5" Margin="0,0,0,4">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Value}" FontWeight="SemiBold" FontSize="12" FontFamily="{StaticResource MonoFont}"/>
                                                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Muted}" FontSize="10.5"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="2" Background="{StaticResource SuccessSoftBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding ConfidenceLabel}" Foreground="{StaticResource SuccessBrush}" FontSize="10" FontWeight="SemiBold"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- POSSIBLE (Medium) -->
                                <Border Background="#1AE9B44C" BorderBrush="{StaticResource WarnBrush}" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,0,6"
                                        Visibility="{Binding LearningPossibleCandidates.Count, Converter={StaticResource IntGreaterThanZeroToVis}}">
                                    <TextBlock Text="{loc:Loc 'ВОЗМОЖНО (Средняя вероятность / CDN)'}" FontWeight="Bold" FontSize="11" Foreground="{StaticResource WarnBrush}"/>
                                </Border>
                                <ItemsControl ItemsSource="{Binding LearningPossibleCandidates}" Margin="0,0,0,12">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                                                    CornerRadius="6" Padding="8,5" Margin="0,0,0,4">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Value}" FontWeight="SemiBold" FontSize="12" FontFamily="{StaticResource MonoFont}"/>
                                                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Muted}" FontSize="10.5"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="2" Background="#1AE9B44C" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding ConfidenceLabel}" Foreground="{StaticResource WarnBrush}" FontSize="10" FontWeight="SemiBold"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- EXCLUDED (Low) -->
                                <Border Background="#18FFFFFF" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,0,6"
                                        Visibility="{Binding LearningExcludedCandidates.Count, Converter={StaticResource IntGreaterThanZeroToVis}}">
                                    <TextBlock Text="{loc:Loc 'ИСКЛЮЧЕНО (Низкая корреляция / Шум)'}" FontWeight="Bold" FontSize="11" Style="{StaticResource Muted}"/>
                                </Border>
                                <ItemsControl ItemsSource="{Binding LearningExcludedCandidates}" Margin="0,0,0,6">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                                                    CornerRadius="6" Padding="8,5" Margin="0,0,0,4" Opacity="0.6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Value}" FontSize="11.5" FontFamily="{StaticResource MonoFont}"/>
                                                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Muted}" FontSize="10"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="{Binding ConfidenceLabel}" Style="{StaticResource Muted}" FontSize="10" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Bottom actions -->
                        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                            <Button Content="{loc:Loc 'Добавить рекомендуемые'}" Command="{Binding ApplyLearningRecommendedCommand}"
                                    Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
                            <Button Content="{loc:Loc 'Добавить все выбранные'}" Command="{Binding ApplyAllLearningCandidatesCommand}"
                                    Style="{StaticResource GhostButton}" Margin="0,0,8,0"/>
                            <Button Content="{loc:Loc 'Отмена'}" Command="{Binding CloseLearningResultsModalCommand}"
                                    Style="{StaticResource GhostButton}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ============ Modal: Select Running Process ============ -->
            <Grid Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="118" Background="#C8000000"
                  Visibility="{Binding ShowProcessPicker, Converter={StaticResource BoolToVis}}">
                <Border Style="{StaticResource ModalCard}" MaxWidth="580" MaxHeight="660"
                        VerticalAlignment="Center" HorizontalAlignment="Center"
                        BorderBrush="{StaticResource AccentBrush}" BorderThickness="1">
                    <Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="28" Height="28" CornerRadius="6" Background="{StaticResource AccentSoftBrush}" Margin="0,0,10,0">
                                    <Path Data="{StaticResource Icon.Cpu}" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.6" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{loc:Loc 'Выбрать запущенный процесс'}" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button Command="{Binding CloseProcessPickerCommand}"
                                    Style="{StaticResource GhostButton}" HorizontalAlignment="Right"
                                    VerticalAlignment="Top" Padding="8,6" MinWidth="0">
                                <Path Data="{StaticResource Icon.Close}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" Width="12" Height="12" Stretch="Uniform"/>
                            </Button>
                        </Grid>

                        <!-- Search and System toggle -->
                        <Grid Grid.Row="1" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{StaticResource BgBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                                    CornerRadius="8" Padding="10,6" Margin="0,0,8,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" Data="{StaticResource Icon.Search}" Fill="{StaticResource FgMutedBrush}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Grid.Column="1" Text="{Binding ProcessSearchText, UpdateSourceTrigger=PropertyChanged}"
                                             Background="Transparent" BorderThickness="0" Padding="0"
                                             Foreground="{StaticResource FgBrush}" FontSize="12.5"/>
                                </Grid>
                            </Border>
                            <CheckBox Grid.Column="1" Content="{loc:Loc 'Показать системные'}"
                                      IsChecked="{Binding ShowSystemProcesses}" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Processes list -->
                        <Border Grid.Row="2" Background="{StaticResource BgBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                                CornerRadius="8" Padding="4">
                            <ListBox ItemsSource="{Binding ActiveProcesses}" SelectedItem="{Binding SelectedProcessItem}"
                                     Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling"
                                     ScrollViewer.CanContentScroll="True">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="8,6" CornerRadius="6" Background="Transparent">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Muted}" FontSize="11" FontFamily="{StaticResource MonoFont}"/>
                                                </StackPanel>
                                                <Border Grid.Column="1" Background="{StaticResource SurfaceAltBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ProcessName}" FontSize="10.5" Style="{StaticResource Muted}"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>

                        <!-- Bottom actions -->
                        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                            <Button Content="{loc:Loc 'Добавить выбранный'}" Command="{Binding ConfirmAddProcessTargetCommand}"
                                    Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
                            <Button Content="{loc:Loc 'Отмена'}" Command="{Binding CloseProcessPickerCommand}"
                                    Style="{StaticResource GhostButton}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ============ Modal: Target Candidates ============ -->
            <Grid Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="120" Background="#C8000000"
                  Visibility="{Binding ShowTargetCandidates, Converter={StaticResource BoolToVis}}">
                <Border Style="{StaticResource ModalCard}" MaxWidth="600" MaxHeight="660"
                        VerticalAlignment="Center" HorizontalAlignment="Center"
                        BorderBrush="{StaticResource AccentBrush}" BorderThickness="1">
                    <Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="28" Height="28" CornerRadius="6" Background="{StaticResource AccentSoftBrush}" Margin="0,0,10,0">
                                    <Path Data="{StaticResource Icon.Activity}" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.6" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SelectedTargetForCandidates.DisplayName, FallbackValue='Кандидаты'}" Style="{StaticResource H2}"/>
                                    <TextBlock Text="{loc:Loc 'Обнаруженные адреса и домены во время захвата'}" Style="{StaticResource Muted}" FontSize="11"/>
                                </StackPanel>
                            </StackPanel>
                            <Button Command="{Binding CloseTargetCandidatesCommand}"
                                    Style="{StaticResource GhostButton}" HorizontalAlignment="Right"
                                    VerticalAlignment="Top" Padding="8,6" MinWidth="0">
                                <Path Data="{StaticResource Icon.Close}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" Width="12" Height="12" Stretch="Uniform"/>
                            </Button>
                        </Grid>

                        <!-- Select all / deselect all quick bar -->
                        <Grid Grid.Row="1" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="{loc:Loc 'Выбрать все'}" Command="{Binding SelectAllCandidatesCommand}" Style="{StaticResource GhostButton}" Padding="8,3" FontSize="11" Margin="0,0,6,0"/>
                                <Button Content="{loc:Loc 'Снять выбор'}" Command="{Binding DeselectAllCandidatesCommand}" Style="{StaticResource GhostButton}" Padding="8,3" FontSize="11"/>
                            </StackPanel>
                            <Button Content="{loc:Loc 'Очистить историю'}" Command="{Binding ClearTargetCandidatesCommand}"
                                    Style="{StaticResource GhostButton}" Foreground="{StaticResource DangerBrush}" HorizontalAlignment="Right" Padding="8,3" FontSize="11"/>
                        </Grid>

                        <!-- Candidates List -->
                        <Border Grid.Row="2" Background="{StaticResource BgBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                                CornerRadius="8" Padding="4">
                            <ListBox ItemsSource="{Binding TargetCandidatesView}"
                                     Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling"
                                     ScrollViewer.CanContentScroll="True">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="6,4" CornerRadius="6" Background="Transparent">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <Border Grid.Column="1" Background="{StaticResource SurfaceAltBrush}" CornerRadius="4" Padding="5,2" Margin="0,0,8,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding TypeBadge}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                                </Border>
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Value}" FontWeight="SemiBold" FontSize="12.5" FontFamily="{StaticResource MonoFont}"/>
                                                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Muted}" FontSize="10.5"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="3" Text="{Binding LastSeen, StringFormat='HH:mm:ss'}" Style="{StaticResource Muted}" FontSize="10.5" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>

                        <!-- Bottom actions -->
                        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                            <Button Content="{loc:Loc 'Добавить в Hostlist / Ipset'}" Command="{Binding ExportTargetCandidatesCommand}"
                                    Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
                            <Button Content="{loc:Loc 'Закрыть'}" Command="{Binding CloseTargetCandidatesCommand}"
                                    Style="{StaticResource GhostButton}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>

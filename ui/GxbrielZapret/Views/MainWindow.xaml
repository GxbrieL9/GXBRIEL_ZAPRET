                                            </Border>
                                            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                                                <StackPanel>
                                                    <TextBlock Text="{loc:Loc 'Portable-статус'}" Style="{StaticResource H2}" Margin="0,0,0,8"/>
                                                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Text="{Binding PortableStatus}"/>
                                                    <ItemsControl ItemsSource="{Binding ProductHealthNotes}" Margin="0,10,0,0">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding}" Style="{StaticResource Muted}" TextWrapping="Wrap" FontSize="11.5" Margin="0,0,0,5"/>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                        <Button Content="{loc:Loc 'Повторить проверку'}" Command="{Binding RunProductHealthCommand}" Style="{StaticResource GhostButton}" Margin="0,0,8,0" ToolTip="{loc:Loc 'Запустить проверку целостности приложения и зависимостей'}"/>
                                                        <Button Content="{loc:Loc 'Скопировать health-report'}" Command="{Binding CopyHealthReportCommand}" Style="{StaticResource GhostButton}" ToolTip="{loc:Loc 'Скопировать полный диагностический отчёт в буфер обмена'}"/>
                                                    </StackPanel>
                                                    <WrapPanel Margin="0,8,0,0">
                                                        <Button Content="{loc:Loc 'Данные'}" Command="{Binding OpenDataFolderCommand}" Style="{StaticResource GhostButton}" Margin="0,0,8,8"/>
                                                        <Button Content="{loc:Loc 'Runtime'}" Command="{Binding OpenEngineFolderCommand}" Style="{StaticResource GhostButton}" Margin="0,0,8,8"/>
                                                        <Button Content="{loc:Loc 'Логи'}" Command="{Binding OpenLogsFolderCommand}" Style="{StaticResource GhostButton}" Margin="0,0,8,8"/>
                                                    </WrapPanel>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </controls:ResponsiveColumnsPanel>
                                </ScrollViewer>
                            </TabItem>
                            <TabItem Style="{StaticResource SubTabItem}">
                                <TabItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <!-- Foreground is bound to the tab, not inherited: the implicit
                                             TextBlock style sets it explicitly, and a local setter beats an
                                             inherited value — the label would stay bright in every state. -->
                                        <TextBlock Text="{loc:Loc 'Обслуживание'}"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/>
                                        <TextBlock Text="5" Margin="7,0,0,0" FontFamily="{StaticResource MonoFont}"
                                                   FontSize="10.5" Opacity="0.5"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/>
                                    </StackPanel>
                                </TabItem.Header>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                                    <controls:ResponsiveColumnsPanel MinColumnWidth="340" Gap="16">
                                        <StackPanel Grid.Column="0">
                                            <Border Style="{StaticResource Card}">
                                                <StackPanel>
                                                    <TextBlock Text="{loc:Loc 'Живой захват трафика'}" Style="{StaticResource H2}" Margin="0,0,0,4"/>
                                                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10"
                                                               Text="{loc:Loc 'GX отслеживает выбранные приложения и собирает используемые ими домены и IP во время работы.'}"/>

                                                    <Border Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                                                            CornerRadius="8" Padding="12" Margin="0,0,0,12">
                                                        <StackPanel>
                                                            <Grid Margin="0,0,0,8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="{Binding DiscoverySelectedSummary}" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center"/>
                                                                <TextBlock Grid.Column="1" Text="{loc:Loc 'Захват выполняется локально'}" FontSize="11" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                                                            </Grid>

                                                            <!-- List of active applications preview -->
                                                            <ItemsControl ItemsSource="{Binding ActiveDiscoveryTargetsPreview}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Grid Margin="0,3">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                                                <Ellipse Width="6" Height="6" Fill="{StaticResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                                                <TextBlock Text="{Binding DisplayName}" FontSize="12" VerticalAlignment="Center"/>
                                                                            </StackPanel>
                                                                            <Border Grid.Column="1" Background="{StaticResource AccentSoftBrush}" CornerRadius="4" Padding="6,2">
                                                                                <TextBlock Text="{loc:Loc 'Включено'}" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="SemiBold"/>
                                                                            </Border>
                                                                        </Grid>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>

                                                            <TextBlock Text="{Binding MoreActiveTargetsText}"
                                                                       Visibility="{Binding HasMoreActiveTargets, Converter={StaticResource BoolToVis}}"
                                                                       Style="{StaticResource Muted}" FontSize="11" Margin="14,4,0,0"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Action buttons -->
                                                    <WrapPanel Margin="0,0,0,8">
                                                        <Button Command="{Binding OpenDiscoveryCatalogCommand}"
                                                                Style="{StaticResource GhostButton}" Margin="0,0,8,6">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Path Data="{StaticResource Icon.Settings}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                                <TextBlock Text="{loc:Loc 'Настроить приложения'}" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Button>
                                                        <Button Command="{Binding OpenAddCustomAppCommand}"
                                                                Style="{StaticResource GhostButton}" Margin="0,0,8,6">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Path Data="{StaticResource Icon.Plus}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                                <TextBlock Text="{loc:Loc '+ Добавить своё приложение'}" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Button>
                                                        <Button Command="{Binding UpdateAllListsCommand}"
                                                                Style="{StaticResource PrimaryButton}" Margin="0,0,8,6"
                                                                IsEnabled="{Binding IsBuildingIpset, Converter={StaticResource InverseBool}}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Path Data="{StaticResource Icon.Refresh}" Fill="White" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                                                <TextBlock Text="{loc:Loc 'Запустить захват'}" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Button>
                                                        <Button Command="{Binding StopListUpdateCommand}"
                                                                Style="{StaticResource GhostButton}" Margin="0,0,8,6"
                                                                Visibility="{Binding IsBuildingIpset, Converter={StaticResource BoolToVis}}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Path Data="{StaticResource Icon.Close}" Stroke="{StaticResource DangerBrush}" StrokeThickness="1.7" Width="10" Height="10" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                                                <TextBlock Text="{Binding StopListsButtonText}" Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Button>
                                                    </WrapPanel>

                                                    <!-- Progress & Status -->
                                                    <Grid Margin="0,0,0,8" Visibility="{Binding IsBuildingIpset, Converter={StaticResource BoolToVis}}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <ProgressBar Grid.Column="0" Value="{Binding IpsetProgressValue, Mode=OneWay}" Minimum="0" Maximum="100"
                                                                     Height="6" Style="{StaticResource ModernProgressBar}" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding IpsetProgressValue, StringFormat='{}{0:0}%'}"
                                                                   FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="Bold"
                                                                   Foreground="{StaticResource AccentBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                    </Grid>

                                                    <TextBlock Text="{Binding IpsetStatus}" Style="{StaticResource Muted}" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                                                <StackPanel>
                                                    <TextBlock Text="{loc:Loc 'Резервная копия'}" Style="{StaticResource H2}" Margin="0,0,0,8"/>
                                                    <TextBlock Text="{Binding BackupStatus}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button Content="{loc:Loc 'Сохранить в файл'}" Command="{Binding ExportBackupCommand}"
                                                                Style="{StaticResource GhostButton}" Margin="0,0,8,0"/>
                                                        <Button Content="{loc:Loc 'Восстановить из файла'}" Command="{Binding ImportBackupCommand}"
                                                                Style="{StaticResource GhostButton}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <Border Style="{StaticResource Card}">
                                                <StackPanel>
                                                    <TextBlock Text="{loc:Loc 'Исключения (антивирус и брандмауэр)'}" Style="{StaticResource H2}" Margin="0,0,0,8"/>
                                                    <TextBlock Text="{Binding ExclusionsStatus}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button Content="{loc:Loc 'Добавить в исключения'}" Command="{Binding ApplyExclusionsCommand}"
                                                                Style="{StaticResource GhostButton}"
                                                                Visibility="{Binding IsApplyingExclusions, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"/>
                                                        <TextBlock Text="{loc:Loc 'Добавление…'}" Style="{StaticResource Muted}" VerticalAlignment="Center"
                                                                   Visibility="{Binding IsApplyingExclusions, Converter={StaticResource BoolToVis}}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                                                <StackPanel>
                                                    <TextBlock Text="{loc:Loc 'Заводской сброс'}" Style="{StaticResource H2}" Margin="0,0,0,8"/>
                                                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10"
                                                               Text="{loc:Loc 'Полностью очищает локальное состояние: настройки, стратегии, списки, логи, кэш, автозапуск и распакованный движок. После перезапуска программа стартует как новая.'}"/>
                                                    <Button Content="{loc:Loc 'Вернуть к заводскому состоянию'}" Command="{Binding ResetSettingsCommand}"
                                                            Style="{StaticResource DangerButton}" HorizontalAlignment="Left"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                                                <StackPanel>
                                                    <TextBlock Text="{loc:Loc 'Файлы логов'}" Style="{StaticResource H2}" Margin="0,0,0,8"/>
                                                    <TextBlock Text="{Binding LogFilesStatus}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                                    <Button Content="{loc:Loc 'Очистить логи'}" Command="{Binding ClearLogFilesCommand}"
                                                            Style="{StaticResource GhostButton}" HorizontalAlignment="Left" ToolTip="{loc:Loc 'Удалить накопленные файлы журналов для освобождения места'}"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                                                <StackPanel>
                                                    <TextBlock Text="{loc:Loc 'Отчёт для поддержки'}" Style="{StaticResource H2}" Margin="0,0,0,8"/>
                                                    <TextBlock Text="{Binding SupportBundleStatus}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                                    <Button Content="{loc:Loc 'Экспорт отчёта для поддержки (.zip)'}" Command="{Binding ExportSupportBundleCommand}"
                                                            Style="{StaticResource GhostButton}" HorizontalAlignment="Left" ToolTip="{loc:Loc 'Собрать архив с обезличенными логами и настройками для помощи'}"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                                                <StackPanel>
                                                    <TextBlock Text="{loc:Loc 'Сброс DNS и сокетов'}" Style="{StaticResource H2}" Margin="0,0,0,8"/>
                                                    <TextBlock Text="{Binding FlushDnsStatus}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                                    <WrapPanel>
                                                        <Button Content="{loc:Loc 'Очистить кэш DNS'}" Command="{Binding FlushDnsCommand}"
                                                                Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="0,0,8,0"/>
                                                        <Button Content="{loc:Loc 'Сброс сокетов браузера'}" Command="{Binding OpenBrowserSocketsHelpCommand}"
                                                                Style="{StaticResource GhostButton}" HorizontalAlignment="Left"/>
                                                    </WrapPanel>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </controls:ResponsiveColumnsPanel>
                                </ScrollViewer>
                            </TabItem>
                        </TabControl>
                    </Grid>
                </TabItem>
            </TabControl>
            </Grid>

            <Border Grid.Row="2" Background="{StaticResource SurfaceAltBrush}"
                    BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,1,0,0"
                    MinHeight="36" Padding="14,6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border x:Name="SettingsSaveWarningBanner" Grid.Row="0" Padding="10,7" Margin="0,0,0,6"
                            Background="{StaticResource WarnSoftBrush}" CornerRadius="8"
                            Visibility="{Binding HasUnsavedSettings, Converter={StaticResource BoolToVis}}"
                            ToolTip="{Binding SettingsSaveError}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="{loc:Loc 'Повторить сохранение'}"
                                    Command="{Binding RetrySaveSettingsCommand}" Style="{StaticResource GhostButton}"
                                    Margin="12,0,0,0" Padding="10,5"/>
                            <TextBlock Text="{loc:Loc 'Изменения не сохранены. Проверьте доступ к папке данных и повторите сохранение.'}"
                                       TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>
                <!-- Mode 1: AutoSelect running -->
                <Grid Grid.Row="1" Visibility="{Binding IsAutoRunning, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding AutoStatsSummary}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <ProgressBar Value="{Binding AutoProgress}" IsIndeterminate="{Binding IsAutoProgressIndeterminate}" Minimum="0" Maximum="1" Height="3"
                                     Style="{StaticResource ModernProgressBar}" Margin="0,5,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Click="OnShowStrategyCheck" Style="{StaticResource GhostButton}" Padding="10,5" Margin="0,0,8,0"
                            ToolTip="{loc:Loc 'Открыть окно детальной проверки стратегий'}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Activity}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{loc:Loc 'Проверка'}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2" Command="{Binding StopAutoSelectCommand}" Style="{StaticResource GhostButton}" Padding="8,5"
                            ToolTip="{loc:Loc 'Остановить проверку стратегий'}">
                        <Path Data="{StaticResource Icon.Stop}" Fill="{StaticResource DangerBrush}" Width="12" Height="12" Stretch="Uniform"/>
                    </Button>
                </Grid>

                <!-- Mode 2: Standard operational status bar -->
                <Grid Grid.Row="1" Visibility="{Binding IsAutoRunning, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Engine Status Dot & Text + Strategy Pill + Scope Pill -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Dot Indicator -->
                        <Ellipse Width="8" Height="8" Margin="0,0,7,0" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource FgMutedBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsTransitioning}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource WarnBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>

                        <!-- Engine State Text -->
                        <TextBlock Text="{Binding HeroButtonText}" FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource FgBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>

                        <!-- Strategy Pill -->
                        <Border Background="{StaticResource SurfaceElevatedBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                                CornerRadius="5" Padding="7,2" Margin="0,0,6,0" VerticalAlignment="Center"
                                ToolTip="{loc:Loc 'Активная / выбранная стратегия DPI desync'}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Zap}" Fill="{StaticResource AccentBrush}" Width="10" Height="10" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding StatusActiveStrategyText}" FontSize="11" Foreground="{StaticResource FgBrush}" MaxWidth="180" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Scope Pill -->
                        <Border Background="{StaticResource SurfaceElevatedBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                                CornerRadius="5" Padding="7,2" Margin="0,0,6,0" VerticalAlignment="Center"
                                ToolTip="{loc:Loc 'Область применения правил обхода'}">
                            <TextBlock Text="{Binding StatusScopeText}" FontSize="11" Foreground="{StaticResource FgMutedBrush}" MaxWidth="150" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>

                    <!-- Center: Status message -->
                    <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" FontSize="11.5"
                               Foreground="{StaticResource FgMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" Margin="12,0" ToolTip="{Binding StatusMessage}"/>

                    <!-- Right: TG Proxy Pill + Fast Flush DNS + Version -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Telegram Proxy Pill -->
                        <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="5" Padding="6,2" Margin="0,0,8,0" VerticalAlignment="Center"
                                Visibility="{Binding IsTelegramProxyRunning, Converter={StaticResource BoolToVis}}"
                                ToolTip="{loc:Loc 'Локальный MTProto прокси Telegram активен'}">
                            <TextBlock Text="TG Proxy: ON" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                        </Border>

                        <!-- Flush DNS Quick Button -->
                        <Button Command="{Binding FlushDnsCommand}" Style="{StaticResource GhostButton}" Padding="6,3" Margin="0,0,8,0"
                                ToolTip="{loc:Loc 'Быстрый сброс системного DNS кэша'}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Refresh}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="10" Height="10" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="DNS" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- App Version Tag -->
                        <TextBlock Text="v4.0.0" FontSize="11" FontFamily="{StaticResource MonoFont}"
                                   Foreground="{StaticResource FgMutedBrush}" VerticalAlignment="Center" Opacity="0.7"/>
                    </StackPanel>
                </Grid>
                </Grid>
            </Border>

            <!-- ============ In-App Floating Toast Notification ============ -->
            <Border x:Name="InAppToastCard" Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="98"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,56,20,0" MaxWidth="380" MinWidth="260"
                    Background="{StaticResource SurfaceElevatedBrush}"
                    BorderBrush="{StaticResource AccentBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="14,12" Visibility="Collapsed"
                    Effect="{StaticResource CardSoftShadow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- Icon Bubble -->
                    <Border x:Name="InAppToastIconBorder" Grid.Column="0" Width="30" Height="30" CornerRadius="8"
                            Background="{StaticResource AccentSoftBrush}" VerticalAlignment="Top" Margin="0,1,10,0">
                        <Path x:Name="InAppToastIcon" Data="{StaticResource Icon.Check}" Fill="{StaticResource AccentBrush}"
                              Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <!-- Text: Title & Message -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                        <TextBlock x:Name="InAppToastTitle" FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource FgBrush}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="InAppToastMessage" FontSize="11.5" Foreground="{StaticResource FgMutedBrush}"
                                   TextWrapping="Wrap" Margin="0,3,0,0" LineHeight="16"/>
                    </StackPanel>
                    <!-- Close button -->
                    <Button Grid.Column="2" Click="OnCloseInAppToast" Style="{StaticResource GhostButton}"
                            Padding="5" VerticalAlignment="Top" HorizontalAlignment="Right" ToolTip="{loc:Loc 'Закрыть'}">
                        <Path Data="{StaticResource Icon.Close}" Stroke="{StaticResource FgMutedBrush}"
                              StrokeThickness="1.5" Width="10" Height="10" Stretch="Uniform"/>
                    </Button>
                </Grid>
            </Border>

            <!-- ============ Modal: how it works / app tour ============ -->
            <Grid Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="100" Background="#C0000000"
                  Visibility="{Binding ShowHowItWorks, Converter={StaticResource BoolToVis}}">
                <Border Style="{StaticResource ModalCard}" MaxWidth="520" MaxHeight="640"
                        VerticalAlignment="Center" HorizontalAlignment="Center"
                        BorderBrush="{StaticResource AccentBrush}" BorderThickness="1">
                    <Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="{loc:Loc 'Как это работает'}" Style="{StaticResource H2}"/>
                                <Button Command="{Binding CloseHowItWorksCommand}"
                                        Style="{StaticResource GhostButton}" HorizontalAlignment="Right"
                                        VerticalAlignment="Top" Padding="8,6" MinWidth="0">
                                    <Path Data="{StaticResource Icon.Close}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" Width="12" Height="12" Stretch="Uniform"/>
                                </Button>
                            </Grid>

                            <TextBlock Style="{StaticResource Muted}" FontSize="12.5" TextWrapping="Wrap" Margin="0,8,0,0"
                                       Text="{loc:Loc 'GXBRIEL_ZAPRET обходит блокировки и замедления (DPI) для Discord и YouTube. Внутри работает движок winws2 — он на лету «ломает» распознавание трафика провайдером, не меняя сами сайты. Для работы нужны права администратора (запрашиваются при старте).'}"/>

                            <!-- 1. Быстрый старт -->
                            <TextBlock Text="{loc:Loc '1. С чего начать'}" FontWeight="Bold" Margin="0,16,0,4"
                                       FontFamily="{StaticResource DisplayFont}"/>
                            <TextBlock Style="{StaticResource Muted}" FontSize="12.5" TextWrapping="Wrap"
                                       Text="{loc:Loc 'На вкладке «Главная» нажмите большую кнопку «Включить обход» — приложение применит рекомендуемую стратегию и запустит обход. Сверху можно выбрать цель (Discord + YouTube / только Discord / только YouTube). Если не помогло — «Подобрать стратегию» переберёт проверенные варианты под вашу сеть; начинать стоит с неё. «Сгенерировать стратегию» собирает вариант с нуля — дольше, но помогает там, где подбор не пробил.'}"/>

                            <!-- 2. Простой / Расширенный -->
                            <TextBlock Text="{loc:Loc '2. Два режима'}" FontWeight="Bold" Margin="0,14,0,4"
                                       FontFamily="{StaticResource DisplayFont}"/>
                            <TextBlock Style="{StaticResource Muted}" FontSize="12.5" TextWrapping="Wrap"
                                       Text="{loc:Loc 'Переключатель «Простой / Расширенный» вверху по центру. В простом режиме — только «Главная»: кнопка вкл/выкл, выбор цели, «Подобрать»/«Сгенерировать» стратегию, информационная карточка. В расширенном открываются вкладки сверху: Главная, Стратегии, Хостлисты, Диагностика, Журнал, Настройки.'}"/>

                            <!-- 3. Вкладки -->
                            <TextBlock Text="{loc:Loc '3. Что где находится'}" FontWeight="Bold" Margin="0,14,0,6"
                                       FontFamily="{StaticResource DisplayFont}"/>
                            <StackPanel>
                                <TextBlock Style="{StaticResource Muted}" FontSize="12.5" TextWrapping="Wrap" Text="{loc:Loc '• Главная — статус, большая кнопка вкл/выкл, выбор цели, кнопки «Подобрать» и «Сгенерировать» стратегию.'}"/>
                                <TextBlock Style="{StaticResource Muted}" FontSize="12.5" TextWrapping="Wrap" Margin="0,3,0,0" Text="{loc:Loc '• Стратегии — фиксированный каталог GX-B01..GX-B09 и GX-C01..GX-C30. Справа — описание, подключённые хостлисты и «терминал» аргументов winws2. Кнопки проверки: Full Scan, WORK-пул, AutoSelect.'}"/>
                                <TextBlock Style="{StaticResource Muted}" FontSize="12.5" TextWrapping="Wrap" Margin="0,3,0,0" Text="{loc:Loc '• Хостлисты — списки доменов, к которым применяется обход (один домен = одна строка).'}"/>
                                <TextBlock Style="{StaticResource Muted}" FontSize="12.5" TextWrapping="Wrap" Margin="0,3,0,0" Text="{loc:Loc '• Диагностика — подбор/генерация стратегии и матрица доступности сервисов (см. ниже).'}"/>
                                <TextBlock Style="{StaticResource Muted}" FontSize="12.5" TextWrapping="Wrap" Margin="0,3,0,0" Text="{loc:Loc '• Журнал — живой вывод движка (для диагностики проблем).'}"/>
                                <TextBlock Style="{StaticResource Muted}" FontSize="12.5" TextWrapping="Wrap" Margin="0,3,0,0" Text="{loc:Loc '• Настройки — обновление движка, автозапуск, авто-починка, QUIC, игровой фильтр, обход по IP, исключения (антивирус/брандмауэр).'}"/>
                            </StackPanel>

                            <!-- 4. Диагностика -->
                            <TextBlock Text="{loc:Loc '4. Диагностика, подбор и генерация'}" FontWeight="Bold" Margin="0,14,0,4"
                                       FontFamily="{StaticResource DisplayFont}"/>
                            <StackPanel>
                                <TextBlock Style="{StaticResource Muted}" FontSize="12.5" TextWrapping="Wrap" Text="{loc:Loc '• «Подобрать лучшую» — быстро: перебирает готовые стратегии и оставляет одну, общую для всех сервисов. Если Discord и YouTube требуют РАЗНЫХ обходов, одной общей может не хватить — тогда используйте «Сгенерировать».'}"/>
                                <TextBlock Style="{StaticResource Muted}" FontSize="12.5" TextWrapping="Wrap" Margin="0,3,0,0" Text="{loc:Loc '• «Сгенерировать стратегию» — собирает персональную стратегию под «всё сразу»: подбирает лучший обход отдельно для Discord и для YouTube, затем объединяет их в одну стратегию и проверяет её целиком — чтобы сервисы работали вместе, а не только по отдельности. Медленнее, но именно это даёт рабочую стратегию под всё.'}"/>
                                <TextBlock Style="{StaticResource Muted}" FontSize="12.5" TextWrapping="Wrap" Margin="0,3,0,0" Text="{loc:Loc '• «Диагностика» — просто показывает текущую доступность (HTTP / TLS 1.2 / TLS 1.3 / пинг) по сервисам, без подбора. По упавшей ячейке видно, что именно режет провайдер.'}"/>
                                <TextBlock Style="{StaticResource Muted}" FontSize="12.5" TextWrapping="Wrap" Margin="0,3,0,0" Text="{loc:Loc '• После подбора/генерации список «Успешные стратегии» позволяет сохранить любые рабочие варианты в пресеты (не только лучший).'}"/>
                                <TextBlock Style="{StaticResource Muted}" FontSize="12.5" TextWrapping="Wrap" Margin="0,3,0,0" Text="{loc:Loc '• «Свои цели» — добавьте свой сайт: приложение найдёт его поддомены и домены того же бренда в других зонах (yandex.ru → yandex.kz/md…), будет проверять их в диагностике, учитывать при подборе/генерации и применять к ним обход.'}"/>
                            </StackPanel>

                            <!-- 5. Настройки -->
                            <TextBlock Text="{loc:Loc '5. Полезное в Настройках'}" FontWeight="Bold" Margin="0,14,0,4"
                                       FontFamily="{StaticResource DisplayFont}"/>
                            <StackPanel>
                                <TextBlock Style="{StaticResource Muted}" FontSize="12.5" TextWrapping="Wrap" Text="{loc:Loc '• Авто-починка — фоном следит за Discord и YouTube; если обход сломался, сам переподбирает рабочую стратегию.'}"/>
                                <TextBlock Style="{StaticResource Muted}" FontSize="12.5" TextWrapping="Wrap" Margin="0,3,0,0" Text="{loc:Loc '• Игровой фильтр — по умолчанию ВЫКЛ, обход не трогает игровой трафик. Включайте, только если душат саму игру.'}"/>
                                <TextBlock Style="{StaticResource Muted}" FontSize="12.5" TextWrapping="Wrap" Margin="0,3,0,0" Text="{loc:Loc '• Движок и приложение обновляются с GitHub; если api недоступен у провайдера — проверка идёт и через обычный github.com.'}"/>
                            </StackPanel>

                            <!-- 6. Если не работает -->
                            <TextBlock Text="{loc:Loc '6. Если не работает'}" FontWeight="Bold" Margin="0,14,0,4"
                                       FontFamily="{StaticResource DisplayFont}"/>
                            <TextBlock Style="{StaticResource Muted}" FontSize="12.5" TextWrapping="Wrap"
                                       Text="{loc:Loc 'Стратегии зависят от оператора связи — одна и та же не работает у всех одинаково. Порядок действий: попробуйте другой пресет из списка → «Подобрать лучшую» → «Сгенерировать стратегию». Если совсем ничего не пробивает — это, скорее всего, сторона регулятора.'}"/>

                            <!-- 7. Документация -->
                            <TextBlock Text="{loc:Loc '7. Документация и ссылки'}" FontWeight="Bold" Margin="0,14,0,4"
                                       FontFamily="{StaticResource DisplayFont}"/>
                            <TextBlock Style="{StaticResource Muted}" FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,8"
                                       Text="{loc:Loc 'Полное руководство, обзор возможностей и ответы на частые вопросы — на GitHub. Новости и обсуждение — в Telegram-канале.'}"/>
                            <WrapPanel>
                                <Button Style="{StaticResource GhostButton}" Margin="0,0,8,8"
                                        Command="{Binding OpenLinkCommand}"
                                        CommandParameter="readme">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource Icon.BookOpen}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="{loc:Loc 'Полная инструкция'}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource GhostButton}" Margin="0,0,8,8"
                                        Command="{Binding OpenLinkCommand}"
                                        CommandParameter="{loc:Loc '#'}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource Icon.FileText}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="{loc:Loc 'О программе (README)'}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource GhostButton}" Margin="0,0,8,8"
                                        Command="{Binding OpenLinkCommand}"
                                        CommandParameter="#">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource Icon.Send}" Fill="{StaticResource Brand.Telegram}" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="{loc:Loc 'Telegram-канал'}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </WrapPanel>

                            <Button Content="{loc:Loc 'Понятно'}" Command="{Binding CloseHowItWorksCommand}"
                                    Style="{StaticResource StartStopButton}" HorizontalAlignment="Right" Margin="0,18,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- ============ Modal: first-run walkthrough ============
                 Shown once on a fresh install (MainWindow.OnLoaded, suppressed under the screenshot
                 harness) and on demand from Настройки → «Показать вводную». Deliberately a short
                 ordered path — what to press, what to expect, what to do when it doesn't work —
                 handing off to the full "Как это работает" reference for the details. -->
            <Grid Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="99" Background="#C0000000"
                  Visibility="{Binding ShowWelcome, Converter={StaticResource BoolToVis}}">
                <Border Style="{StaticResource ModalCard}" MaxWidth="560" MaxHeight="660"
                        VerticalAlignment="Center" HorizontalAlignment="Center"
                        BorderBrush="{StaticResource AccentBrush}" BorderThickness="1">
                    <Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
                    <!-- Buttons live OUTSIDE the ScrollViewer: this modal has no ✕, so if the actions
                         scrolled off the bottom a first-time user would have no way out of it. -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc 'Добро пожаловать'}" Style="{StaticResource H2}"/>
                            <TextBlock Style="{StaticResource Muted}" FontSize="12.5" TextWrapping="Wrap" Margin="0,8,0,0"
                                       Text="{loc:Loc 'GXBRIEL_ZAPRET возвращает доступ к Discord и YouTube. Это не VPN: трафик никуда не перенаправляется и не шифруется заново — движок winws2 лишь мешает провайдеру опознать, куда вы идёте. Поэтому скорость не падает, а всё, чего нет в списках — игры, банки, рабочие сервисы — не затрагивается вообще.'}"/>

                            <TextBlock Text="{loc:Loc '1. Включите обход'}" FontWeight="Bold" Margin="0,16,0,4"
                                       FontFamily="{StaticResource DisplayFont}"/>
                            <TextBlock Style="{StaticResource Muted}" FontSize="12.5" TextWrapping="Wrap"
                                       Text="{loc:Loc 'На «Главной» нажмите большую кнопку «Включить обход» — приложение возьмёт рекомендуемую стратегию и запустит движок. Windows спросит права администратора: они нужны драйверу, который перехватывает пакеты, без них обход работать не может. Окно можно закрыть — программа свернётся в трей и продолжит работать.'}"/>

                            <TextBlock Text="{loc:Loc '2. Проверьте, что получилось'}" FontWeight="Bold" Margin="0,14,0,4"
                                       FontFamily="{StaticResource DisplayFont}"/>
                            <TextBlock Style="{StaticResource Muted}" FontSize="12.5" TextWrapping="Wrap"
                                       Text="{loc:Loc 'Откройте Discord или YouTube. Заработало — больше делать нечего. Не заработало — это не поломка приложения: провайдеры фильтруют по-разному, и одна стратегия физически не может подойти всем. Просто переходите к шагу 3.'}"/>

                            <TextBlock Text="{loc:Loc '3. Не пробило — подберите стратегию'}" FontWeight="Bold" Margin="0,14,0,4"
                                       FontFamily="{StaticResource DisplayFont}"/>
                            <TextBlock Style="{StaticResource Muted}" FontSize="12.5" TextWrapping="Wrap"
                                       Text="{loc:Loc '«Подобрать стратегию» переберёт проверенные варианты и оставит тот, что открывает ваши сервисы — обычно минута-две. Начинать стоит именно с неё: она идёт по готовому списку и потому предсказуемее. Если подбор не помог — «Сгенерировать стратегию»: она собирает вариант с нуля, отдельно под Discord и под YouTube. Дольше, но берёт там, где подбор пасует.'}"/>

                            <TextBlock Text="{loc:Loc '4. Если ничего не помогло'}" FontWeight="Bold" Margin="0,14,0,4"
                                       FontFamily="{StaticResource DisplayFont}"/>
                            <TextBlock Style="{StaticResource Muted}" FontSize="12.5" TextWrapping="Wrap"
                                       Text="{loc:Loc '«Настройки» → «Проверить окружение» покажет, не мешает ли включённый VPN или другая программа обхода: они занимают тот же драйвер, и вместе с ними обход не заработает. Вкладка «Диагностика» покажет, что именно режет провайдер, а «Журнал» — что делает движок.'}"/>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Content="{loc:Loc 'Как это работает'}" Command="{Binding WelcomeToHowItWorksCommand}"
                                Style="{StaticResource GhostButton}" Margin="0,0,8,0"/>
                        <!-- MinWidth keeps the button from resizing as the countdown digits drop off. -->
                        <Button Content="{Binding WelcomeButtonText}" Command="{Binding CloseWelcomeCommand}"
                                Style="{StaticResource PrimaryButton}" MinWidth="176"/>
                    </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ============ Modal: add / edit a custom target ============ -->
            <Grid Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="100" Background="#C0000000"
                  Visibility="{Binding ShowTargetPopup, Converter={StaticResource BoolToVis}}">
                <Border Style="{StaticResource ModalCard}" MaxWidth="500" MaxHeight="660"
                        VerticalAlignment="Center" HorizontalAlignment="Center"
                        BorderBrush="{StaticResource AccentBrush}" BorderThickness="1">
                    <Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource H2}">
                                        <Setter Property="Text" Value="{loc:Loc 'Своя цель'}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TargetIsNew}" Value="True">
                                                <Setter Property="Text" Value="{loc:Loc 'Новая цель'}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Button Command="{Binding CloseTargetPopupCommand}"
                                    Style="{StaticResource GhostButton}" HorizontalAlignment="Right"
                                    VerticalAlignment="Top" Padding="8,6" MinWidth="0">
                                <Path Data="{StaticResource Icon.Close}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" Width="12" Height="12" Stretch="Uniform"/>
                            </Button>
                        </Grid>

                        <TextBlock Grid.Row="1" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Text="{loc:Loc 'Укажите корневой домен сайта (например yandex.ru). По кнопке приложение найдёт его поддомены (crt.sh) и домены того же бренда на других зонах, проверив по TLS-сертификату, что они реально принадлежат тому же сервису (yandex.kz, yandex.md…), а не сквоттерам с похожим именем. Проверьте список, добавьте/уберите свои и сохраните.'}"/>

                        <Grid Grid.Row="2" Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Margin="0,0,8,0"
                                     Text="{Binding TargetRootInput, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Grid.Column="1" Command="{Binding ExpandTargetCommand}"
                                    Style="{StaticResource GhostButton}">
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{loc:Loc 'Найти домены'}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsExpandingTarget}" Value="True">
                                                    <Setter Property="Text" Value="{loc:Loc 'Ищу…'}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>
                        </Grid>

                        <TextBlock Grid.Row="3" Text="{loc:Loc 'Домены цели (по одному в строке)'}"
                                   Style="{StaticResource Muted}" FontSize="11" Margin="0,12,0,6"/>
                        <TextBox Grid.Row="4" MinHeight="160"
                                 Text="{Binding TargetDomainsText, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="NoWrap" Background="{StaticResource BgBrush}"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 FontFamily="{StaticResource MonoFont}" FontSize="12.5"/>

                        <StackPanel Grid.Row="5" Margin="0,10,0,0">
                            <!-- animated "busy" bar while domains are being verified — so it's visibly working -->
                            <ProgressBar Style="{StaticResource BusyBar}" Margin="0,0,0,8"
                                         Visibility="{Binding IsExpandingTarget, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Text="{Binding TargetStatus}" Style="{StaticResource Muted}"
                                       FontSize="11.5" TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel Grid.Row="6" Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Content="{loc:Loc 'Сохранить цель'}" Command="{Binding SaveTargetCommand}"
                                    Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
                            <Button Content="{loc:Loc 'Закрыть'}" Command="{Binding CloseTargetPopupCommand}"
                                    Style="{StaticResource GhostButton}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ============ Modal: Actionable Error Dialog (Human explanation + Collapsible Technical Details) ============ -->
            <Grid Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="120" Background="#C8000000"
                  Visibility="{Binding ShowErrorDialog, Converter={StaticResource BoolToVis}}">
                <Border Style="{StaticResource ModalCard}" MaxWidth="520" MaxHeight="580"
                        VerticalAlignment="Center" HorizontalAlignment="Center"
                        BorderBrush="{StaticResource DangerBrush}" BorderThickness="1">
                    <Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
                    <StackPanel>
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="32" Height="32" CornerRadius="8" Background="#26FF647C" Margin="0,0,12,0">
                                    <Path Data="{StaticResource Icon.AlertTriangle}" Fill="{StaticResource DangerBrush}" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{Binding ErrorDialogTitle}" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button Command="{Binding CloseErrorDialogCommand}"
                                    Style="{StaticResource GhostButton}" HorizontalAlignment="Right"
                                    VerticalAlignment="Top" Padding="8,6" MinWidth="0">
                                <Path Data="{StaticResource Icon.Close}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" Width="12" Height="12" Stretch="Uniform"/>
                            </Button>
                        </Grid>

                        <TextBlock Text="{Binding ErrorDialogMessage}" Style="{StaticResource Muted}" FontSize="13" LineHeight="19"
                                   TextWrapping="Wrap" Margin="0,14,0,0" Foreground="{StaticResource FgBrush}"/>

                        <!-- Collapsible technical details -->
                        <StackPanel Margin="0,12,0,0" Visibility="{Binding HasErrorDialogDetails, Converter={StaticResource BoolToVis}}">
                            <Button Command="{Binding ToggleErrorDetailsCommand}" Style="{StaticResource GhostButton}"
                                    HorizontalAlignment="Left" Padding="10,5" FontSize="11.5">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource Icon.Terminal}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="{loc:Loc 'Технические подробности'}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Border CornerRadius="8" Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"
                                    Padding="10,8" Margin="0,8,0,0" MaxHeight="140"
                                    Visibility="{Binding ShowErrorDetails, Converter={StaticResource BoolToVis}}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <TextBox Text="{Binding ErrorDialogDetails, Mode=OneWay}" IsReadOnly="True"
                                             Background="Transparent" BorderThickness="0" Padding="0"
                                             FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="#FFEAE7EE"
                                             TextWrapping="Wrap"/>
                                </ScrollViewer>
                            </Border>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                            <Button Content="{Binding ErrorDialogActionText}" Command="{Binding ErrorDialogActionCommand}"
                                    Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                                    Visibility="{Binding HasErrorDialogAction, Converter={StaticResource BoolToVis}}"/>
                            <Button Content="{loc:Loc 'Понятно'}" Command="{Binding CloseErrorDialogCommand}"
                                    Style="{StaticResource PrimaryButton}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ============ Modal: Discovery Applications Catalog ============ -->
            <Grid Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="110" Background="#C8000000"
                  Visibility="{Binding ShowDiscoveryCatalog, Converter={StaticResource BoolToVis}}">
                <Border Style="{StaticResource ModalCard}" MaxWidth="640" MaxHeight="680"
                        VerticalAlignment="Center" HorizontalAlignment="Center"
                        BorderBrush="{StaticResource AccentBrush}" BorderThickness="1">
                    <Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

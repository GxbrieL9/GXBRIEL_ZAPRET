<Window x:Class="GxbrielZapret.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:loc="clr-namespace:GxbrielZapret.Localization"
        xmlns:controls="clr-namespace:GxbrielZapret.Controls"
        Title="GXBRIEL_ZAPRET" Height="720" Width="1280" MinHeight="580" MinWidth="880"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="CanResize"
        Icon="/GXBRIEL_ZAPRET;component/Assets/app.ico"
        Background="Transparent"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <!-- Segmented control for Простой / Расширенный -->
        <Style x:Key="ModeSegment" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource FgMutedBrush}"/>
            <Setter Property="Padding" Value="14,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="b" CornerRadius="8" Background="Transparent"
                                BorderBrush="Transparent" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource FgBrush}"/>
                                <Setter TargetName="b" Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource SurfaceElevatedBrush}"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource FgBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46" ResizeBorderThickness="6"
                            CornerRadius="24" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <!-- ============ Outer Floating Main Shell ============ -->
    <Border x:Name="RootBorder" Margin="0" CornerRadius="20" Background="{StaticResource CanvasBgBrush}"
            BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
            ClipToBounds="True" RenderOptions.ClearTypeHint="Enabled">
        <!-- ContentRoot carries the app-wide UI-scale ScaleTransform (see MainWindow.ApplyUiScale) -->
        <Grid x:Name="ContentRoot">
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>



            <!-- ============ Integrated Caption Bar ============ -->
            <Grid Grid.Row="0" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ProgressBar Grid.ColumnSpan="3" Height="2" VerticalAlignment="Bottom" IsIndeterminate="True"
                             Style="{StaticResource ModernProgressBar}" Visibility="{Binding IsInitializing, Converter={StaticResource BoolToVis}}"/>

                <!-- Left: Logo + App Tag + Update Badge -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                    <Image Source="/GXBRIEL_ZAPRET;component/Assets/app-256.png" Width="20" Height="20" Margin="0,0,9,0" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock FontFamily="{StaticResource DisplayFont}" FontSize="13.5" VerticalAlignment="Center">
                        <Run Text="GXBRIEL_ZAPRET" Foreground="{StaticResource FgBrush}" FontWeight="SemiBold"/>
                    </TextBlock>
                    <!-- App-update badge -->
                    <Button Command="{Binding OpenAppReleaseCommand}" VerticalAlignment="Center" Margin="10,0,0,0"
                            Cursor="Hand" shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Visibility="{Binding AppUpdateAvailable, Converter={StaticResource BoolToVis}}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="#26F6B94A" BorderBrush="{StaticResource WarnBrush}" BorderThickness="1"
                                        CornerRadius="6" Padding="8,2">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource Icon.AlertTriangle}" Fill="{StaticResource WarnBrush}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding AppUpdateText}" FontSize="11" Foreground="{StaticResource WarnBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>

                <!-- Center: Mode Switcher [ Простой | Расширенный ] -->
                <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="10"
                        Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush2}"
                        BorderThickness="1" Padding="3"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource ModeSegment}" Content="{loc:Loc 'Простой'}"
                                     IsChecked="{Binding IsSimpleMode, Mode=TwoWay}"/>
                        <RadioButton Style="{StaticResource ModeSegment}" Content="{loc:Loc 'Расширенный'}"
                                     IsChecked="{Binding IsSimpleMode, Converter={StaticResource InverseBool}, Mode=TwoWay}"/>
                    </StackPanel>
                </Border>

                <!-- Right: Help (?), Settings (⚙), Window Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Command="{Binding GoToHelpCommand}" Style="{StaticResource GhostButton}"
                            Width="30" Height="30" Padding="0" Margin="0,0,4,0" ToolTip="{loc:Loc 'Справка и документация'}">
                        <Path Data="{StaticResource Icon.HelpCircle}"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              Width="14" Height="14" Stretch="Uniform"/>
                    </Button>
                    <Button Command="{Binding GoToSettingsCommand}" Style="{StaticResource GhostButton}"
                            Width="30" Height="30" Padding="0" Margin="0,0,10,0" ToolTip="{loc:Loc 'Настройки'}">
                        <Path Data="{StaticResource Icon.Settings}"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              Width="14" Height="14" Stretch="Uniform"/>
                    </Button>

                    <!-- Window buttons -->
                    <Button x:Name="MinButton" Style="{StaticResource CaptionButton}" Click="OnMinimize" ToolTip="{loc:Loc 'Свернуть'}">
                        <Path Data="{StaticResource Icon.Minimize}"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              Width="14" Height="14" Stretch="Uniform"/>
                    </Button>
                    <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Click="OnMaximizeRestore" ToolTip="{loc:Loc 'Развернуть / Восстановить'}">
                        <Path x:Name="MaxButtonPath" Data="{StaticResource Icon.Maximize}"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              Width="13" Height="13" Stretch="Uniform"/>
                    </Button>
                    <Button x:Name="CloseButton" Style="{StaticResource CloseButton}" Click="OnCloseClick" ToolTip="{loc:Loc 'Закрыть'}">
                        <Path Data="{StaticResource Icon.Close}"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              Width="13" Height="13" Stretch="Uniform"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ============ Main Body: Isolated Sidebar Island (Left) + Content (Right) ============ -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="210"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ============ Sidebar: Isolated Rounded Black Island ============ -->
                <Border Grid.Column="0" Margin="12,12,0,16" CornerRadius="14" Background="{StaticResource SidebarBgBrush}"
                        BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" Padding="12,14,12,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Main Navigation Group -->
                        <StackPanel Grid.Row="0">
                            <!-- Home -->
                            <RadioButton Style="{StaticResource NavButton}" Command="{Binding GoToHomeCommand}" Margin="0,0,0,6"
                                         IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IntEquals}, ConverterParameter=0, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource Icon.Home}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBlock Text="{loc:Loc 'Главная'}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                            <!-- Strategies -->
                            <RadioButton Style="{StaticResource NavButton}" Command="{Binding GoToStrategiesCommand}" Margin="0,0,0,6"
                                         IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IntEquals}, ConverterParameter=1, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource Icon.Zap}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBlock Text="{loc:Loc 'Стратегии'}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                            <!-- Hostlists (Advanced Mode only) -->
                            <RadioButton Style="{StaticResource NavButton}" Command="{Binding GoToHostlistsCommand}" Margin="0,0,0,6"
                                         Visibility="{Binding IsAdvancedMode, Converter={StaticResource BoolToVis}}"
                                         IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IntEquals}, ConverterParameter=2, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource Icon.List}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBlock Text="{loc:Loc 'Хостлисты'}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                            <!-- Diagnostics -->
                            <RadioButton Style="{StaticResource NavButton}" Command="{Binding GoToDiagnosticsCommand}" Margin="0,0,0,6"
                                         IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IntEquals}, ConverterParameter=3, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource Icon.Activity}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBlock Text="{loc:Loc 'Диагностика'}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                            <!-- Journal (Advanced Mode only) -->
                            <RadioButton Style="{StaticResource NavButton}" Command="{Binding GoToJournalCommand}" Margin="0,0,0,6"
                                         Visibility="{Binding IsAdvancedMode, Converter={StaticResource BoolToVis}}"
                                         IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IntEquals}, ConverterParameter=4, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource Icon.Terminal}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBlock Text="{loc:Loc 'Журнал'}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                            <!-- Antigravity Patcher -->
                            <RadioButton Style="{StaticResource NavButton}" Command="{Binding GoToPatcherCommand}" Margin="0,0,0,6"
                                         IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IntEquals}, ConverterParameter=5, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource Icon.ShieldCheck}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBlock Text="{loc:Loc 'Патчер'}" VerticalAlignment="Center"/>
                                    <Border Width="6" Height="6" CornerRadius="3" Background="{Binding PatcherBadgeColor}" VerticalAlignment="Center" Margin="8,0,0,0"
                                            Visibility="{Binding ShowPatcherBadge, Converter={StaticResource BoolToVis}}"
                                            ToolTip="{Binding PatcherBadgeToolTip}"/>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>

                        <!-- Bottom Engine State Badge & Settings / Help -->
                        <StackPanel Grid.Row="2">
                            <Border CornerRadius="10" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                                    Padding="10,7" Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,8,0"
                                             Fill="{Binding State, Converter={StaticResource StateToBrush}}"/>
                                    <StackPanel>
                                        <TextBlock Text="{Binding State, Converter={StaticResource StateToText}}" FontSize="11.5" FontWeight="Medium"/>
                                        <TextBlock Text="{Binding RunStatusText}" Style="{StaticResource Muted}" FontSize="10" MaxWidth="150" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Height="1" Background="{StaticResource BorderBrush2}" Margin="0,0,0,8"/>
                            <RadioButton Style="{StaticResource NavButton}" Command="{Binding GoToSettingsCommand}" Margin="0,0,0,4"
                                         IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IntEquals}, ConverterParameter=6, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource Icon.Settings}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBlock Text="{loc:Loc 'Настройки'}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource NavButton}" Command="{Binding GoToHelpCommand}" IsChecked="False">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource Icon.HelpCircle}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBlock Text="{loc:Loc 'Справка'}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ============ Main Tab Control (Right) ============ -->
                <TabControl x:Name="MainTabs" Grid.Column="1" SelectedIndex="{Binding SelectedTabIndex}"
                            SelectionChanged="OnTabsSelectionChanged" Style="{StaticResource PlainTabControl}">
                    <!-- ===================== Главная ===================== -->
                    <TabItem Header="{loc:Loc 'Главная'}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,20,24,20">
                            <StackPanel>
                                <!-- ================= PRODUCT TITLE & NETWORK BADGE ================= -->
                                <Grid Margin="0,0,0,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{loc:Loc 'Главная'}" Style="{StaticResource H1}"/>
                                        <TextBlock Text="{loc:Loc 'Состояние обхода и доступность сервисов'}" Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border CornerRadius="14" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                                                Padding="11,5" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="6" Height="6" Fill="{StaticResource Muted2Brush}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                                <TextBlock Text="{Binding ActiveNetworkName}" MaxWidth="180" TextTrimming="CharacterEllipsis" FontSize="11" FontWeight="Medium" Foreground="{StaticResource FgBrush}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <!-- ================= TIER 1: MAIN STATUS (LEFT) + TELEGRAM (RIGHT) ================= -->
                                <controls:ResponsiveColumnsPanel MinColumnWidth="390" Gap="14">

                                    <!-- LEFT COLUMN: MAIN STATUS PANEL -->
                                    <Border Grid.Column="0" CornerRadius="14" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" Padding="20,18" ClipToBounds="True">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Row 0: State Badge & Uptime -->
                                            <Grid Grid.Row="0">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border CornerRadius="7" Padding="8,3" Background="{Binding State, Converter={StaticResource StateToSoftBrush}}" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,6,0"
                                                                     Fill="{Binding State, Converter={StaticResource StateToBrush}}">
                                                                <Ellipse.Style>
                                                                    <Style TargetType="Ellipse">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                                                <DataTrigger.EnterActions>
                                                                                    <BeginStoryboard Name="PulseDot">
                                                                                        <Storyboard>
                                                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                                             From="1" To="0.35" Duration="0:0:1"
                                                                                                             AutoReverse="True" RepeatBehavior="Forever"/>
                                                                                        </Storyboard>
                                                                                    </BeginStoryboard>
                                                                                </DataTrigger.EnterActions>
                                                                                <DataTrigger.ExitActions>
                                                                                    <StopStoryboard BeginStoryboardName="PulseDot"/>
                                                                                </DataTrigger.ExitActions>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Ellipse.Style>
                                                            </Ellipse>
                                                            <TextBlock Text="{Binding State, Converter={StaticResource StateToText}}"
                                                                       FontSize="11" FontWeight="SemiBold"
                                                                       Foreground="{Binding State, Converter={StaticResource StateToBrush}}"/>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>

                                                <!-- Live Uptime when Running -->
                                                <Border CornerRadius="7" BorderThickness="1" Padding="8,3" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                        Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#1845C99A"/>
                                                            <Setter Property="BorderBrush" Value="#3345C99A"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsManagedAutostartRunning}" Value="True">
                                                                    <Setter Property="Background" Value="#1FE7B456"/>
                                                                    <Setter Property="BorderBrush" Value="#55E7B456"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,5,0">
                                                            <Path.Style>
                                                                <Style TargetType="Path">
                                                                    <Setter Property="Data" Value="{StaticResource Icon.Activity}"/>
                                                                    <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsManagedAutostartRunning}" Value="True">
                                                                            <Setter Property="Data" Value="{StaticResource Icon.AlertTriangle}"/>
                                                                            <Setter Property="Fill" Value="{StaticResource WarnBrush}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Path.Style>
                                                        </Path>
                                                        <TextBlock Text="{Binding RunningDurationFormatted}" FontSize="11" FontWeight="Medium"
                                                                   FontFamily="{StaticResource MonoFont}" VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsManagedAutostartRunning}" Value="True">
                                                                            <Setter Property="Foreground" Value="{StaticResource WarnBrush}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>

                                            <!-- Row 1: Headline & Subtitle -->
                                            <StackPanel Grid.Row="1" Margin="0,12,0,0">
                                                <TextBlock Text="{Binding State, Converter={StaticResource StateToText}}"
                                                           FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource FgBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsTransitioning}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource WarnBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding ActiveStrategySimpleSubtitle}" Style="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0"/>

                                                <!-- Service scope + real check status. Green appears only after diagnostics confirms availability. -->
                                                <WrapPanel Margin="0,10,0,0" Orientation="Horizontal">
                                                    <Border CornerRadius="8" Background="{Binding DiscordReachabilityStatus, Converter={StaticResource DiagSoftBrush}}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" Padding="8,4" Margin="0,0,7,5">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Path Data="{StaticResource Icon.Discord}" Fill="{StaticResource Brand.Discord}" Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                            <TextBlock Text="Discord" FontSize="11" FontWeight="Medium" Foreground="{StaticResource FgBrush}" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding DiscordReachabilityText}" FontSize="10.5" FontWeight="SemiBold" Foreground="{Binding DiscordReachabilityStatus, Converter={StaticResource DiagBrush}}" VerticalAlignment="Center" Margin="5,0,0,0"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border CornerRadius="8" Background="{Binding YouTubeReachabilityStatus, Converter={StaticResource DiagSoftBrush}}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" Padding="8,4" Margin="0,0,7,5">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Path Data="{StaticResource Icon.YouTube}" Fill="{StaticResource Brand.YouTube}" Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                            <TextBlock Text="YouTube" FontSize="11" FontWeight="Medium" Foreground="{StaticResource FgBrush}" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding YouTubeReachabilityText}" FontSize="10.5" FontWeight="SemiBold" Foreground="{Binding YouTubeReachabilityStatus, Converter={StaticResource DiagBrush}}" VerticalAlignment="Center" Margin="5,0,0,0"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border CornerRadius="8" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" Padding="8,4" Margin="0,0,0,5">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Path Data="{StaticResource Icon.Telegram}" Fill="{StaticResource Brand.Telegram}" Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                            <TextBlock Text="Telegram" FontSize="11" FontWeight="Medium" Foreground="{StaticResource FgBrush}" VerticalAlignment="Center"/>
                                                            <TextBlock FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="5,0,0,0">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Text" Value="{loc:Loc 'Не проверено'}"/>
                                                                        <Setter Property="Foreground" Value="{StaticResource Muted2Brush}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsTelegramProxyRunning}" Value="True">
                                                                                <Setter Property="Text" Value="OK"/>
                                                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Border>
                                                </WrapPanel>

                                                <!-- Autostart Banner -->
                                                <Border CornerRadius="8" Background="#1FE7B456" BorderBrush="#55E7B456" BorderThickness="1"
                                                        Padding="10,8" Margin="0,10,0,0"
                                                        Visibility="{Binding IsManagedAutostartRunning, Converter={StaticResource BoolToVis}}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Path Grid.Column="0" Data="{StaticResource Icon.AlertTriangle}" Fill="{StaticResource WarnBrush}"
                                                              Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding ExternalEngineStatusText}"
                                                                   FontSize="11.5" TextWrapping="Wrap" Foreground="{StaticResource FgBrush}"
                                                                   VerticalAlignment="Center"/>
                                                        <Button Grid.Column="2" Content="{loc:Loc 'Остановить'}" Command="{Binding StopCommand}"
                                                                Style="{StaticResource DangerButton}" Padding="10,4" FontSize="11"
                                                                Margin="10,0,0,0" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>

                                                <!-- Strategy Change Banner -->
                                                <Border CornerRadius="8" Background="#1FE7B456" BorderBrush="#55E7B456" BorderThickness="1"
                                                        Padding="10,8" Margin="0,10,0,0"
                                                        Visibility="{Binding IsStrategyChangePending, Converter={StaticResource BoolToVis}}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Path Grid.Column="0" Data="{StaticResource Icon.AlertTriangle}" Fill="{StaticResource WarnBrush}" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Top" Margin="0,2,8,0"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding RunningPresetLine}" FontSize="11.5" Foreground="{StaticResource FgBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                                        <Button Grid.Column="2" Content="{Binding ApplyStrategyButtonText}" Command="{Binding ApplyStrategyCommand}"
                                                                Style="{StaticResource PrimaryButton}" Padding="10,4" FontSize="11.5" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                            </StackPanel>

                                            <!-- Row 2: Hero CTA Button & Preset Pill -->
                                            <Grid Grid.Row="2" Margin="0,16,0,0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <Button Grid.Row="0" Command="{Binding ToggleCommand}" Style="{StaticResource HeroActionButton}"
                                                        Height="42" HorizontalAlignment="Stretch" TabIndex="1">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,9,0"
                                                              Visibility="{Binding IsTransitioning, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                                                            <Path.Style>
                                                                <Style TargetType="Path">
                                                                    <Setter Property="Data" Value="{StaticResource Icon.Play}"/>
                                                                    <Setter Property="Fill" Value="White"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                                            <Setter Property="Data" Value="{StaticResource Icon.Stop}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Path.Style>
                                                        </Path>
                                                        <Path Data="{StaticResource Icon.Loader}" Stroke="White" StrokeThickness="2" Width="13" Height="13" Stretch="Uniform"
                                                              VerticalAlignment="Center" Margin="0,0,9,0"
                                                              Style="{StaticResource SpinningIcon}"
                                                              Visibility="{Binding IsTransitioning, Converter={StaticResource BoolToVis}}"/>
                                                        <TextBlock Text="{Binding HeroButtonText}" FontFamily="{StaticResource DisplayFont}" FontSize="13.5" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>

                                                <Border Grid.Row="1" CornerRadius="8" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                                                        Padding="12,6" Margin="0,8,0,0" VerticalAlignment="Center">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Path Grid.Column="0" Data="{StaticResource Icon.Zap}" Fill="{StaticResource SoftMauveBrush}" Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="{loc:Loc 'Выбранный профиль'}" Style="{StaticResource Muted}" FontSize="11"/>
                                                            <TextBlock Text="{Binding ActiveStrategySimpleName}" FontFamily="{StaticResource DisplayFont}" FontWeight="Medium" FontSize="11.5" Foreground="{StaticResource FgBrush}" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                        </Grid>
                                    </Border>

                                    <!-- RIGHT COLUMN: TELEGRAM -->
                                    <Border Grid.Column="2" CornerRadius="14" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" Padding="20,18">
                                        <StackPanel>
                                            <!-- Top Header & State Toggle -->
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Content="{Binding TelegramProxyButtonText}"
                                                        Command="{Binding EnableTelegramCommand}"
                                                        Padding="12,4" FontSize="11" Height="28">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsTelegramProxyRunning}" Value="True">
                                                                    <Setter Property="Background" Value="#2CE45A71"/>
                                                                    <Setter Property="BorderBrush" Value="#80E45A71"/>
                                                                    <Setter Property="Foreground" Value="#FFFFD8DF"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>

                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border CornerRadius="7" Width="24" Height="24" Background="#2425435D" Margin="0,0,8,0">
                                                        <Path Data="{StaticResource Icon.Telegram}" Fill="{StaticResource Brand.Telegram}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock Text="Telegram" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource FgBrush}"
                                                               FontFamily="{StaticResource DisplayFont}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </DockPanel>

                                            <!-- Live Status Text -->
                                            <Grid Margin="0,8,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,6,0">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="{StaticResource NeutralBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsTelegramProxyRunning}" Value="True">
                                                                    <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <TextBlock Grid.Column="1" Text="{Binding TelegramProxyStatus}" Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap"/>
                                            </Grid>

                                            <!-- Clean Channels Overview -->
                                            <Border CornerRadius="10" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                                                    Padding="10,8" Margin="0,0,0,12">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{loc:Loc 'Сообщения'}" Style="{StaticResource Muted}" FontSize="9.5"/>
                                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                            <Ellipse Width="5" Height="5" VerticalAlignment="Center" Margin="0,0,5,0">
                                                                <Ellipse.Style>
                                                                    <Style TargetType="Ellipse">
                                                                        <Setter Property="Fill" Value="{StaticResource NeutralBrush}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsTelegramProxyRunning}" Value="True">
                                                                                <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Ellipse.Style>
                                                            </Ellipse>
                                                            <TextBlock FontSize="11" FontWeight="Medium">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Text" Value="{loc:Loc 'Остановлен'}"/>
                                                                        <Setter Property="Foreground" Value="{StaticResource FgMutedBrush}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsTelegramProxyRunning}" Value="True">
                                                                                <Setter Property="Text" Value="{loc:Loc 'Активен'}"/>
                                                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{loc:Loc 'Медиа'}" Style="{StaticResource Muted}" FontSize="9.5"/>
                                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                            <Ellipse Width="5" Height="5" VerticalAlignment="Center" Margin="0,0,5,0">
                                                                <Ellipse.Style>
                                                                    <Style TargetType="Ellipse">
                                                                        <Setter Property="Fill" Value="{StaticResource NeutralBrush}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsTelegramProxyRunning}" Value="True">
                                                                                <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Ellipse.Style>
                                                            </Ellipse>
                                                            <TextBlock FontSize="11" FontWeight="Medium">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Text" Value="{loc:Loc 'Остановлен'}"/>
                                                                        <Setter Property="Foreground" Value="{StaticResource FgMutedBrush}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsTelegramProxyRunning}" Value="True">
                                                                                <Setter Property="Text" Value="{loc:Loc 'Активен'}"/>
                                                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <!-- Action buttons: Open in Telegram, Copy link -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1.3*"/>
                                                    <ColumnDefinition Width="6"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <Button Grid.Column="0" Command="{Binding OpenTelegramProxyLinkCommand}" Height="32" Padding="6,0"
                                                        IsEnabled="{Binding IsTelegramProxyRunning}"
                                                        ToolTip="{loc:Loc 'Открыть официальный диалог подключения прокси в клиенте Telegram'}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsTelegramProxyReconfigureRequired}" Value="True">
                                                                    <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                                                    <Setter Property="Foreground" Value="#FFFFFFFF"/>
                                                                    <Setter Property="BorderBrush" Value="{StaticResource AccentHoverBrush}"/>
                                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{StaticResource Icon.ExternalLink}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="10" Height="10" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                        <TextBlock Text="{Binding TelegramProxyActionText}" FontSize="10.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Button>

                                                <Button Grid.Column="2" Command="{Binding CopyTelegramProxyLinkCommand}" Style="{StaticResource GhostButton}" Height="32" Padding="4,0"
                                                        ToolTip="{loc:Loc 'Скопировать tg:// ссылку на прокси'}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{StaticResource Icon.Copy}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="10" Height="10" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                        <TextBlock Text="{loc:Loc 'Ссылка'}" FontSize="10.5" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </controls:ResponsiveColumnsPanel>

                                <controls:ResponsiveColumnsPanel x:Name="HomeTools" Margin="0,16,0,0" MinColumnWidth="310" Gap="14">

                                    <!-- CARD 1: ТЕКУЩАЯ СТРАТЕГИЯ -->
                                    <Border Grid.Column="0" CornerRadius="14" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" Padding="18,14">
                                        <StackPanel>
                                            <Grid>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border CornerRadius="6" Width="24" Height="24" Background="#268E708B" Margin="0,0,8,0">
                                                        <Path Data="{StaticResource Icon.Zap}" Fill="{StaticResource SoftMauveBrush}" Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock Text="{loc:Loc 'Текущая стратегия'}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource FgBrush}"
                                                               FontFamily="{StaticResource DisplayFont}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <!-- Truthful Status Badge -->
                                                <Border CornerRadius="6" Padding="7,2" HorizontalAlignment="Right"
                                                        Background="{Binding StrategyCardBadgeStatus, Converter={StaticResource DiagSoftBrush}}">
                                                    <TextBlock Text="{Binding StrategyCardBadgeText}" FontSize="9.5" FontWeight="SemiBold"
                                                               Foreground="{Binding StrategyCardBadgeStatus, Converter={StaticResource DiagBrush}}"/>
                                                </Border>
                                            </Grid>

                                            <!-- Strategy Name & Tagline -->
                                            <TextBlock Text="{Binding ActiveStrategySimpleName}" FontFamily="{StaticResource DisplayFont}"
                                                       FontWeight="SemiBold" FontSize="15" Margin="0,12,0,0" Foreground="{StaticResource FgBrush}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding ActiveStrategySimpleSubtitle}" Style="{StaticResource Muted}"
                                                       FontSize="11.5" Margin="0,3,0,14" TextTrimming="CharacterEllipsis"/>

                                            <!-- Action button: Change Strategy -->
                                            <Button Command="{Binding GoToStrategiesCommand}" Style="{StaticResource GhostButton}" Height="32">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="{StaticResource Icon.Sliders}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <TextBlock Text="{loc:Loc 'Сменить стратегию'}" FontSize="11"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Border>

                                    <!-- CARD 2: ДОСТУПНОСТЬ СЕРВИСОВ -->
                                    <Border Grid.Column="2" CornerRadius="14" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" Padding="18,14">
                                        <StackPanel>
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Command="{Binding RunDiagnosticsCommand}" Style="{StaticResource GhostButton}"
                                                        Height="26" Padding="8,0"
                                                        Visibility="{Binding IsDiagnosing, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"
                                                        ToolTip="{loc:Loc 'Проверить доступность прямо сейчас'}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{StaticResource Icon.Activity}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="10" Height="10" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                        <TextBlock Text="{loc:Loc 'Проверить'}" FontSize="10.5"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button DockPanel.Dock="Right" Command="{Binding StopDiagnosticsCommand}" Style="{StaticResource GhostButton}"
                                                        Height="26" Padding="8,0"
                                                        Visibility="{Binding IsDiagnosing, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="{loc:Loc 'Стоп'}" FontSize="10.5" Foreground="{StaticResource DangerBrush}"/>
                                                </Button>

                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border CornerRadius="6" Width="24" Height="24" Background="#224C6C81" Margin="0,0,8,0">
                                                        <Path Data="{StaticResource Icon.Activity}" Fill="{StaticResource IceBlueBrush}" Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock Text="{loc:Loc 'Доступность'}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource FgBrush}"
                                                               FontFamily="{StaticResource DisplayFont}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </DockPanel>

                                            <!-- Live Service Reachability Pills (Discord & YouTube) -->
                                            <Grid Margin="0,10,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="8"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- Discord Reachability -->
                                                <Border Grid.Column="0" CornerRadius="8" Padding="8,6"
                                                        ToolTip="{Binding DiscordProbeDetails}"
                                                        Background="{Binding DiscordReachabilityStatus, Converter={StaticResource DiagSoftBrush}}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{StaticResource Icon.Discord}" Fill="{StaticResource Brand.Discord}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                        <StackPanel>
                                                            <TextBlock Text="Discord" FontSize="10.5" FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding DiscordReachabilityText}" FontSize="10"
                                                                        Foreground="{Binding DiscordReachabilityStatus, Converter={StaticResource DiagBrush}}"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                                <!-- YouTube Reachability -->
                                                <Border Grid.Column="2" CornerRadius="8" Padding="8,6"
                                                        ToolTip="{Binding YouTubeProbeDetails}"
                                                        Background="{Binding YouTubeReachabilityStatus, Converter={StaticResource DiagSoftBrush}}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{StaticResource Icon.YouTube}" Fill="{StaticResource Brand.YouTube}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                        <StackPanel>
                                                            <TextBlock Text="YouTube" FontSize="10.5" FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding YouTubeReachabilityText}" FontSize="10"
                                                                        Foreground="{Binding YouTubeReachabilityStatus, Converter={StaticResource DiagBrush}}"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>

                                            <!-- Live progress bar while quick diagnostics is running -->
                                            <TextBlock Text="{Binding ServiceProbeHint}" FontSize="10" Foreground="{StaticResource FgMutedBrush}"
                                                       TextWrapping="Wrap" Margin="0,8,0,0"/>
                                            <TextBlock Text="{Binding LastApplicationFlowSummary}" FontSize="10" Foreground="{StaticResource FgMutedBrush}"
                                                       TextWrapping="Wrap" Margin="0,5,0,0" MaxHeight="30" TextTrimming="CharacterEllipsis" ToolTip="{Binding LastApplicationFlowSummary}"/>
                                            <StackPanel Margin="0,8,0,0" Visibility="{Binding IsDiagnosing, Converter={StaticResource BoolToVis}}">
                                                <ProgressBar Value="{Binding DiagProgress, Mode=OneWay}" Minimum="0" Maximum="100" Height="3" Style="{StaticResource ModernProgressBar}"/>
                                                <TextBlock Text="{Binding DiagProgressText}" FontSize="9.5" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource FgMutedBrush}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- CARD 3: ЦЕЛЬ И АВТОПОДБОР -->
                                    <Border Grid.Column="4" CornerRadius="14" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" Padding="18,14">
                                        <StackPanel>
                                            <DockPanel>
                                                <Border DockPanel.Dock="Right" CornerRadius="6" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" Padding="7,2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ScopeTitle}" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource FgMutedBrush}"/>
                                                </Border>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border CornerRadius="6" Width="24" Height="24" Background="#229D829A" Margin="0,0,8,0">
                                                        <Path Data="{StaticResource Icon.Search}" Fill="{StaticResource SoftMauveBrush}" Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock Text="{loc:Loc 'Автоподбор'}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource FgBrush}"
                                                               FontFamily="{StaticResource DisplayFont}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </DockPanel>

                                            <!-- Scope Chips: Discord + YouTube, Discord, YouTube -->
                                            <WrapPanel Margin="0,8,0,8">
                                                <RadioButton Style="{StaticResource ChipButton}" IsChecked="{Binding ScopeBoth, Mode=TwoWay}" Margin="0,0,4,2">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="DC + YT" VerticalAlignment="Center" FontSize="10"/>
                                                    </StackPanel>
                                                </RadioButton>
                                                <RadioButton Style="{StaticResource ChipButton}" IsChecked="{Binding ScopeDiscord, Mode=TwoWay}" Margin="0,0,4,2">
                                                    <TextBlock Text="Discord" VerticalAlignment="Center" FontSize="10"/>
                                                </RadioButton>
                                                <RadioButton Style="{StaticResource ChipButton}" IsChecked="{Binding ScopeYouTube, Mode=TwoWay}" Margin="0,0,0,2">
                                                    <TextBlock Text="YouTube" VerticalAlignment="Center" FontSize="10"/>
                                                </RadioButton>
                                            </WrapPanel>

                                            <!-- AutoSelect Buttons when Idle / Progress when Running -->
                                            <StackPanel>
                                                <WrapPanel Visibility="{Binding IsAutoRunning, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">

                                                    <Button Grid.Column="0" Command="{Binding FullVerifyProfilesCommand}" Style="{StaticResource GhostButton}"
                                                            Margin="0,0,6,6" Height="30" TabIndex="1" ToolTip="{Binding FullScanTooltip}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Path Data="{StaticResource Icon.Search}" Fill="{StaticResource AccentBrush}" Width="10" Height="10" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                            <TextBlock Text="{loc:Loc 'Полная проверка'}" FontWeight="SemiBold" FontSize="10.5" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Grid.Column="2" Command="{Binding RecheckWorkPoolCommand}" Style="{StaticResource GhostButton}"
                                                            Margin="0,0,6,6" Height="30" TabIndex="2" ToolTip="{loc:Loc 'Быстро перепроверить только WORK-кандидатов'}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Path Data="{StaticResource Icon.Refresh}" Fill="{StaticResource SoftMauveBrush}" Width="10" Height="10" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                            <TextBlock Text="{loc:Loc 'WORK-пул'}" FontWeight="SemiBold" FontSize="10.5" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Grid.Column="4" Command="{Binding RunAutoSelectCommand}" Style="{StaticResource GhostButton}"
                                                            Height="30" ToolTip="{Binding AutoSelectPrimaryTooltip}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Path Data="{StaticResource Icon.Search}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="10" Height="10" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                            <TextBlock Text="{loc:Loc 'Подобрать'}" FontSize="10.5" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Button>
                                                </WrapPanel>

                                                <!-- Running Progress -->
                                                <Border CornerRadius="8" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource MauveGlowBrush}" BorderThickness="1"
                                                        Padding="8,6" Visibility="{Binding IsAutoRunning, Converter={StaticResource BoolToVis}}">
                                                    <StackPanel>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,6,0">
                                                                <TextBlock Text="{Binding AutoStatusText}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource FgBrush}" TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="{Binding CurrentCandidateName}" FontSize="9.5" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource SoftMauveBrush}" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>
                                                            <Button Grid.Column="1" Command="{Binding StopAutoSelectCommand}" Style="{StaticResource GhostButton}"
                                                                    Padding="4,2" FontSize="9.5" VerticalAlignment="Center">
                                                                <TextBlock Text="{loc:Loc 'Стоп'}" Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center"/>
                                                            </Button>
                                                        </Grid>
                                                        <ProgressBar Value="{Binding AutoProgress, Mode=OneWay}" Minimum="0" Maximum="1" Height="3" Style="{StaticResource ModernProgressBar}" Margin="0,4,0,3"/>
                                                        <TextBlock Text="{Binding AutoStatsSummary}" FontSize="9.5" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource FgMutedBrush}"/>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </controls:ResponsiveColumnsPanel>

                                <!-- ================= TIER 3: WIDE MONOLITHIC PANEL (NETWORK HEALTH & TELEMETRY) ================= -->
                                <Border Margin="0,10,0,0" CornerRadius="14" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" Padding="20,14">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Header Row: Title + Timeframe Pills + Status Badge -->
                                        <DockPanel Grid.Row="0">
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border CornerRadius="10" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" Padding="9,3" Margin="0,0,10,0">
                                                    <TextBlock Text="{loc:Loc 'История появится после проверок'}" FontSize="10.5" Foreground="{StaticResource FgMutedBrush}" FontWeight="Medium"/>
                                                </Border>

                                                <Border CornerRadius="7" Padding="8,3"
                                                        Background="{Binding NetworkReachabilityStatus, Converter={StaticResource DiagSoftBrush}}">
                                                    <TextBlock Text="{Binding NetworkReachabilityText}" FontSize="10" FontWeight="SemiBold"
                                                               Foreground="{Binding NetworkReachabilityStatus, Converter={StaticResource DiagBrush}}"/>
                                                </Border>
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border CornerRadius="6" Width="24" Height="24" Background="#2225435D" Margin="0,0,8,0">
                                                    <Path Data="{StaticResource Icon.Activity}" Fill="{StaticResource IceBlueBrush}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="{loc:Loc 'Состояние сети и маршрутизация'}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource FgBrush}"
                                                           FontFamily="{StaticResource DisplayFont}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DockPanel>

                                        <!-- Row 1: Honest network summary. No chart is shown until the app has real time-series metrics. -->
                                        <Border Grid.Row="1" CornerRadius="14" Background="{StaticResource SurfaceAltBrush}"
                                                BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                                                Padding="14,10" Margin="0,10,0,0">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid Grid.Row="0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding NetworkHealthSummaryText}"
                                                               FontSize="13" FontWeight="SemiBold"
                                                               Foreground="{StaticResource FgBrush}" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Column="1" Text="{loc:Loc 'История: после проверок'}"
                                                               FontSize="10.5" Foreground="{StaticResource FgMutedBrush}" Margin="14,0,0,0"/>
                                                </Grid>

                                                <WrapPanel Grid.Row="1" Margin="0,8,0,0">
                                                    <Border CornerRadius="12" Padding="9,5" Margin="0,0,8,0"
                                                            Background="{Binding DiscordReachabilityStatus, Converter={StaticResource DiagSoftBrush}}">
                                                        <TextBlock Text="{Binding DiscordReachabilityText, StringFormat=Discord · {0}}"
                                                                   FontSize="11" FontWeight="SemiBold"
                                                                   Foreground="{Binding DiscordReachabilityStatus, Converter={StaticResource DiagBrush}}"/>
                                                    </Border>
                                                    <Border CornerRadius="12" Padding="9,5" Margin="0,0,8,0"
                                                            Background="{Binding YouTubeReachabilityStatus, Converter={StaticResource DiagSoftBrush}}">
                                                        <TextBlock Text="{Binding YouTubeReachabilityText, StringFormat=YouTube · {0}}"
                                                                   FontSize="11" FontWeight="SemiBold"
                                                                   Foreground="{Binding YouTubeReachabilityStatus, Converter={StaticResource DiagBrush}}"/>
                                                    </Border>
                                                    <Border CornerRadius="12" Padding="9,5">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{StaticResource NeutralSoftBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsTelegramProxyRunning}" Value="True">
                                                                        <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding TelegramProxyStatus, StringFormat=Telegram · {0}}"
                                                                   FontSize="11" FontWeight="SemiBold">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{StaticResource NeutralBrush}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsTelegramProxyRunning}" Value="True">
                                                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                </WrapPanel>
                                            </Grid>
                                        </Border>

                                        <!-- Row 2: 4 Telemetry Metrics & Right Action Buttons -->
                                        <Grid Grid.Row="2" Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- 4 Telemetry Metrics -->
                                            <Grid Grid.Column="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0" CornerRadius="10" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" Padding="12,10" Margin="0,0,8,0">
                                                    <StackPanel>
                                                        <TextBlock Text="{loc:Loc 'Сеть'}" Style="{StaticResource Muted}" FontSize="9.5"/>
                                                        <TextBlock Text="{Binding ActiveNetworkName}" MaxWidth="180" TextTrimming="CharacterEllipsis" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource FgBrush}" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                </Border>

                                                <Border Grid.Column="1" CornerRadius="10" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" Padding="12,10" Margin="0,0,8,0">
                                                    <StackPanel>
                                                        <TextBlock Text="{loc:Loc 'Проверка'}" Style="{StaticResource Muted}" FontSize="9.5"/>
                                                        <TextBlock Text="{Binding NetworkReachabilityText}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource FgBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Border>

                                                <Border Grid.Column="2" CornerRadius="10" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" Padding="12,10" Margin="0,0,8,0">
                                                    <StackPanel>
                                                        <TextBlock Text="{loc:Loc 'Движок'}" Style="{StaticResource Muted}" FontSize="9.5"/>
                                                        <TextBlock Text="{Binding EngineVersion}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource FgBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Border>

                                                <Border Grid.Column="3" CornerRadius="10" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" Padding="12,10">
                                                    <StackPanel>
                                                        <TextBlock Text="{loc:Loc 'Стратегия'}" Style="{StaticResource Muted}" FontSize="9.5"/>
                                                        <TextBlock Text="{Binding ActiveStrategySimpleName}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource FgBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>

                                            <!-- Right action buttons -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                                                <Button Command="{Binding GoToDiagnosticsCommand}" Style="{StaticResource GhostButton}" Height="36" Padding="12,0" Margin="0,0,8,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{StaticResource Icon.Activity}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                        <TextBlock Text="{loc:Loc 'Диагностика'}" FontSize="11"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button Command="{Binding GoToHelpCommand}" Style="{StaticResource GhostButton}" Height="36" Padding="12,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{StaticResource Icon.HelpCircle}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                        <TextBlock Text="{loc:Loc 'Справка'}" FontSize="11"/>
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
</Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                <!-- ===================== Стратегии ===================== -->
                <TabItem Header="{loc:Loc 'Стратегии'}">
                    <Grid Margin="20,10,22,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <WrapPanel x:Name="StrategyActions" Grid.Row="1" VerticalAlignment="Center" Margin="0,10,0,0">
                                <Button Command="{Binding FullVerifyProfilesCommand}"
                                        Style="{StaticResource PrimaryButton}" Height="34" Padding="14,4" Margin="0,0,8,0"
                                        ToolTip="{Binding FullScanTooltip}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource Icon.Search}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding FullScanButtonText}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding RunAutoSelectCommand}"
                                        Style="{StaticResource GhostButton}" Height="34" Padding="14,4" Margin="0,0,8,0"
                                        ToolTip="{Binding AutoSelectPrimaryTooltip}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource Icon.Search}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding AutoSelectPrimaryText}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Click="OnShowStrategyCheck" Style="{StaticResource GhostButton}" Height="34" Padding="10,4" Margin="0,0,8,0"
                                        Visibility="{Binding HasAutoCheckSession, Converter={StaticResource BoolToVis}}" ToolTip="{loc:Loc 'Открыть результаты последней проверки'}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource Icon.Activity}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{loc:Loc 'Результаты'}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding RecheckWorkPoolCommand}"
                                        Style="{StaticResource GhostButton}" Height="34" Width="34" Padding="8" Margin="0,0,8,6"
                                        ToolTip="{loc:Loc 'Быстро перепроверить только WORK-стратегии'}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource Icon.Refresh}" Fill="{StaticResource AccentBrush}"
                                              Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Content="blockcheck2" Command="{Binding Blockcheck2Command}" Style="{StaticResource GhostButton}"
                                        Height="34" Margin="0,0,8,0" Padding="10,4" ToolTip="{loc:Loc 'Проверка DPI upstream blockcheck2'}"/>
                                <Button Style="{StaticResource GhostButton}" Margin="0,0,8,0" Height="34" Padding="10,4"
                                        Command="{Binding ImportArchiveCommand}"
                                        IsEnabled="{Binding IsImportingPresets, Converter={StaticResource InverseBool}}"
                                        Visibility="Collapsed"
                                        ToolTip="{loc:Loc 'Импортировать внешние pre-configs из архивов в пул BROKEN для дальнейшей проверки'}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource Icon.Download}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="{loc:Loc 'Импорт из архива'}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource GhostButton}" VerticalAlignment="Top" Height="34" Width="34" Padding="8" Margin="0,0,0,6"
                                        Command="{Binding OpenLinkCommand}"
                                        CommandParameter="{loc:Loc '#'}"
                                        ToolTip="{loc:Loc 'Открыть раздел «Встроенные стратегии»'}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource Icon.BookOpen}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                            <StackPanel Grid.Row="0" VerticalAlignment="Center">
                                <TextBlock FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="SemiBold" Text="{loc:Loc 'Стратегии'}"/>
                                <WrapPanel Margin="0,6,0,0" VerticalAlignment="Center">
                                    <Border Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="8" Padding="10,4" Margin="0,0,8,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="6" Height="6" CornerRadius="3" Background="{StaticResource AccentBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding ProfilePoolSummary}" FontSize="11.5" FontWeight="Medium" Foreground="{StaticResource FgBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </WrapPanel>
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" MinWidth="240" MaxWidth="390"/>
                                <ColumnDefinition Width="1.6*" MinWidth="240"/>
                            </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource Card}" Padding="8" Margin="0,0,16,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Margin="2,2,2,10">
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
                                    <TextBox x:Name="StrategySearchBox" Text="{Binding StrategySearchText, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="{loc:Loc 'Поиск стратегий'}" AutomationProperties.Name="Поиск стратегий" MinWidth="0" Height="32" Padding="27,5,6,5"/>
                                    <Path Data="{StaticResource Icon.Search}" Fill="{StaticResource FgMutedBrush}" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Left" Margin="8,0,0,0" IsHitTestVisible="False"/>
                                    <ToggleButton Grid.Column="1" IsChecked="{Binding ShowFavoritePresetsOnly}" Style="{StaticResource ChipToggle}"
                                                  Padding="6" ToolTip="{loc:Loc 'Только избранные'}" AutomationProperties.Name="Только избранные">
                                        <Path Data="{StaticResource Icon.Star}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Width="13" Height="13" Stretch="Uniform"/>
                                    </ToggleButton>
                                    <Button Grid.Column="2" Command="{Binding ClearStrategySearchCommand}" Style="{StaticResource GhostButton}" Padding="6"
                                            ToolTip="{loc:Loc 'Сбросить поиск и избранное'}" AutomationProperties.Name="Сбросить поиск и избранное">
                                        <Path Data="{StaticResource Icon.XCircle}" Fill="{StaticResource FgMutedBrush}" Width="13" Height="13" Stretch="Uniform"/>
                                    </Button>
                                </Grid>
                                <UniformGrid Columns="2" VerticalAlignment="Center">
                                    <RadioButton GroupName="PresetFilter" Style="{StaticResource ChipButton}" Margin="0,0,4,4" Padding="6,2" Height="34"
                                                 ToolTip="{Binding PresetsFilterAllText}" IsChecked="{Binding FilterAllChecked, Mode=TwoWay}">
                                        <StackPanel><TextBlock Text="{loc:Loc 'Каталог'}" FontSize="11" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding CanonicalPresetCount}" FontSize="10" HorizontalAlignment="Center"/></StackPanel>
                                    </RadioButton>
                                    <RadioButton GroupName="PresetFilter" Style="{StaticResource ChipButton}" Margin="0,0,4,4" Padding="6,2" Height="34"
                                                 ToolTip="{Binding PresetsFilterWorkText}" IsChecked="{Binding FilterWorkChecked, Mode=TwoWay}">
                                        <StackPanel><TextBlock Text="{loc:Loc 'Рабочие'}" FontSize="11" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding WorkPresetCount}" FontSize="10" HorizontalAlignment="Center"/></StackPanel>
                                    </RadioButton>
                                    <RadioButton GroupName="PresetFilter" Style="{StaticResource ChipButton}" Margin="0,0,4,4" Padding="6,2" Height="34"
                                                 ToolTip="{Binding PresetsFilterBrokenText}" IsChecked="{Binding FilterBrokenChecked, Mode=TwoWay}">
                                        <StackPanel><TextBlock Text="{loc:Loc 'Нерабочие'}" FontSize="11" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding FailedPresetCount}" FontSize="10" HorizontalAlignment="Center"/></StackPanel>
                                    </RadioButton>
                                    <RadioButton GroupName="PresetFilter" Style="{StaticResource ChipButton}" Margin="0,0,4,4" Padding="6,2" Height="34"
                                                 ToolTip="{Binding PresetsFilterUntestedText}" IsChecked="{Binding FilterUntestedChecked, Mode=TwoWay}">
                                        <StackPanel><TextBlock Text="{loc:Loc 'Непроверенные'}" FontSize="11" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding UntestedPresetCount}" FontSize="10" HorizontalAlignment="Center"/></StackPanel>
                                    </RadioButton>
                                </UniformGrid>
                                <RadioButton GroupName="PresetFilter" Style="{StaticResource ChipButton}" Content="{Binding BlockcheckFilterText}" Margin="0,2,4,4"
                                             IsChecked="{Binding FilterBlockcheckChecked, Mode=TwoWay}" Visibility="{Binding HasBlockcheckPresets, Converter={StaticResource BoolToVis}}"/>
                                <TextBlock Text="{Binding VisiblePresetCountText}" Style="{StaticResource Muted}" FontSize="10" Margin="4,3,0,0"/>
                                </StackPanel>

                            <TextBlock Grid.Row="1" Text="{Binding EmptyPresetListHint}" TextWrapping="Wrap" Margin="12,20"
                                       Style="{StaticResource Muted}" VerticalAlignment="Center" HorizontalAlignment="Center"
                                       Visibility="{Binding HasVisiblePresets, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"/>
                            <ListBox x:Name="StrategiesList" Grid.Row="1" ItemsSource="{Binding PresetsView}" SelectedItem="{Binding SelectedPreset}"
                                     Visibility="{Binding HasVisiblePresets, Converter={StaticResource BoolToVis}}"
                                     ItemContainerStyle="{StaticResource SelectableItem}"
                                     VirtualizingPanel.IsVirtualizing="False"
                                     ScrollViewer.CanContentScroll="False"
                                     MouseDoubleClick="StrategiesList_MouseDoubleClick">
                                <ListBox.GroupStyle>
                                    <GroupStyle>
                                        <GroupStyle.HeaderTemplate>
                                            <DataTemplate>
                                                <Border Margin="2,12,2,6" Padding="0,0,0,8"
                                                        BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,0,0,1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Width="3" Height="13" CornerRadius="2" Margin="0,0,8,0"
                                                                Background="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="11" FontWeight="Bold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"
                                                                   Foreground="{StaticResource FgMutedBrush}" VerticalAlignment="Center"/>
                                                        <Border Grid.Column="2" CornerRadius="8" Background="{StaticResource AccentSoftBrush}"
                                                                Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding ItemCount}" FontSize="10" FontWeight="Bold"
                                                                       FontFamily="{StaticResource MonoFont}"
                                                                       Foreground="{StaticResource AccentBrush}"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </GroupStyle.HeaderTemplate>
                                    </GroupStyle>
                                </ListBox.GroupStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <!-- ToolTip carries the full name so long names (e.g. ALT10 vs ALT11)
                                             stay distinguishable even when the row trims them with an ellipsis. -->
                                        <StackPanel ToolTip="{Binding NameDisplay}">
                                            <Grid>
                                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- marks the recommended strategy -->
                                                <Path Grid.Column="0" Data="{StaticResource Icon.Star}" Fill="{StaticResource AccentBrush}"
                                                      Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"
                                                      Visibility="{Binding IsRecommended, Converter={StaticResource BoolToVis}}"/>
                                                <TextBlock Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding PrimaryLabel}" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="{Binding SecondaryLabel}" Style="{StaticResource Muted}"
                                                           FontSize="11.5" TextTrimming="CharacterEllipsis"/>
                                                <WrapPanel Grid.Row="2" Grid.ColumnSpan="3" VerticalAlignment="Center" Margin="0,4,0,0">
                                                    <!-- Test State Indicator: Green dot for WORK, Red dot for Failed, Gray dot for Untested -->
                                                    <Border CornerRadius="6" Padding="6,2" VerticalAlignment="Center" Margin="0,0,5,0"
                                                            ToolTip="{Binding PoolStatusHint}">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{StaticResource NeutralSoftBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsVerifiedForDisplayScope}" Value="True">
                                                                        <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                                                        <Setter Property="Background" Value="{StaticResource DangerSoftBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Ellipse Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,5,0">
                                                                <Ellipse.Style>
                                                                    <Style TargetType="Ellipse">
                                                                        <Setter Property="Fill" Value="{StaticResource NeutralBrush}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsVerifiedForDisplayScope}" Value="True">
                                                                                <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                                                                <Setter Property="Fill" Value="{StaticResource DangerBrush}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Ellipse.Style>
                                                            </Ellipse>
                                                            <TextBlock Text="{Binding ScopeStatusLabel}" FontSize="9.5" FontWeight="SemiBold">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{StaticResource FgMutedBrush}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsVerifiedForDisplayScope}" Value="True">
                                                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                                                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Border>
                                                    <!-- "ВКЛЮЧЕНА" badge when active in engine -->
                                                    <Border CornerRadius="6" Padding="6,2"
                                                            Background="{StaticResource AccentSoftBrush}" VerticalAlignment="Center">
                                                        <Border.Visibility>
                                                            <MultiBinding Converter="{StaticResource RefEqualsToVis}">
                                                                <Binding Path="."/>
                                                                <Binding Path="DataContext.RunningPreset"
                                                                         RelativeSource="{RelativeSource AncestorType=ListBox}"/>
                                                            </MultiBinding>
                                                        </Border.Visibility>
                                                        <TextBlock Text="{loc:Loc 'ВКЛЮЧЕНА'}" FontSize="9.5" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource AccentBrush}"/>
                                                    </Border>
                                                </WrapPanel>
                                            </Grid>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Button Grid.Row="2" Command="{Binding OpenHowItWorksCommand}"
                                    Style="{StaticResource GhostButton}" Margin="4,8,4,4" HorizontalAlignment="Stretch">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Path Data="{StaticResource Icon.HelpCircle}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="{loc:Loc 'Как это работает'}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource Card}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <DockPanel Grid.Row="0">
                                    <Button DockPanel.Dock="Right" Command="{Binding ToggleFavoritePresetCommand}" CommandParameter="{Binding SelectedPreset}"
                                            Style="{StaticResource GhostButton}" Padding="8" Margin="8,0,0,0" Width="34" Height="34"
                                            Visibility="{Binding SelectedPreset.IsReferenceStrategy, Converter={StaticResource BoolToVis}}"
                                            ToolTip="{loc:Loc 'Добавить или убрать из избранного'}" AutomationProperties.Name="Избранная стратегия">
                                        <Path Data="{StaticResource Icon.Star}" Width="16" Height="16" Stretch="Uniform">
                                            <Path.Style><Style TargetType="Path"><Setter Property="Fill" Value="{StaticResource FgMutedBrush}"/>
                                                <Style.Triggers><DataTrigger Binding="{Binding SelectedPreset.IsFavorite}" Value="True"><Setter Property="Fill" Value="{StaticResource AccentBrush}"/></DataTrigger></Style.Triggers>
                                            </Style></Path.Style>
                                        </Path>
                                    </Button>
                                    <TextBlock Text="{Binding SelectedPresetOrHint}" Style="{StaticResource H2}" TextWrapping="Wrap"/>
                                </DockPanel>

                                <!-- Row 1: friendly tagline + «рекомендуемая» badge -->
                                <WrapPanel Grid.Row="1" Margin="0,7,0,0">
                                    <Border CornerRadius="8" Background="{StaticResource AccentSoftBrush}" Padding="8,2" Margin="0,0,8,0"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding SelectedPreset.IsRecommended, Converter={StaticResource BoolToVis}}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource Icon.Star}" Fill="{StaticResource AccentBrush}" Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <TextBlock Text="{loc:Loc 'Рекомендуемая'}" FontSize="11" FontWeight="Bold"
                                                       Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="{Binding SelectedPreset.TaglineDisplay}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"
                                               Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"
                                               Visibility="{Binding SelectedPreset.HasTagline, Converter={StaticResource BoolToVis}}"/>
                                </WrapPanel>

                                <!-- Row 2 holds EITHER the readable description (default) OR the raw-args editor. -->
                                <Grid Grid.Row="2" Margin="0,10,0,0">
                                    <ScrollViewer Visibility="{Binding ShowPresetArgs, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"
                                                  VerticalScrollBarVisibility="Auto">
                                        <StackPanel>
                                            <TextBlock Text="{Binding SelectedPreset.DescriptionDisplay}" TextWrapping="Wrap"
                                                       FontSize="13.5" LineHeight="20" Foreground="{StaticResource FgBrush}"/>
                                            <Expander Header="{loc:Loc 'Результаты HTTPS-проверки'}" Margin="0,12,0,0">
                                                <StackPanel Margin="0,8,0,0">
                                                    <TextBlock Text="{Binding SelectedPreset.LastTestedDisplay}" Style="{StaticResource Muted}"/>
                                                    <TextBlock Text="{Binding SelectedPreset.TestedTargetsDisplay}" FontFamily="{StaticResource MonoFont}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                                </StackPanel>
                                            </Expander>
                                            <Border CornerRadius="10" Padding="14,12" Margin="0,16,0,0"
                                                    Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1">
                                                <StackPanel>
                                                    <TextBlock Text="{loc:Loc 'Не заработало?'}" FontWeight="SemiBold"/>
                                                    <TextBlock Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                                                               Text="{loc:Loc 'Стратегии зависят от провайдера. Если этот пресет не пробивает — попробуйте другие из списка. Если ничего не заходит — вкладка «Диагностика» → «Подобрать лучшую» подберёт рабочую стратегию под вашего оператора.'}"/>
                                                    <WrapPanel Margin="0,10,0,0">
                                                        <Button Command="{Binding OpenHowItWorksCommand}"
                                                                Style="{StaticResource GhostButton}" Margin="0,0,8,0">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Path Data="{StaticResource Icon.HelpCircle}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                                <TextBlock Text="{loc:Loc 'Как это работает'}" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Button>
                                                        <Button Command="{Binding OpenLinkCommand}"
                                                                CommandParameter="{loc:Loc '#'}"
                                                                Style="{StaticResource GhostButton}"
                                                                ToolTip="{loc:Loc 'Открыть раздел «Решение проблем и коды ошибок» в инструкции'}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Path Data="{StaticResource Icon.BookOpen}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                                <TextBlock Text="{loc:Loc 'Инструкция'}" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Button>
                                                    </WrapPanel>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </ScrollViewer>
                                    <!-- Opt-in: in-app args editor, styled as a terminal -->
                                    <Border Visibility="{Binding ShowPresetArgs, Converter={StaticResource BoolToVis}}"
                                            Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="10"
                                            BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" ClipToBounds="True">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <!-- terminal title bar -->
                                            <Border Grid.Row="0" Background="{StaticResource SurfaceElevatedBrush}" Padding="12,9"
                                                    BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,0,0,1">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="9" Height="9" Fill="{StaticResource DangerBrush}" Margin="0,0,6,0"/>
                                                    <Ellipse Width="9" Height="9" Fill="{StaticResource WarnBrush}" Margin="0,0,6,0"/>
                                                    <Ellipse Width="9" Height="9" Fill="{StaticResource SuccessBrush}" Margin="0,0,10,0"/>
                                                    <TextBlock Text="{loc:Loc 'аргументы winws2 (по одному в строке)'}"
                                                               FontFamily="{StaticResource MonoFont}" FontSize="11"
                                                               Foreground="{StaticResource Muted2Brush}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <TextBox Grid.Row="1" Text="{Binding PresetArgsText, UpdateSourceTrigger=PropertyChanged}"
                                                     IsReadOnly="{Binding SelectedPresetEditable, Converter={StaticResource InverseBool}}"
                                                     AcceptsReturn="True" TextWrapping="NoWrap" Background="Transparent" BorderThickness="0"
                                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                                     FontFamily="{StaticResource MonoFont}" FontSize="12"/>
                                            <!-- fully-expanded command that will actually run -->
                                            <StackPanel Grid.Row="2" Margin="12,8,12,12">
                                                <TextBlock Text="{loc:Loc 'ЗАПУСК'}" Style="{StaticResource Muted}" FontSize="10"/>
                                                <TextBlock Text="{Binding CommandPreview}" FontFamily="{StaticResource MonoFont}"
                                                           FontSize="11.5" Foreground="{StaticResource FgMutedBrush}"
                                                           TextWrapping="Wrap" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <StackPanel Grid.Row="3" Margin="0,14,0,0">
                                    <!-- Apply-strategy banner: a strategy change needs an engine restart,
                                         so the user confirms it explicitly here. -->
                                    <Border CornerRadius="10" Padding="12,10" Margin="0,0,0,12"
                                            Background="{StaticResource SuccessSoftBrush}" BorderBrush="{StaticResource SuccessBrush}" BorderThickness="1"
                                            Visibility="{Binding IsStrategyChangePending, Converter={StaticResource BoolToVis}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <TextBlock Text="{loc:Loc 'Выбрана другая стратегия'}" FontWeight="SemiBold" FontSize="12.5"/>
                                                <TextBlock Style="{StaticResource Muted}" FontSize="11.5" TextWrapping="Wrap"
                                                           Text="{Binding RunningPresetLine}"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="{loc:Loc 'Сменить стратегию'}"
                                                    Command="{Binding ApplyStrategyCommand}"
                                                    Style="{StaticResource PrimaryButton}" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <!-- Live strategy test result banner -->
                                    <Border CornerRadius="8" Padding="12,8" Margin="0,0,0,10"
                                            BorderThickness="1"
                                            Visibility="{Binding HasSelectedPresetTestStatus, Converter={StaticResource BoolToVis}}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedPresetTestVerdict}" Value="Ok">
                                                        <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}"/>
                                                        <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedPresetTestVerdict}" Value="Fail">
                                                        <Setter Property="Background" Value="{StaticResource DangerSoftBrush}"/>
                                                        <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedPresetTestVerdict}" Value="Timeout">
                                                        <Setter Property="Background" Value="{StaticResource WarnSoftBrush}"/>
                                                        <Setter Property="BorderBrush" Value="{StaticResource WarnBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedPresetTestVerdict}" Value="Pending">
                                                        <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Grid.Column="0" Width="8" Height="8" VerticalAlignment="Top" Margin="0,3,10,0"
                                                     Fill="{Binding SelectedPresetTestVerdict, Converter={StaticResource StateToBrush}}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding SelectedPresetTestStatus}" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{StaticResource FgBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                        </Grid>
                                    </Border>

                                    <WrapPanel>
                                        <Button Command="{Binding ApplyStrategyCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,10,6"
                                                Visibility="{Binding IsSelectedPresetRunning, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource Icon.Play}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                      Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBlock Text="{Binding ActivatePresetButtonText}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding StopCommand}" Style="{StaticResource DangerButton}" Margin="0,0,10,6"
                                                Visibility="{Binding IsSelectedPresetRunning, Converter={StaticResource BoolToVis}}">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource Icon.Stop}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                      Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBlock Text="{loc:Loc 'Остановить обход'}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding TestSelectedPresetCommand}"
                                                Style="{StaticResource SecondaryButton}" Margin="0,0,8,6"
                                                ToolTip="{loc:Loc 'Проверить пинг и доступность Discord и YouTube для этой стратегии'}">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource Icon.Activity}" Fill="{StaticResource AccentBrush}"
                                                      Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBlock Text="{Binding TestPresetButtonText}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding TogglePresetArgsCommand}"
                                                Style="{StaticResource SecondaryButton}" Margin="0,0,8,6">
                                            <TextBlock>
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="{loc:Loc 'Аргументы движка'}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ShowPresetArgs}" Value="True">
                                                                <Setter Property="Text" Value="{loc:Loc 'Скрыть аргументы'}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Button>
                                        <Button Content="{loc:Loc 'Дублировать'}" Command="{Binding DuplicatePresetCommand}"
                                                Style="{StaticResource GhostButton}" Margin="0,0,8,6"
                                                Visibility="Collapsed"/>
                                        <Button Content="{loc:Loc 'Сохранить'}" Command="{Binding SavePresetCommand}"
                                                Style="{StaticResource SecondaryButton}" Margin="0,0,8,6"
                                                Visibility="Collapsed"/>
                                        <Button Content="{loc:Loc 'Удалить'}" Command="{Binding DeletePresetCommand}"
                                                Style="{StaticResource DangerButton}" Margin="0,0,8,6"
                                                Visibility="Collapsed"/>
                                        <TextBlock Text="{Binding CatalogDescription}"
                                                   Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="8,0,0,6"
                                                   />
                                    </WrapPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- Хостлисты -->
                <TabItem Header="{loc:Loc 'Хостлисты'}">
                    <Grid Margin="20,10,22,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="0,0,0,14">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource PrimaryButton}" Margin="0,0,10,0"
                                        Command="{Binding UpdateAllListsCommand}"
                                        IsEnabled="{Binding IsBuildingIpset, Converter={StaticResource InverseBool}}"
                                        ToolTip="{loc:Loc '60 секунд живого захвата выбранных приложений, затем парсинг и обновление баз без дублей'}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource Icon.Refresh}" Fill="White" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                        <TextBlock Text="{Binding UpdateListsButtonText}" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource GhostButton}" VerticalAlignment="Center"
                                        Command="{Binding OpenLinkCommand}"
                                        CommandParameter="{loc:Loc '#'}"
                                        ToolTip="{loc:Loc 'Открыть раздел «Хостлисты, свои цели и обход по IP» в инструкции'}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource Icon.BookOpen}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="{loc:Loc 'Инструкция'}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="SemiBold" Text="{loc:Loc 'Хостлисты'}"/>
                                <TextBlock Style="{StaticResource Muted}" Margin="0,3,0,0" FontSize="12" TextWrapping="Wrap"
                                           Text="{loc:Loc 'Списки доменов, к которым применяется обход. Один домен — одна строка.'}"/>
                            </StackPanel>
                        </DockPanel>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0.8*" MinWidth="200" MaxWidth="280"/>
                                <ColumnDefinition Width="1.8*" MinWidth="320"/>
                            </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource Card}" Padding="8" Margin="0,0,16,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <ListBox Grid.Row="0" ItemsSource="{Binding Hostlists}"
                                         SelectedItem="{Binding SelectedHostlist}"
                                         ItemContainerStyle="{StaticResource SelectableItem}"
                                         VirtualizingPanel.IsVirtualizing="True"
                                         VirtualizingPanel.VirtualizationMode="Recycling"
                                         ScrollViewer.CanContentScroll="True">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="28" Height="28" CornerRadius="8" VerticalAlignment="Center"
                                                        Background="{StaticResource AccentSoftBrush}"
                                                        BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1">
                                                    <Path Data="{StaticResource Icon.FileText}" Fill="{StaticResource AccentBrush}" Width="13" Height="13"
                                                          Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="{Binding}" FontFamily="{StaticResource MonoFont}"
                                                           FontSize="13" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <Button Grid.Row="1" Content="{loc:Loc '+ Новый список'}" Command="{Binding NewHostlistCommand}"
                                         Style="{StaticResource GhostButton}" Margin="4,8,4,4"/>
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource Card}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="{Binding SelectedHostlistOrHint}"
                                           FontFamily="{StaticResource MonoFont}" FontSize="16" FontWeight="Bold"/>

                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,12">
                                    <TextBox Width="300" Text="{Binding NewDomain, UpdateSourceTrigger=PropertyChanged}"/>
                                    <Button Content="{loc:Loc 'Добавить домен'}" Command="{Binding AddDomainCommand}"
                                            Style="{StaticResource GhostButton}" Margin="8,0,0,0"/>
                                </StackPanel>

                                <TextBox Grid.Row="2" Text="{Binding HostlistContent, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True" TextWrapping="NoWrap" Background="{StaticResource BgBrush}"
                                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                         FontFamily="{StaticResource MonoFont}" FontSize="12.5"/>

                                <Grid Grid.Row="3" Margin="0,14,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Actions & Stage badge -->
                                    <DockPanel Grid.Row="0" LastChildFill="False">
                                        <WrapPanel DockPanel.Dock="Left">
                                            <Button Content="{loc:Loc 'Сохранить список'}" Command="{Binding SaveHostlistCommand}"
                                                    Style="{StaticResource PrimaryButton}" Margin="0,0,8,4"/>
                                            <Button Content="{loc:Loc 'Удалить список'}" Command="{Binding DeleteHostlistCommand}"
                                                    Style="{StaticResource GhostButton}" Margin="0,0,8,4"/>
                                            <Button Content="{Binding StopListsButtonText}" Command="{Binding StopListUpdateCommand}"
                                                    Style="{StaticResource GhostButton}" Margin="0,0,8,4"
                                                    Visibility="{Binding IsBuildingIpset, Converter={StaticResource BoolToVis}}"/>
                                        </WrapPanel>

                                        <!-- Live progress stage badge -->
                                        <Border DockPanel.Dock="Right" Background="{StaticResource AccentSoftBrush}" CornerRadius="6"
                                                BorderBrush="{StaticResource AccentBrush}" BorderThickness="1"
                                                Padding="10,4" VerticalAlignment="Center"
                                                Visibility="{Binding IsBuildingIpset, Converter={StaticResource BoolToVis}}">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource Icon.Refresh}" Fill="{StaticResource AccentBrush}" Width="12" Height="12"
                                                      Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                                <TextBlock Text="{Binding IpsetProgressStage}" Foreground="{StaticResource AccentBrush}"
                                                           FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </DockPanel>

                                    <!-- Status & Progress card -->
                                    <Border Grid.Row="1" Margin="0,10,0,0" Background="{StaticResource SurfaceAltBrush}"
                                            BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                                            CornerRadius="8" Padding="12,10">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Progress bar and percentage -->
                                            <Grid Grid.Row="0" Margin="0,0,0,8"
                                                  Visibility="{Binding IsBuildingIpset, Converter={StaticResource BoolToVis}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ProgressBar Grid.Column="0" Value="{Binding IpsetProgressValue, Mode=OneWay}" Minimum="0" Maximum="100"
                                                             Height="6" Style="{StaticResource ModernProgressBar}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding IpsetProgressValue, StringFormat='{}{0:0}%'}"
                                                           FontFamily="{StaticResource MonoFont}" FontSize="11.5" FontWeight="Bold"
                                                           Foreground="{StaticResource AccentBrush}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                            </Grid>

                                            <!-- Full multiline wrapped status text -->
                                            <DockPanel Grid.Row="1">
                                                <Path DockPanel.Dock="Left" Data="{StaticResource Icon.Info}" Fill="{StaticResource FgMutedBrush}"
                                                      Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Top" Margin="0,2,8,0"/>
                                                <TextBlock Text="{Binding IpsetStatus}" Foreground="{StaticResource FgMutedBrush}"
                                                           FontSize="12" LineHeight="17" TextWrapping="Wrap"/>
                                            </DockPanel>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- Диагностика: автоподбор/генератор + матрица -->
                <TabItem Header="{loc:Loc 'Диагностика'}">
                    <Grid Margin="20,10,22,14">
                        <Grid.Resources>
                            <CollectionViewSource x:Key="GroupedDiag" Source="{Binding DiagRows}">
                                <CollectionViewSource.GroupDescriptions>
                                    <PropertyGroupDescription PropertyName="Group"/>
                                </CollectionViewSource.GroupDescriptions>
                            </CollectionViewSource>
                        </Grid.Resources>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="415" MinWidth="380" MaxWidth="460"/>
                            <ColumnDefinition Width="1*" MinWidth="420"/>
                        </Grid.ColumnDefinitions>

                        <!-- LEFT: подбор / цели / генерация — scrolls as a whole, scales with window -->
                        <ScrollViewer Grid.Column="0" Margin="0,0,16,0" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>

                            <!-- Card: auto-select + generate + scope + results -->
                            <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" VerticalAlignment="Center"
                                            Command="{Binding OpenLinkCommand}"
                                            CommandParameter="{loc:Loc '#'}"
                                            ToolTip="{loc:Loc 'Открыть раздел «Автоподбор и генерация» в инструкции'}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource Icon.BookOpen}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="{loc:Loc 'Инструкция'}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <TextBlock FontFamily="{StaticResource DisplayFont}" FontSize="16.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" Text="{loc:Loc 'Проверка и авто-подбор'}"/>
                                </DockPanel>
                                <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap"
                                           Text="{loc:Loc '«Подобрать лучшую» ищет рабочую стратегию по выбранной цели, «Диагностика» — показывает текущую доступность.'}"/>

                                <!-- Scope -->
                                <StackPanel Margin="0,14,0,0">
                                    <TextBlock Text="{loc:Loc 'ЦЕЛЬ ПОДБОРА'}" Style="{StaticResource Muted}" FontSize="11"
                                               Margin="0,0,0,6"/>
                                    <Border CornerRadius="8" Background="{StaticResource SurfaceAltBrush}"
                                            BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" Padding="3">
                                        <WrapPanel>
                                            <RadioButton Style="{StaticResource ModeSegment}" IsChecked="{Binding ScopeBoth, Mode=TwoWay}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="{StaticResource Icon.Discord}" Fill="{StaticResource Brand.Discord}" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center"/>
                                                    <Path Data="{StaticResource Icon.YouTube}" Fill="{StaticResource Brand.YouTube}" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                                    <TextBlock Text="DC + YT" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                                </StackPanel>
                                            </RadioButton>
                                            <RadioButton Style="{StaticResource ModeSegment}" IsChecked="{Binding ScopeDiscord, Mode=TwoWay}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="{StaticResource Icon.Discord}" Fill="{StaticResource Brand.Discord}" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Discord" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                                </StackPanel>
                                            </RadioButton>
                                            <RadioButton Style="{StaticResource ModeSegment}" IsChecked="{Binding ScopeYouTube, Mode=TwoWay}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="{StaticResource Icon.YouTube}" Fill="{StaticResource Brand.YouTube}" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center"/>
                                                    <TextBlock Text="YouTube" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                                </StackPanel>
                                            </RadioButton>
                                        </WrapPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Actions (wrap — compact, flows to the left column width) -->
                                <WrapPanel Margin="0,14,0,0">
                                    <Button Content="{Binding FullScanButtonText}" Command="{Binding FullVerifyProfilesCommand}"
                                            Style="{StaticResource PrimaryButton}" Margin="0,0,8,8"
                                            ToolTip="{Binding FullScanTooltip}"
                                            Visibility="{Binding IsAutoSelecting, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"/>
                                    <Button Content="blockcheck2" Command="{Binding Blockcheck2Command}"
                                            Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"
                                            ToolTip="{loc:Loc 'Запустить upstream blockcheck2 на выбранных целях.'}"
                                            Visibility="{Binding IsAutoSelecting, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"/>
                                    <Button Content="{loc:Loc 'Остановить скан'}" Command="{Binding StopAutoSelectCommand}"
                                            Style="{StaticResource DangerButton}" Margin="0,0,8,8"
                                            Visibility="{Binding IsAutoSelecting, Converter={StaticResource BoolToVis}}"/>
                                    <Button Command="{Binding RecheckWorkPoolCommand}"
                                            Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"
                                            ToolTip="{loc:Loc 'Быстро перепроверить только стратегии, находящиеся в пуле WORK.'}"
                                            Visibility="{Binding IsAutoSelecting, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource Icon.Refresh}" Fill="{StaticResource AccentBrush}" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="{loc:Loc 'WORK-пул'}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Content="{loc:Loc 'Автоподбор'}" Command="{Binding RunAutoSelectCommand}"
                                            Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"
                                            ToolTip="{loc:Loc 'Выбрать лучшую готовую стратегию из пула WORK.'}"
                                            Visibility="{Binding IsAutoSelecting, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"/>
                                    <Button Content="{loc:Loc 'Диагностика'}" Command="{Binding RunDiagnosticsCommand}"
                                            Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"
                                            Visibility="{Binding IsDiagnosing, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"/>
                                    <Button Content="{loc:Loc 'Остановить'}" Command="{Binding StopDiagnosticsCommand}"
                                            Style="{StaticResource DangerButton}" Margin="0,0,8,8"
                                            Visibility="{Binding IsDiagnosing, Converter={StaticResource BoolToVis}}"/>
                                    <Button Content="{loc:Loc 'Проверка DPI'}" Command="{Binding RunDpiCheckCommand}"
                                            Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"
                                            ToolTip="{loc:Loc 'Определяет, режет ли провайдер по имени сайта (обрыв/RST или заморозка) и душит ли соединение по объёму/пакетам (TCP 16-20) — а не просто «сайт недоступен». Точнее всего с ВЫКЛЮЧЕННЫМ обходом.'}"
                                            Visibility="{Binding IsDpiChecking, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"/>
                                    <Button Content="{loc:Loc 'Остановить'}" Command="{Binding StopDpiCheckCommand}"
                                            Style="{StaticResource DangerButton}" Margin="0,0,8,8"
                                            Visibility="{Binding IsDpiChecking, Converter={StaticResource BoolToVis}}"/>
                                </WrapPanel>

                                <TextBlock Text="{Binding AutoStatusText}" Style="{StaticResource Muted}"
                                           Margin="0,12,0,0" TextWrapping="Wrap"/>

                                <Border Background="{StaticResource WarnSoftBrush}" BorderBrush="{StaticResource WarnBrush}" BorderThickness="1" CornerRadius="8" Padding="10,7" Margin="0,12,0,0">
                                    <TextBlock Text="{Binding DiagEngineNote}" TextWrapping="Wrap"
                                               FontSize="11.5" Foreground="{StaticResource WarnBrush}"/>
                                </Border>

                                <Grid Margin="0,12,0,0">
                                    <TextBlock Text="{Binding DiagStatusText}" Style="{StaticResource Muted}"
                                               HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding DiagSummary}" FontWeight="SemiBold" FontSize="12.5"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Live progress bar during Diagnostics scan -->
                                <StackPanel Margin="0,8,0,0" Visibility="{Binding IsDiagnosing, Converter={StaticResource BoolToVis}}">
                                    <ProgressBar Value="{Binding DiagProgress, Mode=OneWay}" Minimum="0" Maximum="100" Height="6" Style="{StaticResource ModernProgressBar}"/>
                                    <TextBlock Text="{Binding DiagProgressText}" FontSize="11" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource AccentBrush}" Margin="0,4,0,0"/>
                                </StackPanel>

                                <!-- DPI-signature verdict (обрыв/RST · заморозка · чисто · нет соединения) -->
                                <Border CornerRadius="12" Background="{StaticResource SurfaceAltBrush}"
                                        BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                                        Padding="12,10" Margin="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="{Binding DpiVerdictText}" TextWrapping="Wrap"
                                                   FontWeight="SemiBold" FontSize="12.5"
                                                   Foreground="{Binding DpiVerdictStatus, Converter={StaticResource DiagBrush}}"/>
                                        <TextBlock Text="{Binding DpiVerdictDetail}" TextWrapping="Wrap"
                                                   FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                                                   Foreground="{StaticResource FgMutedBrush}" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            </Border>

                            <!-- Свои цели (custom bypass targets) -->
                            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                                <StackPanel>
                                    <TextBlock Text="{loc:Loc 'Свои цели'}" Style="{StaticResource H2}"/>
                                    <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap"
                                               Text="{loc:Loc 'Добавьте свой сайт — приложение найдёт его поддомены и домены того же бренда на других зонах (yandex.ru → yandex.kz/md…), будет проверять их в диагностике, учитывать при подборе и генерации и применять к ним обход.'}"/>

                                    <ItemsControl ItemsSource="{Binding CustomTargets}" Margin="0,12,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="12" Background="{StaticResource SurfaceAltBrush}"
                                                        BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                                                        Padding="12,9" Margin="0,0,0,6">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                                       FontFamily="{StaticResource MonoFont}" FontSize="13"/>
                                                            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Muted}" FontSize="11"/>
                                                        </StackPanel>
                                                        <Button Grid.Column="1" Content="{loc:Loc 'Открыть'}" Style="{StaticResource GhostButton}"
                                                                Padding="10,5" FontSize="12" VerticalAlignment="Center"
                                                                Command="{Binding DataContext.OpenTargetCommand,
                                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}"/>
                                                        <Button Grid.Column="2" Content="✕" Style="{StaticResource GhostButton}"
                                                                Padding="9,5" FontSize="12" MinWidth="0" Margin="6,0,0,0" VerticalAlignment="Center"
                                                                Command="{Binding DataContext.DeleteTargetCommand,
                                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock FontSize="11.5" Margin="0,2,0,8" Text="{loc:Loc 'Целей пока нет.'}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource FgMutedBrush}"/>
                                                <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
                                                <Setter Property="TextWrapping" Value="Wrap"/>
                                                <Setter Property="LineHeight" Value="18"/>
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CustomTargets.Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <Button Content="{loc:Loc '+ Добавить цель'}" Command="{Binding AddTargetCommand}"
                                            Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- RIGHT: матрица сервисов (тянется по ширине окна) -->
                        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <!-- Column headers -->
                                <Grid Grid.Row="0" Margin="14,8,14,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="70"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{loc:Loc 'СЕРВИС / ТОЧКА'}" Style="{StaticResource Muted}" FontSize="11"/>
                                    <TextBlock Grid.Column="1" Text="HTTP" Style="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="TLS 1.2" Style="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="TLS 1.3" Style="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="4" Text="{loc:Loc 'ПИНГ'}" Style="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Center"/>
                                </Grid>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding Source={StaticResource GroupedDiag}}">
                                    <ItemsControl.GroupStyle>
                                        <GroupStyle>
                                            <GroupStyle.HeaderTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12.5"
                                                               Foreground="{StaticResource AccentBrush}" Margin="10,12,0,4"/>
                                                </DataTemplate>
                                            </GroupStyle.HeaderTemplate>
                                        </GroupStyle>
                                    </ItemsControl.GroupStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="14,7" Margin="0,1" CornerRadius="8" Background="{StaticResource SurfaceAltBrush}"
                                                    Opacity="0">
                                                <Border.Triggers>
                                                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                    From="0" To="1" Duration="0:0:0.3"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>
                                                </Border.Triggers>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="80"/>
                                                        <ColumnDefinition Width="80"/>
                                                        <ColumnDefinition Width="80"/>
                                                        <ColumnDefinition Width="70"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding Host}" Style="{StaticResource Muted}" FontSize="10.5"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding Http, Converter={StaticResource DiagText}}"
                                                               Foreground="{Binding Http, Converter={StaticResource DiagBrush}}"
                                                               FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Tls12, Converter={StaticResource DiagText}}"
                                                               Foreground="{Binding Tls12, Converter={StaticResource DiagBrush}}"
                                                               FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding Tls13, Converter={StaticResource DiagText}}"
                                                               Foreground="{Binding Tls13, Converter={StaticResource DiagBrush}}"
                                                               FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="4" Text="{Binding PingText}"
                                                               Foreground="{Binding Ping, Converter={StaticResource DiagBrush}}"
                                                               FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- Логи -->
                <TabItem Header="{loc:Loc 'Журнал'}">
                    <Grid Margin="20,10,22,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="0,0,0,14">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="{loc:Loc 'Копировать'}" Command="{Binding CopyLogCommand}"
                                        Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                                <Button Content="{loc:Loc 'Очистить'}" Command="{Binding ClearLogCommand}"
                                        Style="{StaticResource GhostButton}" Margin="0,0,8,0"/>
                                <Button Style="{StaticResource GhostButton}" VerticalAlignment="Center"
                                        ToolTip="{loc:Loc 'Открыть раздел «Решение проблем и коды ошибок» в инструкции'}"
                                        Command="{Binding OpenLinkCommand}"
                                        CommandParameter="{loc:Loc '#'}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource Icon.BookOpen}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="{loc:Loc 'Инструкция'}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" Text="{loc:Loc 'Журнал'}"/>
                                <ToggleButton Style="{StaticResource ChipToggle}"
                                              Margin="14,0,0,0" VerticalAlignment="Center"
                                              IsChecked="{Binding DebugLog}"
                                              ToolTip="{loc:Loc 'Подробный лог движка: winws2 пишет, к каким соединениям применились приёмы и почему. Включение перезапускает обход.'}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,5,0">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{StaticResource NeutralBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DebugLog}" Value="True">
                                                            <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="DEBUG: " FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <TextBlock FontSize="11" FontWeight="Bold" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="ВЫКЛ"/>
                                                    <Setter Property="Foreground" Value="{StaticResource FgMutedBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DebugLog}" Value="True">
                                                            <Setter Property="Text" Value="ВКЛ"/>
                                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </ToggleButton>
                            </StackPanel>
                        </DockPanel>

                        <!-- winws2 engine journal -->
                        <Grid Grid.Row="1">
                            <Border Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="14" Padding="12"
                                    BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1">
                                <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <DockPanel Margin="0,0,0,10">
                                    <CheckBox DockPanel.Dock="Right" IsChecked="{Binding FollowLog}" Content="{loc:Loc 'Следить за журналом'}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    <TextBox Text="{Binding LogSearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="{loc:Loc 'Поиск в журнале'}" AutomationProperties.Name="Поиск в журнале"/>
                                </DockPanel>
                                <ListBox x:Name="LogList" Grid.Row="1" ItemsSource="{Binding LogView}" PreviewMouseWheel="OnLogMouseWheel"
                                         VirtualizingPanel.IsVirtualizing="True"
                                         VirtualizingPanel.VirtualizationMode="Recycling"
                                         ScrollViewer.CanContentScroll="True"
                                         Style="{StaticResource LogListBox}"/>
                                <TextBlock Grid.Row="1" Text="{Binding EmptyJournalText}" Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{Binding HasVisibleLogLines, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- ===================== Патчер Antigravity ===================== -->
                <TabItem Header="{loc:Loc 'Antigravity'}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="20,10,22,18">
                            <TextBlock Text="Antigravity" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,12"/>
                            <WrapPanel x:Name="PatcherActions" Margin="0,0,0,10">
                                <Button Content="{loc:Loc 'Проверить файлы'}" Command="{Binding CheckPatcherStatusCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"/>
                                <Button Content="{loc:Loc 'Применить доступные патчи'}" Command="{Binding PatchAllComponentsCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8" ToolTip="{Binding PatcherPatchAllReason}" ToolTipService.ShowOnDisabled="True"/>
                                <Button Content="{loc:Loc 'Восстановить исходные файлы'}" Command="{Binding RestoreAllComponentsCommand}" Style="{StaticResource GhostButton}" Margin="0,0,8,8" ToolTip="{Binding PatcherRestoreAllReason}" ToolTipService.ShowOnDisabled="True"/>
                                <Button Content="{loc:Loc 'Запустить Antigravity'}" Command="{Binding LaunchAntigravityCommand}" Style="{StaticResource GhostButton}" Margin="0,0,8,8" ToolTip="{Binding PatcherLaunchReason}" ToolTipService.ShowOnDisabled="True"/>
                                <Button Command="{Binding RestartAntigravityCommand}" Style="{StaticResource GhostButton}" Margin="0,0,8,8" Width="34" Height="32" Padding="0" ToolTip="{Binding PatcherLaunchReason, StringFormat='Перезапустить выбранную установку: {0}'}" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="Перезапустить Antigravity">
                                    <Path Data="{StaticResource Icon.Refresh}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="14" Height="14" Stretch="Uniform"/>
                                </Button>
                                <Button Command="{Binding TerminateAntigravityProcessesCommand}" Style="{StaticResource GhostButton}" Margin="0,0,8,8" Width="34" Height="32" Padding="0" ToolTip="{Binding PatcherLaunchReason, StringFormat='Закрыть выбранную установку: {0}'}" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="Закрыть Antigravity">
                                    <Path Data="{StaticResource Icon.Close}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="14" Height="14" Stretch="Uniform"/>
                                </Button>
                                <Button Command="{Binding CancelPatcherCommand}" Style="{StaticResource GhostButton}" Width="34" Height="32" Padding="0" Margin="0,0,0,8" ToolTip="{loc:Loc 'Остановить операцию'}" AutomationProperties.Name="Остановить операцию" Visibility="{Binding IsPatcherBusy, Converter={StaticResource BoolToVis}}">
                                    <Path Data="{StaticResource Icon.Stop}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="14" Height="14" Stretch="Uniform"/>
                                </Button>
                            </WrapPanel>
                            <Button Content="Завершить все процессы" Command="{Binding ForceCloseAntigravityCommand}" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="0,0,0,12" ToolTip="Принудительное завершение Antigravity и фоновых процессов выбранной установки. Несохранённые изменения будут потеряны."/>
                            <TextBlock Text="{loc:Loc 'Каталог установки'}" Style="{StaticResource Muted}" Margin="0,0,0,5"/>
                            <ItemsControl ItemsSource="{Binding DetectedInstallations}" Margin="0,0,0,8" Visibility="{Binding HasDetectedInstallations, Converter={StaticResource BoolToVis}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <RadioButton Style="{StaticResource ChipButton}"
                                                     Content="{Binding DisplayName}"
                                                     IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                     Command="{Binding DataContext.SelectInstallationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                     CommandParameter="{Binding Path}"
                                                     GroupName="AntigravityInstallationsGroup"
                                                     ToolTip="{Binding Path, TargetNullValue='Автоматический поиск всех установок'}"
                                                     Margin="0,0,8,6"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Grid Margin="0,0,0,12" IsEnabled="{Binding CanRunPatcher}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox Text="{Binding PatcherInstallRoot, UpdateSourceTrigger=LostFocus}" MinWidth="0" ToolTip="{loc:Loc 'Пустой путь — автоматический поиск. Можно выбрать каталог portable-версии или отдельного компонента.'}"/>
                                <TextBlock Text="{loc:Loc 'Автоматический поиск'}" Margin="12,0,12,0" VerticalAlignment="Center" Foreground="{StaticResource FgMutedBrush}" IsHitTestVisible="False" Visibility="{Binding IsPatcherAutoDiscovery, Converter={StaticResource BoolToVis}}"/>
                                <Button Grid.Column="1" Command="{Binding BrowseAntigravityCommand}" Style="{StaticResource GhostButton}" Width="34" Padding="0" Margin="6,0,0,0" ToolTip="{loc:Loc 'Выбрать каталог'}">
                                    <Path Data="{StaticResource Icon.Folder}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="14" Height="14" Stretch="Uniform"/>
                                </Button>
                                <Button Grid.Column="2" Command="{Binding ResetAntigravityRootCommand}" Style="{StaticResource GhostButton}" Width="34" Padding="0" Margin="6,0,0,0" ToolTip="{loc:Loc 'Вернуть автоматический поиск'}">
                                    <Path Data="{StaticResource Icon.Refresh}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="14" Height="14" Stretch="Uniform"/>
                                </Button>
                            </Grid>
                            <TextBlock Text="{Binding PatcherStatusMessage}" TextWrapping="Wrap" Margin="0,0,0,8" FontSize="12" Foreground="{StaticResource FgMutedBrush}"/>
                            <TextBlock Text="{Binding PatcherActionSummary}" TextWrapping="Wrap" Margin="0,0,0,6" FontSize="12"/>
                            <TextBlock Text="{Binding PatcherLauncherDisplay}" TextTrimming="CharacterEllipsis" ToolTip="{Binding PatcherLauncherDisplay}" FontFamily="{StaticResource MonoFont}" Margin="0,0,0,6" FontSize="10.5" Foreground="{StaticResource FgMutedBrush}"/>
                            <TextBlock Text="{Binding PatcherCheckedAt}" Margin="0,0,0,8" FontSize="11" Foreground="{StaticResource FgMutedBrush}"/>
                            <CheckBox Content="{loc:Loc 'Следить за обновлениями Antigravity'}" IsChecked="{Binding PatcherMonitorEnabled}" Margin="0,0,0,10"/>
                            <CheckBox Content="Автоматически применять совместимый патч после обновления" IsChecked="{Binding PatcherAutoPatchEnabled}" Margin="0,0,0,10" ToolTip="После завершения обновления и закрытия Antigravity. Процессы не завершаются автоматически; неизвестная структура файла не изменяется."/>
                            <CheckBox Content="Запускать без AG_LS_PROXY" Foreground="{StaticResource FgBrush}" IsChecked="{Binding PatcherDirectConnection}" IsEnabled="{Binding CanRunPatcher}" Margin="0,0,0,10"
                                      ToolTip="Сохраняемый режим запуска: исключает AG_LS_PROXY только для Antigravity, включая значение, унаследованное от GX. Системные настройки и DNS не меняются."/>
                            <TextBlock Text="{Binding PatcherUpdateMessage}" TextWrapping="Wrap" Margin="0,0,0,10" FontSize="12" Foreground="{StaticResource WarnBrush}"
                                       Visibility="{Binding HasPatcherUpdateMessage, Converter={StaticResource BoolToVis}}"/>
                            <ProgressBar IsIndeterminate="True" Height="3" Margin="0,0,0,10" Visibility="{Binding IsPatcherBusy, Converter={StaticResource BoolToVis}}"/>
                            <ItemsControl ItemsSource="{Binding PatcherComponents}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,1,0,0" Padding="0,14">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <WrapPanel>
                                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                        <TextBlock Text="{Binding Version}" Margin="8,0,0,0" FontSize="12" Foreground="{StaticResource FgMutedBrush}" VerticalAlignment="Center"/>
                                                    </WrapPanel>
                                                <TextBlock Text="{Binding StateDisplay}" Foreground="{Binding StateColor}" FontSize="11" Margin="0,5,0,5"/>
                                                <TextBlock Text="{Binding Path, TargetNullValue=''}" FontFamily="{StaticResource MonoFont}" FontSize="10.5" TextTrimming="CharacterEllipsis" Foreground="{StaticResource FgMutedBrush}" ToolTip="{Binding Path}"/>
                                                <TextBlock Text="{Binding Details}" FontSize="11" Foreground="{StaticResource FgMutedBrush}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                                <TextBlock Text="{Binding ActionExplanation}" FontSize="11" Foreground="{StaticResource FgMutedBrush}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Vertical" Margin="14,0,0,0" VerticalAlignment="Center">
                                                    <Button Content="{Binding PatchLabel}" Command="{Binding DataContext.PatchComponentCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Key}" Style="{StaticResource SecondaryButton}" Width="136" Margin="0,0,0,4" ToolTip="{Binding PatchReason}" ToolTipService.ShowOnDisabled="True"/>
                                                    <Button Content="{loc:Loc 'Откатить'}" Command="{Binding DataContext.RestoreComponentCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Key}" Style="{StaticResource GhostButton}" Width="136" Margin="0,0,0,4" ToolTip="{Binding RestoreReason}" ToolTipService.ShowOnDisabled="True"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <DockPanel Margin="0,12,0,8">
                                <Button DockPanel.Dock="Right" Command="{Binding ClearPatcherLogCommand}" Style="{StaticResource GhostButton}" Width="32" Padding="0" ToolTip="{loc:Loc 'Очистить журнал'}">
                                    <Path Data="{StaticResource Icon.Trash}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="14" Height="14" Stretch="Uniform"/>
                                </Button>
                                <TextBlock Text="{loc:Loc 'Журнал операций'}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBox Text="{Binding PatcherLog, Mode=OneWay}" IsReadOnly="True" Height="190" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" FontFamily="{StaticResource MonoFont}" FontSize="11" TextWrapping="Wrap"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Настройки -->
                <TabItem Header="{loc:Loc 'Настройки'}">
                    <Grid Margin="20,10,22,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="0,0,0,14">
                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" VerticalAlignment="Center"
                                    Command="{Binding OpenLinkCommand}"
                                    CommandParameter="{loc:Loc '#'}"
                                    ToolTip="{loc:Loc 'Открыть раздел «Настройки — полный список» в инструкции'}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource Icon.BookOpen}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="{loc:Loc 'Инструкция'}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="SemiBold" Text="{loc:Loc 'Настройки'}"/>
                                <TextBlock Style="{StaticResource Muted}" Margin="0,3,0,0" FontSize="12"
                                           Text="{loc:Loc 'Всё, что можно поменять. Разложено по четырём разделам.'}"/>
                            </StackPanel>
                        </DockPanel>

                        <TabControl x:Name="SettingsTabs" Grid.Row="1" Style="{StaticResource SubTabs}">
                            <TabItem Style="{StaticResource SubTabItem}">
                                <TabItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <!-- Foreground is bound to the tab, not inherited: the implicit
                                             TextBlock style sets it explicitly, and a local setter beats an
                                             inherited value — the label would stay bright in every state. -->
                                        <TextBlock Text="{loc:Loc 'Вид'}"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/>
                                        <TextBlock Text="4" Margin="7,0,0,0" FontFamily="{StaticResource MonoFont}"
                                                   FontSize="10.5" Opacity="0.5"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/>
                                    </StackPanel>
                                </TabItem.Header>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                                    <controls:ResponsiveColumnsPanel MinColumnWidth="340" Gap="16">
                                        <StackPanel Grid.Column="0">
                                            <Border Style="{StaticResource Card}">
                                                <DockPanel>
                                                    <Border DockPanel.Dock="Right" VerticalAlignment="Center" CornerRadius="8"
                                                            Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" Padding="3">
                                                        <StackPanel Orientation="Horizontal">
                                                            <RadioButton Style="{StaticResource ModeSegment}" Content="RU" GroupName="langSettings"
                                                                         IsChecked="{Binding LanguageIsRussian, Mode=OneWay}"
                                                                         Command="{Binding SetLanguageCommand}" CommandParameter="ru"/>
                                                            <RadioButton Style="{StaticResource ModeSegment}" Content="EN" GroupName="langSettings"
                                                                         IsChecked="{Binding LanguageIsEnglish, Mode=OneWay}"
                                                                         Command="{Binding SetLanguageCommand}" CommandParameter="en"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{loc:Loc 'Язык / Language'}" Style="{StaticResource H2}"/>
                                                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,12,0"
                                                                   Text="{loc:Loc 'Язык интерфейса. Переключение перезапускает приложение.'}"/>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                                                <StackPanel>
                                                    <TextBlock Text="{loc:Loc 'Уведомления'}" Style="{StaticResource H2}" Margin="0,0,0,8"/>
                                                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10"
                                                               Text="{loc:Loc 'Небольшие подсказки в углу экрана (запуск, остановка, авто-починка) — видны, даже когда приложение свёрнуто в трей.'}"/>
                                                    <CheckBox Content="{loc:Loc 'Показывать уведомления'}"
                                                              IsChecked="{Binding NotificationsEnabled}" Style="{StaticResource ToggleSwitch}"
                                                              Margin="0,6"/>
                                                    <CheckBox Content="{loc:Loc 'Звук уведомлений'}"
                                                              IsChecked="{Binding NotificationSound}" Style="{StaticResource ToggleSwitch}"
                                                              Margin="0,6"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <Border Style="{StaticResource Card}">
                                                <StackPanel>
                                                    <TextBlock Text="{loc:Loc 'Масштаб интерфейса'}" Style="{StaticResource H2}" Margin="0,0,0,8"/>
                                                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12"
                                                               Text="{loc:Loc 'Увеличивает весь интерфейс поверх масштаба Windows — на 4K и мониторах с высоким разрешением, где всё выглядит мелко. Работает независимо от системного DPI, применяется сразу.'}"/>
                                                    <WrapPanel>
                                                        <RadioButton Style="{StaticResource ChipButton}" Content="100%" IsChecked="{Binding Scale100, Mode=TwoWay}"/>
                                                        <RadioButton Style="{StaticResource ChipButton}" Content="125%" IsChecked="{Binding Scale125, Mode=TwoWay}"/>
                                                        <RadioButton Style="{StaticResource ChipButton}" Content="150%" IsChecked="{Binding Scale150, Mode=TwoWay}"/>
                                                        <RadioButton Style="{StaticResource ChipButton}" Content="175%" IsChecked="{Binding Scale175, Mode=TwoWay}"/>
                                                        <RadioButton Style="{StaticResource ChipButton}" Content="200%" IsChecked="{Binding Scale200, Mode=TwoWay}"/>
                                                    </WrapPanel>
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                                                <StackPanel>
                                                    <TextBlock Text="{loc:Loc 'Вводная для новичка'}" Style="{StaticResource H2}" Margin="0,0,0,8"/>
                                                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10"
                                                               Text="{loc:Loc 'Разбор по шагам: что нажать, чего ждать и что делать, если не заработало. Показывается один раз при первом запуске — отсюда её можно открыть снова в любой момент.'}"/>
                                                    <Button Content="{loc:Loc 'Показать вводную'}" Command="{Binding OpenWelcomeCommand}"
                                                            Style="{StaticResource GhostButton}" HorizontalAlignment="Left"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                                                <StackPanel>
                                                    <TextBlock Text="{loc:Loc 'Заводской сброс'}" Style="{StaticResource H2}" Margin="0,0,0,8"/>
                                                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10"
                                                               Text="{loc:Loc 'Полностью очищает локальные файлы, кэш, списки и распакованный движок. Помогает при обновлении или если на ПК остались старые настройки.'}"/>
                                                    <Button Content="{loc:Loc 'Вернуть к заводскому состоянию'}" Command="{Binding ResetSettingsCommand}"
                                                            Style="{StaticResource DangerButton}" HorizontalAlignment="Left"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </controls:ResponsiveColumnsPanel>
                                </ScrollViewer>
                            </TabItem>
                            <TabItem Style="{StaticResource SubTabItem}">
                                <TabItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <!-- Foreground is bound to the tab, not inherited: the implicit
                                             TextBlock style sets it explicitly, and a local setter beats an
                                             inherited value — the label would stay bright in every state. -->
                                        <TextBlock Text="{loc:Loc 'Обход'}"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/>
                                        <TextBlock Text="3" Margin="7,0,0,0" FontFamily="{StaticResource MonoFont}"
                                                   FontSize="10.5" Opacity="0.5"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/>
                                    </StackPanel>
                                </TabItem.Header>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                                    <controls:ResponsiveColumnsPanel MinColumnWidth="340" Gap="16">
                                        <StackPanel Grid.Column="0">
                                            <Border Style="{StaticResource Card}">
                                                <StackPanel>
                                                    <TextBlock Text="{loc:Loc 'Область обхода'}" Style="{StaticResource H2}" Margin="0,0,0,8"/>
                                                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10"
                                                               Text="{loc:Loc 'Обычно обходятся только YouTube, Discord, Telegram и ваши «Свои цели»/хостлисты — остальное не трогается, игры и приложения работают как есть. Включите, чтобы обходить любой заблокированный сайт (весь TLS/QUIC, кроме списка исключений) — удобно, но может сломать приложение, которого нет в исключениях. Меняется на лету.'}"/>
                                                    <CheckBox Content="{loc:Loc 'Обходить все сайты, а не только из списков'}"
                                                              IsChecked="{Binding BypassAllSites}" Style="{StaticResource ToggleSwitch}"
                                                              Margin="0,4"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                                                <StackPanel>
                                                    <TextBlock Text="{loc:Loc 'Игровой фильтр'}" Style="{StaticResource H2}" Margin="0,0,0,8"/>
                                                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10"
                                                               Text="{loc:Loc 'По умолчанию ВЫКЛ — обход не трогает игровой трафик (высокие порты), игры работают напрямую. Включите, только если душат саму игру: обход распространится на все порты выше 1023 (заодно покроет Discord-медиа на высоких портах). Меняется на лету — движок перезапустится.'}"/>
                                                    <CheckBox Content="{loc:Loc 'Распространять обход на игровые порты (>1023)'}"
                                                              IsChecked="{Binding GameFilter}" Style="{StaticResource ToggleSwitch}"
                                                              Margin="0,4"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                                                <StackPanel>
                                                    <TextBlock Text="{loc:Loc 'League of Legends'}" Style="{StaticResource H2}" Margin="0,0,0,8"/>
                                                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10"
                                                               Text="{loc:Loc 'Точечный обход только для игровой сессии LoL: TCP 2099 + ipset-lol + syndata. По умолчанию выключен. Включайте только если матч не подключается или висит reconnect; для Riot Client, авторизации, статистики и реплеев правильнее держать Riot в исключениях.'}"/>
                                                    <CheckBox Content="{loc:Loc 'Обход League of Legends (TCP 2099 / syndata)'}"
                                                              IsChecked="{Binding LeagueTcp2099Bypass}" Style="{StaticResource ToggleSwitch}"
                                                              Margin="0,4"/>
                                                    <CheckBox Content="{loc:Loc 'Эксперимент: обход Riot Entitlements (только если LoL не получает токен)'}"
                                                              IsChecked="{Binding RiotEntitlementsBypass}" Style="{StaticResource ToggleSwitch}"
                                                              Margin="0,8,0,4"/>
                                                    <CheckBox Content="{loc:Loc 'Маршрутизация Riot &amp; Blitz через hosts (устраняет черный экран)'}"
                                                              IsChecked="{Binding GameRoutingHostsFix}" Style="{StaticResource ToggleSwitch}"
                                                              Margin="0,8,0,4"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <Border Style="{StaticResource Card}">
                                                <StackPanel>
                                                    <TextBlock Text="QUIC / HTTP-3" Style="{StaticResource H2}" Margin="0,0,0,8"/>
                                                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10"
                                                               Text="{loc:Loc 'Провайдер/ТСПУ часто режет именно QUIC (HTTP-3) — тогда YouTube «тормозит», а Discord не грузит медиа, хотя по TCP всё открывается. Включите, чтобы принудительно отправить YouTube/Discord на TCP: QUIC-подключения отбрасываются, браузер сам откатывается на HTTP/2. Меняется на лету — движок перезапустится.'}"/>
                                                    <CheckBox Content="{loc:Loc 'Отключить QUIC (форсировать TCP)'}"
                                                              IsChecked="{Binding DisableQuic}" Style="{StaticResource ToggleSwitch}"
                                                              Margin="0,4"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                                                <StackPanel>
                                                    <TextBlock Text="{loc:Loc 'Прокси Telegram (MTProto)'}" Style="{StaticResource H2}" Margin="0,0,0,8"/>
                                                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10"
                                                               Text="{loc:Loc 'Локальный MTProto→WebSocket прокси для обхода блокировок Telegram Desktop. Автономный модуль без winws и без прав администратора.'}"/>
                                                    <CheckBox Content="{loc:Loc 'Автозапуск Telegram-прокси при старте'}"
                                                              IsChecked="{Binding TelegramProxyAutostart, Mode=TwoWay}" Style="{StaticResource ToggleSwitch}"
                                                              Margin="0,4"/>
                                                    <Grid Margin="0,10,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                                            <TextBlock Text="{loc:Loc 'Локальный порт'}" FontSize="12" Foreground="{StaticResource FgMutedBrush}" Margin="0,0,0,4"/>
                                                            <TextBox Text="{Binding TelegramProxyPort, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="100" HorizontalAlignment="Left"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="{loc:Loc 'Ключ секрета (MTProto Secret)'}" FontSize="12" Foreground="{StaticResource FgMutedBrush}" Margin="0,0,0,4"/>
                                                            <DockPanel LastChildFill="True">
                                                                <Button DockPanel.Dock="Right" Command="{Binding CopyTelegramProxyLinkCommand}" Style="{StaticResource GhostButton}" Height="28" Padding="8,0" Margin="6,0,0,0" ToolTip="{loc:Loc 'Скопировать полную tg:// ссылку'}">
                                                                    <TextBlock Text="{loc:Loc 'Копировать ссылку'}" FontSize="11"/>
                                                                </Button>
                                                                <TextBox Text="{Binding TelegramProxySecret, Mode=OneWay}" IsReadOnly="True" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource FgMutedBrush}"/>
                                                            </DockPanel>
                                                        </StackPanel>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </controls:ResponsiveColumnsPanel>
                                </ScrollViewer>
                            </TabItem>
                            <TabItem Style="{StaticResource SubTabItem}">
                                <TabItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <!-- Foreground is bound to the tab, not inherited: the implicit
                                             TextBlock style sets it explicitly, and a local setter beats an
                                             inherited value — the label would stay bright in every state. -->
                                        <TextBlock Text="{loc:Loc 'Система'}"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/>
                                        <TextBlock Text="4" Margin="7,0,0,0" FontFamily="{StaticResource MonoFont}"
                                                   FontSize="10.5" Opacity="0.5"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/>
                                    </StackPanel>
                                </TabItem.Header>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                                    <controls:ResponsiveColumnsPanel MinColumnWidth="340" Gap="16">
                                        <StackPanel Grid.Column="0">
                                            <Border Style="{StaticResource Card}">
                                                <StackPanel>
                                                    <TextBlock Text="{loc:Loc 'Движок'}" Style="{StaticResource H2}" Margin="0,0,0,12"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                                        <TextBlock Text="{loc:Loc 'Установленная версия:'}" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding EngineVersion}" Margin="8,0,0,0" VerticalAlignment="Center"
                                                                   FontWeight="SemiBold"/>
                                                        <Button Content="{loc:Loc 'Проверить обновления'}" Command="{Binding CheckUpdateCommand}"
                                                                Style="{StaticResource GhostButton}" Margin="16,0,0,0"/>
                                                    </StackPanel>
                                                    <ProgressBar Value="{Binding UpdateProgress, Mode=OneWay}" Minimum="0" Maximum="1" Height="3"
                                                                 Style="{StaticResource ModernProgressBar}" Margin="0,8,0,8"
                                                                 Visibility="{Binding IsDownloadingEngine, Converter={StaticResource BoolToVis}}"/>
                                                    <TextBlock Text="Обновления программы" FontWeight="SemiBold" Margin="0,16,0,6"/>
                                                    <WrapPanel>
                                                        <Button Content="Проверить обновления программы" Command="{Binding CheckAppUpdatesCommand}" Style="{StaticResource GhostButton}" Margin="0,0,8,6"/>
                                                        <Button Content="{Binding AppUpdateText}" Command="{Binding OpenAppReleaseCommand}" Style="{StaticResource GhostButton}" Margin="0,0,0,6" Visibility="{Binding AppUpdateAvailable, Converter={StaticResource BoolToVis}}"/>
                                                    </WrapPanel>
                                                    <TextBlock Text="{Binding AppUpdateStatus}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                                    <Button Content="Лицензии и сторонние компоненты" Command="{Binding OpenLicensesCommand}" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                                                    <TextBlock Text="{Binding UpdateStatus}" Style="{StaticResource Muted}"
                                                               FontSize="11.5" Margin="0,0,0,8"
                                                               Visibility="{Binding UpdateStatus, Converter={StaticResource StringNotEmptyToVis}}"/>
                                                    <CheckBox Content="{loc:Loc 'Автоматически обновлять движок при запуске'}"
                                                              IsChecked="{Binding AutoUpdateEngine}" Style="{StaticResource ToggleSwitch}"
                                                              Margin="0,4"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                                                <StackPanel>
                                                    <TextBlock Text="{loc:Loc 'Запуск'}" Style="{StaticResource H2}" Margin="0,0,0,12"/>
                                                    <CheckBox Content="{loc:Loc 'Запускать GXBRIEL_ZAPRET при входе в Windows'}"
                                                              IsChecked="{Binding AutostartEnabled}" Style="{StaticResource ToggleSwitch}"
                                                              Margin="0,6"/>
                                                    <CheckBox Content="{loc:Loc 'Сразу запускать обход при старте приложения'}"
                                                              IsChecked="{Binding AutostartEngine}" Style="{StaticResource ToggleSwitch}"
                                                              ToolTip="{loc:Loc 'При открытии запускает обход независимо от прошлого состояния. Ранее включённый обход также восстанавливается после выхода или сбоя.'}"
                                                              Margin="0,6"/>
                                                    <CheckBox Content="{loc:Loc 'Сворачивать в трей вместо закрытия'}"
                                                              IsChecked="{Binding MinimizeToTray}" Style="{StaticResource ToggleSwitch}"
                                                              Margin="0,6"/>
                                                    <TextBlock Text="{Binding AutostartStatus}" Style="{StaticResource Muted}"
                                                               TextWrapping="Wrap" FontSize="12" Margin="0,10,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <Border Style="{StaticResource Card}">
                                                <StackPanel>
                                                    <TextBlock Text="{loc:Loc 'Авто-починка'}" Style="{StaticResource H2}" Margin="0,0,0,8"/>
                                                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10"
                                                               Text="{loc:Loc 'Приложение фоном следит за доступностью Discord и YouTube. Если обход вдруг перестал работать — само переподбирает рабочую стратегию и перезапускает, без вашего участия.'}"/>
                                                    <CheckBox Content="{loc:Loc 'Сам переподбирать обход, если он сломался'}"
                                                              IsChecked="{Binding AutoHeal}" Style="{StaticResource ToggleSwitch}"
                                                              Margin="0,4"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                                                <StackPanel>
                                                    <TextBlock Text="{loc:Loc 'Проверка окружения'}" Style="{StaticResource H2}" Margin="0,0,0,8"/>
                                                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10"
                                                               Text="{loc:Loc 'Ищет в системе то, что мешает обходу: другие программы обхода блокировок (они занимают тот же драйвер WinDivert), включённый VPN или туннельный адаптер, а также недокачанный движок. По каждой находке показывает, что это значит и что сделать. Та же проверка идёт автоматически при запуске — здесь её можно вызвать в любой момент.'}"/>
                                                    <Button Content="{loc:Loc 'Проверить окружение'}" Click="OnCheckEnvironment"
                                                            Style="{StaticResource GhostButton}" HorizontalAlignment="Left" ToolTip="{loc:Loc 'Проверить конфликтующие VPN, другие службы zapret и сетевые адаптеры'}"/>

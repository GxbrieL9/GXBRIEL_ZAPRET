    <Style x:Key="SpinningIcon" TargetType="Path">
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <RotateTransform Angle="0"/>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsVisible" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever">
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                             From="0" To="360" Duration="0:0:1.1"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ====================== Brand logos ======================
         Real Discord / YouTube / Telegram marks so users recognise the targets at a glance.
         Vector paths from Simple Icons (CC0), 24x24 viewBox, default EvenOdd fill so the negative
         space (Discord eyes / YouTube triangle / Telegram plane) shows through. Render with a Path:
         <Path Data="{StaticResource Icon.Discord}" Fill="{StaticResource Brand.Discord}"
               Width="16" Height="16" Stretch="Uniform"/> -->
    <SolidColorBrush x:Key="Brand.Discord"  Color="#5865F2"/>
    <SolidColorBrush x:Key="Brand.YouTube"  Color="#FF0033"/>
    <SolidColorBrush x:Key="Brand.Telegram" Color="#2CA5E0"/>
    <!-- Cloudflare's signature orange, on their own mark (simple-icons, CC0 — the same set the three
         icons above come from, so it renders at the same weight and on the same 24x24 canvas). -->
    <SolidColorBrush x:Key="Brand.Cloudflare" Color="#F38020"/>

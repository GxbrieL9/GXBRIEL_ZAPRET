<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mvvm="clr-namespace:GxbrielZapret.Mvvm"
                    xmlns:ctrl="clr-namespace:GxbrielZapret.Controls">

    <!-- ====================== Converters ====================== -->
    <mvvm:InverseBoolConverter x:Key="InverseBool"/>
    <mvvm:BoolToVisibilityConverter x:Key="BoolToVis"/>
    <mvvm:StateToBrushConverter x:Key="StateToBrush"/>
    <mvvm:StateToSoftBrushConverter x:Key="StateToSoftBrush"/>
    <mvvm:StateToTextConverter x:Key="StateToText"/>
    <mvvm:DiagStatusToTextConverter x:Key="DiagText"/>
    <mvvm:DiagStatusToBrushConverter x:Key="DiagBrush"/>
    <mvvm:DiagStatusToSoftBrushConverter x:Key="DiagSoftBrush"/>
    <mvvm:RefEqualsToVisibilityConverter x:Key="RefEqualsToVis"/>
    <mvvm:IntEqualsConverter x:Key="IntEquals"/>
    <mvvm:IntGreaterThanZeroToVisibilityConverter x:Key="IntGreaterThanZeroToVis"/>
    <mvvm:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVis"/>

    <!-- ====================== Palette GXBRIEL_ZAPRET (Apple Premium Graphite / Obsidian / Rose Mist) ====================== -->
    <Color x:Key="C.CanvasTop">#FF131217</Color>
    <Color x:Key="C.Canvas">#FF0D0C10</Color>
    <Color x:Key="C.CanvasBottom">#FF08080A</Color>
    <Color x:Key="C.WindowGround">#FF08070B</Color>
    <Color x:Key="C.Bg">#FF0E0D12</Color>
    <Color x:Key="C.DeepBg">#FF09080C</Color>

    <!-- Deep Monolithic Panels & Sidebar (Complex Dark Matte Surface with Subtle Plum Lift) -->
    <Color x:Key="C.Sidebar">#FF0B0A0E</Color>
    <Color x:Key="C.Card">#FF15141B</Color>
    <Color x:Key="C.Surface">#FF16151D</Color>
    <Color x:Key="C.SurfaceRaised">#FF1C1B24</Color>
    <Color x:Key="C.SurfaceAlt">#FF201F2A</Color>
    <Color x:Key="C.SurfaceElevated">#FF2A2836</Color>
    <Color x:Key="C.SurfaceHover">#FF343242</Color>
    <Color x:Key="C.Border">#1AFFFFFF</Color>
    <Color x:Key="C.BorderStrong">#2EFFFFFF</Color>
    <Color x:Key="C.BorderHover">#4AFFFFFF</Color>

    <!-- Clean Typography (Soft Crisp White & Mauve Gray) -->
    <Color x:Key="C.Fg">#FFF3F1F6</Color>
    <Color x:Key="C.FgMuted">#FFABA4B5</Color>
    <Color x:Key="C.Muted2">#FF888194</Color>

    <!-- Atmospheric Lighting (Mauve, Dusty Rose, Pale Pink) -->
    <Color x:Key="C.MauveGlow">#FF96778C</Color>
    <Color x:Key="C.SoftMauve">#FFAE86A8</Color>
    <Color x:Key="C.DustyRose">#FFC08DB7</Color>
    <Color x:Key="C.PalePink">#FFDEBFDB</Color>
    <Color x:Key="C.RoseGlow">#FFF0E2EE</Color>

    <!-- Visible accent is dusty mauve / rose, not burgundy. Burgundy remains only as hidden depth. -->
    <Color x:Key="C.Accent">#FFC394CB</Color>
    <Color x:Key="C.AccentHover">#FFD8AEE0</Color>
    <Color x:Key="C.AccentPressed">#FFA175A9</Color>
    <Color x:Key="C.AccentSoft">#26C394CB</Color>
    <Color x:Key="C.Highlight">#FFF3E6F5</Color>
    <Color x:Key="C.Rose">#FFDEBFDB</Color>

    <!-- Technical Network Accent (Steel Blue / Ice Blue) -->
    <Color x:Key="C.SteelDark">#FF17222C</Color>
    <Color x:Key="C.Steel">#FF24425A</Color>
    <Color x:Key="C.SteelMid">#FF4D718B</Color>
    <Color x:Key="C.IceBlue">#FF8EAFBF</Color>
    <Color x:Key="C.IceBlueLight">#FFC4DEEC</Color>

    <!-- Semantic Operational Statuses -->
    <Color x:Key="C.Success">#FF34C759</Color>
    <Color x:Key="C.Warn">#FFFF9F0A</Color>
    <Color x:Key="C.Danger">#FFFF453A</Color>
    <Color x:Key="C.Info">#FF64D2FF</Color>
    <Color x:Key="C.Neutral">#FF8E8E93</Color>

    <!-- Canvas and Deep Surfaces Brushes -->
    <SolidColorBrush x:Key="CanvasBgBrush" Color="{StaticResource C.Canvas}"/>
    <SolidColorBrush x:Key="BgBrush"              Color="{StaticResource C.Bg}"/>
    <SolidColorBrush x:Key="DeepBgBrush"          Color="{StaticResource C.DeepBg}"/>
    <SolidColorBrush x:Key="SidebarBgBrush" Color="{StaticResource C.Sidebar}"/>
    <SolidColorBrush x:Key="SurfaceBrush"         Color="{StaticResource C.Surface}"/>
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource C.Card}"/>
    <SolidColorBrush x:Key="SurfaceRaisedBrush"   Color="{StaticResource C.SurfaceRaised}"/>
    <SolidColorBrush x:Key="SurfaceAltBrush"       Color="{StaticResource C.SurfaceAlt}"/>
    <SolidColorBrush x:Key="SurfaceElevatedBrush"  Color="{StaticResource C.SurfaceElevated}"/>
    <SolidColorBrush x:Key="SurfaceHoverBrush"     Color="{StaticResource C.SurfaceHover}"/>
    <SolidColorBrush x:Key="BorderBrush2"         Color="{StaticResource C.Border}"/>
    <SolidColorBrush x:Key="BorderStrongBrush"    Color="{StaticResource C.BorderStrong}"/>
    <SolidColorBrush x:Key="BorderHoverBrush"     Color="{StaticResource C.BorderHover}"/>
    <SolidColorBrush x:Key="FgBrush"              Color="{StaticResource C.Fg}"/>
    <SolidColorBrush x:Key="FgMutedBrush"         Color="{StaticResource C.FgMuted}"/>
    <SolidColorBrush x:Key="MutedBrush"           Color="{StaticResource C.FgMuted}"/>
    <SolidColorBrush x:Key="Muted2Brush"          Color="{StaticResource C.Muted2}"/>

    <!-- Atmospheric Light Brushes -->
    <SolidColorBrush x:Key="MauveGlowBrush"      Color="{StaticResource C.MauveGlow}"/>
    <SolidColorBrush x:Key="SoftMauveBrush"     Color="{StaticResource C.SoftMauve}"/>
    <SolidColorBrush x:Key="DustyRoseBrush"     Color="{StaticResource C.DustyRose}"/>
    <SolidColorBrush x:Key="PalePinkBrush"      Color="{StaticResource C.PalePink}"/>
    <SolidColorBrush x:Key="RoseGlowBrush"      Color="{StaticResource C.RoseGlow}"/>
    <SolidColorBrush x:Key="MauveTintBrush"     Color="#2696778C"/>
    <SolidColorBrush x:Key="PalePinkTintBrush"  Color="#22DEBFDB"/>

    <!-- Rose / mauve accent brushes -->
    <SolidColorBrush x:Key="AccentBrush"        Color="{StaticResource C.Accent}"/>
    <SolidColorBrush x:Key="AccentHoverBrush"   Color="{StaticResource C.AccentHover}"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource C.AccentPressed}"/>
    <SolidColorBrush x:Key="AccentSoftBrush"    Color="{StaticResource C.AccentSoft}"/>
    <SolidColorBrush x:Key="AccentTintBrush"    Color="#1FC394CB"/>
    <SolidColorBrush x:Key="HighlightBrush"     Color="{StaticResource C.Highlight}"/>
    <SolidColorBrush x:Key="RoseBrush"          Color="{StaticResource C.Rose}"/>

    <!-- Steel Blue & Ice Blue Technical Brushes -->
    <SolidColorBrush x:Key="SteelDarkBrush"      Color="{StaticResource C.SteelDark}"/>
    <SolidColorBrush x:Key="SteelBrush"          Color="{StaticResource C.Steel}"/>
    <SolidColorBrush x:Key="SteelMidBrush"       Color="{StaticResource C.SteelMid}"/>
    <SolidColorBrush x:Key="SteelSoftBrush"      Color="#2624425A"/>
    <SolidColorBrush x:Key="SteelHighlightBrush" Color="{StaticResource C.IceBlueLight}"/>
    <SolidColorBrush x:Key="IceBlueBrush"        Color="{StaticResource C.IceBlue}"/>
    <SolidColorBrush x:Key="IceBlueLightBrush"   Color="{StaticResource C.IceBlueLight}"/>
    <SolidColorBrush x:Key="IceBlueSoftBrush"    Color="#208EAFBF"/>

    <!-- Status Brushes -->
    <SolidColorBrush x:Key="SuccessBrush"      Color="{StaticResource C.Success}"/>
    <SolidColorBrush x:Key="HeroActiveBrush"   Color="{StaticResource C.Success}"/>
    <SolidColorBrush x:Key="SuccessSoftBrush"  Color="#2234C759"/>
    <SolidColorBrush x:Key="DangerBrush"       Color="{StaticResource C.Danger}"/>
    <SolidColorBrush x:Key="DangerSoftBrush"   Color="#22FF453A"/>
    <SolidColorBrush x:Key="WarnBrush"         Color="{StaticResource C.Warn}"/>
    <SolidColorBrush x:Key="WarnSoftBrush"     Color="#22FF9F0A"/>
    <SolidColorBrush x:Key="InfoBrush"         Color="{StaticResource C.Info}"/>
    <SolidColorBrush x:Key="InfoSoftBrush"     Color="#2264D2FF"/>
    <SolidColorBrush x:Key="NeutralBrush"      Color="{StaticResource C.Neutral}"/>
    <SolidColorBrush x:Key="NeutralSoftBrush"  Color="#1E8E8E93"/>

    <SolidColorBrush x:Key="CardFill" Color="{StaticResource C.Card}"/>
    <SolidColorBrush x:Key="CardEdge" Color="{StaticResource C.Border}"/>

    <!-- Atmospheric Glow Effects -->
    <DropShadowEffect x:Key="HeroActiveGlow" Color="#34C759" BlurRadius="28" ShadowDepth="0" Opacity="0.16"/>
    <DropShadowEffect x:Key="AccentGlow" Color="#C394CB" BlurRadius="20" ShadowDepth="0" Opacity="0.18"/>
    <DropShadowEffect x:Key="MauveGlow" Color="#96778C" BlurRadius="24" ShadowDepth="0" Opacity="0.12"/>
    <DropShadowEffect x:Key="CardSoftShadow" Color="#000000" BlurRadius="18" ShadowDepth="6" Opacity="0.45"/>
    <DropShadowEffect x:Key="ShellSoftShadow" Color="#000000" BlurRadius="32" ShadowDepth="10" Opacity="0.65"/>

    <!-- Atmospheric Card Gradients -->
    <LinearGradientBrush x:Key="HeroCardBg" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F41A1924" Offset="0"/>
        <GradientStop Color="#F4111018" Offset="1"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="NavActiveBg" Color="{StaticResource C.SurfaceElevated}"/>

    <LinearGradientBrush x:Key="ButtonDepth" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#00000000" Offset="0"/>
        <GradientStop Color="#0A000000" Offset="0.55"/>
        <GradientStop Color="#1F000000" Offset="1"/>
    </LinearGradientBrush>

    <!-- Bundled OFL fonts and system fallbacks -->
    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">pack://application:,,,/Assets/Fonts/#JetBrains Mono, Consolas, Courier New, monospace</FontFamily>

    <!-- ====================== Base typography ====================== -->
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource FgBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>

    <!-- ToolTip chrome -->
    <Style TargetType="ToolTip">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="MaxWidth" Value="340"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{StaticResource SurfaceAltBrush}"
                            BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                            CornerRadius="8" Padding="8,5">
                        <Border.Resources>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="TextWrapping" Value="Wrap"/>
                                <Setter Property="FontSize" Value="12"/>
                            </Style>
                        </Border.Resources>
                        <ContentPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="H1" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource FgBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="H2" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource FgBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
        <Setter Property="FontSize" Value="17"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="Muted" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource FgMutedBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="LineHeight" Value="18"/>
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
    </Style>

    <!-- ====================== Monolithic Atmospheric Card ====================== -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Padding" Value="20"/>
    </Style>

    <Style x:Key="CardInteractive" TargetType="Border" BasedOn="{StaticResource Card}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource BorderHoverBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Modal dialog card -->
    <Style x:Key="ModalCard" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Style.Triggers>
            <Trigger Property="IsVisible" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                             From="0" To="1" Duration="0:0:0.16"/>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                             From="0.96" To="1" Duration="0:0:0.18">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                             From="0.96" To="1" Duration="0:0:0.18">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ====================== Scrollbars ====================== -->
    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="t" CornerRadius="4" Margin="2" Background="#26FFFFFF"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="t" Property="Background" Value="#4AFFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="t" Property="Background" Value="{StaticResource AccentBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollPageButton" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="10"/>
        <Setter Property="MinWidth" Value="10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}"
                               IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollThumb}"/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollPageButton}"/>
                            </Track.IncreaseRepeatButton>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollPageButton}"/>
                            </Track.DecreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="Height" Value="10"/>
                <Setter Property="MinHeight" Value="10"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ====================== ProgressBar ====================== -->
    <Style x:Key="ModernProgressBar" TargetType="ProgressBar">
        <Setter Property="Height" Value="5"/>
        <Setter Property="Background" Value="{StaticResource BorderBrush2}"/>
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border Background="{TemplateBinding Background}" CornerRadius="3" ClipToBounds="True">
                        <Grid x:Name="TemplateRoot">
                            <Border x:Name="PART_Track" CornerRadius="3"/>
                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="3" HorizontalAlignment="Left"/>
                            <Border x:Name="IndeterminateFill" Background="{TemplateBinding Foreground}" CornerRadius="3" Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="IndeterminateFill" Property="Visibility" Value="Visible"/>
                            <Trigger.EnterActions><BeginStoryboard Name="indeterminate">
                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                    <DoubleAnimation Storyboard.TargetName="IndeterminateFill" Storyboard.TargetProperty="Opacity" From="0.25" To="0.85" Duration="0:0:0.8"/>
                                </Storyboard>
                            </BeginStoryboard></Trigger.EnterActions>
                            <Trigger.ExitActions><StopStoryboard BeginStoryboardName="indeterminate"/></Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ====================== Keyboard Focus Ring ====================== -->
    <Style x:Key="KeyboardFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-2" CornerRadius="10" BorderBrush="{StaticResource AccentBrush}" BorderThickness="2" SnapsToDevicePixels="True" IsHitTestVisible="False"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ====================== Buttons ====================== -->
    <!-- ====================== Buttons ====================== -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusVisual}"/>
        <Setter Property="Foreground" Value="#FF110F14"/>
        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{StaticResource AccentHoverBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="14,7"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Effect" Value="{x:Null}"/>
        <Setter Property="ctrl:CursorGlowBehavior.IsEnabled" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10" Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5" ClipToBounds="True">
                        <Border.RenderTransform><ScaleTransform x:Name="bs" ScaleX="1" ScaleY="1"/></Border.RenderTransform>
                        <Grid>
                            <!-- Interactive cursor radial glow (Dusty Rose / Mauve -> Transparent) -->
                            <Border x:Name="glowOverlay" Opacity="0" IsHitTestVisible="False" CornerRadius="10">
                                <Border.Background>
                                    <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.85" RadiusY="0.85">
                                    <GradientStop Color="#33DFD3DC" Offset="0"/>
                                    <GradientStop Color="#22997794" Offset="0.36"/>
                                    <GradientStop Color="#00000000" Offset="0.72"/>
                                    </RadialGradientBrush>
                                </Border.Background>
                            </Border>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource AccentHoverBrush}"/>
                            <Setter TargetName="glowOverlay" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource AccentPressedBrush}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="bs" Storyboard.TargetProperty="ScaleX" To="0.985" Duration="0:0:0.08"/>
                                        <DoubleAnimation Storyboard.TargetName="bs" Storyboard.TargetProperty="ScaleY" To="0.985" Duration="0:0:0.08"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="bs" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.10"/>
                                        <DoubleAnimation Storyboard.TargetName="bs" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.10"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="b" Property="Opacity" Value="0.4"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Reference-grade Hero Action Button: Dark wine/plum base + Dusty Rose cursor hotspot + Pale Pink reflection rim -->
    <Style x:Key="HeroActionButton" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusVisual}"/>
        <Setter Property="Background" Value="#FF795C82"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Padding" Value="22,12"/>
        <Setter Property="MinHeight" Value="44"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="surface" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="surface" Property="Background" Value="#FF8D6D97"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="surface" Property="Background" Value="#FF664C70"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="surface" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusVisual}"/>
        <Setter Property="Foreground" Value="{StaticResource FgBrush}"/>
        <Setter Property="Background" Value="#FF1E1D25"/>
        <Setter Property="BorderBrush" Value="#FF302E3B"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Padding" Value="13,7"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10" Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform><ScaleTransform x:Name="bs" ScaleX="1" ScaleY="1"/></Border.RenderTransform>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#FF292734"/>
                            <Setter TargetName="b" Property="BorderBrush" Value="#FF444154"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#FF17161E"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="bs" Storyboard.TargetProperty="ScaleX" To="0.985" Duration="0:0:0.08"/>
                                        <DoubleAnimation Storyboard.TargetName="bs" Storyboard.TargetProperty="ScaleY" To="0.985" Duration="0:0:0.08"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="bs" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.10"/>
                                        <DoubleAnimation Storyboard.TargetName="bs" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.10"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="b" Property="Opacity" Value="0.4"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GhostButton" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusVisual}"/>
        <Setter Property="Foreground" Value="{StaticResource FgMutedBrush}"/>
        <Setter Property="Background" Value="#00000000"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Padding" Value="11,6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10" Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform><ScaleTransform x:Name="bs" ScaleX="1" ScaleY="1"/></Border.RenderTransform>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource FgBrush}"/>
                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource BorderHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource SurfaceElevatedBrush}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="bs" Storyboard.TargetProperty="ScaleX" To="0.985" Duration="0:0:0.08"/>
                                        <DoubleAnimation Storyboard.TargetName="bs" Storyboard.TargetProperty="ScaleY" To="0.985" Duration="0:0:0.08"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="bs" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.10"/>
                                        <DoubleAnimation Storyboard.TargetName="bs" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.10"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="b" Property="Opacity" Value="0.4"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

